        N3["inspect_dependencies<br/>依赖源码重定向<br/>OSV 实时 CVE 查询"]
        N1 --> N2 --> N3
    end

    subgraph ANA["并行 Analyzers（71 规则 / 17 类威胁）"]
        S1["静态模式 static patterns<br/>提示注入 · 数据外泄 · 提权 · 供应链<br/>越权 · 输出处理 · 系统提示泄露<br/>内存投毒 · 工具滥用 · 反拒绝"]
        S2["AST / 数据流<br/>python_ast · taint tracking<br/>shell truthiness"]
        S3["YARA 签名匹配"]
