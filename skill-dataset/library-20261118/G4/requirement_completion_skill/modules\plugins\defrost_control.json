  "common_missing_items": [
    "未定义适用模式和禁用场景",
    "未定义优先级与互斥关系",
    "未定义异常处理或降级策略",
    "未定义关机/断电后的恢复逻辑",
    "未定义用户反馈方式"
  ],
  "inference_rules": [
    {
      "pattern": "除霜什么时候启动",
      "intent_type": "memory_restore_request",
      "need_complete": [
        "前置条件",
        "执行流程",
        "中断处理",
        "结束恢复",
        "用户反馈"
      ]
    },
    {
      "pattern": "除霜执行过程是什么",
      "intent_type": "mode_linkage_request",
      "need_complete": [
        "前置条件",
        "执行流程",
        "中断处理",
        "结束恢复",
        "用户反馈"
      ]
    },
    {
      "pattern": "除霜被打断后怎么办",
      "intent_type": "constraint_request",
      "need_complete": [
        "前置条件",
        "执行流程",
        "中断处理",
        "结束恢复",
        "用户反馈"
      ]
    }
  ],
  "output_templates": {
    "rewrite_template": "当【前置条件】满足时，系统应启动智能化霜控制流程，并按【执行步骤】依次完成相关动作。若流程被【中断/超时/故障】打断，则按【中断处理规则】执行；流程结束后，应按【恢复规则】恢复目标运行状态或停机状态。"
  }
