  "category": "restore_module",
  "definition": "化霜功能是空调热泵系统在制热运行模式下，为去除室外换热器（蒸发器）表面凝结的霜层而执行的一个必要工作循环。",
  "aliases": [
    "智能化霜控制",
    "除霜功能",
    "除霜",
    "化霜",
    "Defrost"
  ],
  "keywords": [
    "结霜检测",
    "四通阀",
    "制热",
    "恢复送风",
    "压缩机",
    "室内风机",
    "室外风机",
    "电子膨胀阀",
    "盘管温度",
    "温度传感器"
  ],
  "related_modules": [
