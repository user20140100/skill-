  ],
  "default_rules": [
    "室内盘管保护通常基于阈值、状态或故障条件触发",
    "室内盘管保护触发后通常限制执行器动作或直接降级停机",
    "室内盘管保护退出后通常需要按恢复逻辑恢复目标状态",
    "保护逻辑通常优先于舒适性和节能类策略"
  ],
  "must_confirm_rules": [
    "触发条件是温度、时间、电流、反馈还是组合条件",
    "保护触发后的动作限制范围",
    "退出条件和恢复条件是否使用滞回机制",
    "保护期间收到用户指令时是拒绝、缓存还是延后执行",
    "故障与保护并发时如何定义优先级"
  ],
  "common_missing_items": [
    "未定义适用模式和禁用场景",
    "未定义优先级与互斥关系",
    "未定义异常处理或降级策略",
    "未定义关机/断电后的恢复逻辑",
    "未定义用户反馈方式"
  ],
  "inference_rules": [
    {
      "pattern": "内盘管保护什么时候触发",
      "intent_type": "constraint_request",
      "need_complete": [
        "触发条件",
        "保护动作",
        "退出条件",
        "恢复逻辑",
        "优先级"
      ]
    },
    {
      "pattern": "内盘管保护触发后系统怎么处理",
      "intent_type": "fault_protection_request",
      "need_complete": [
        "触发条件",
        "保护动作",
        "退出条件",
        "恢复逻辑",
        "优先级"
      ]
    },
    {
      "pattern": "内盘管保护结束后如何恢复",
      "intent_type": "mode_linkage_request",
      "need_complete": [
        "触发条件",
        "保护动作",
        "退出条件",
        "恢复逻辑",
        "优先级"
      ]
    }
  ],
  "output_templates": {
    "rewrite_template": "当【触发条件】满足时，系统应启用室内盘管保护，对【执行器/控制逻辑】采取【保护动作】。待【退出条件】满足后，系统应退出保护状态，并按【恢复规则】恢复相关功能；若检测到【异常场景】，则按【故障处理规则】执行。"
  }
}