{
  "type": "object",
  "required": [
    "task_type",
    "user_input"
  ],
  "properties": {
    "task_type": {
      "type": "string",
      "enum": [
        "completion",
        "rewrite",
        "review",
        "extraction",
        "explanation"
      ]
    },
    "user_input": {
      "type": "string",
      "description": "用户原始需求、问题或待评审文本"
    },
    "domain": {
      "type": "string",
      "description": "产品域，如空调内机、空调整机、通用家电",
      "default": "空调内机"
    },
    "candidate_modules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "上游已识别出的候选模块，可为空"
    },
    "context": {
      "type": "object",
      "properties": {
        "product_type": {
          "type": "string",
          "description": "如家用壁挂机、柜机、中央空调内机"
        },
        "interaction_channels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "如遥控器、APP、语音、线控器"
        },
        "document_style": {
          "type": "string",
          "description": "输出风格，如需求文档、评审意见、结构化结果",
          "default": "需求文档"
        },
        "output_language": {
          "type": "string",
          "default": "zh-CN"
        },
        "structured_output": {
          "type": "boolean",
          "default": true
        },
        "strict_mode": {
          "type": "boolean",
          "description": "严格模式下更强调必须确认项，不轻易默认补全",
          "default": false
        }
      }
    }
  }
}
