{
  "module_name": "制热防冷风控制",
  "module_code": "anti_cold_air_control",
  "category": "protection_module",
  "definition": "内风机和导风板防冷风功能是一项旨在提升用户热舒适性的控制策略，主要应用于空调系统的制热运行模式。",
  "aliases": [
    "制热防冷风控制",
    "防冷风控制",
    "防冷风",
    "制热防冷风",
    "启动不吹冷风"
  ],
  "keywords": [
    "盘管温度",
    "内风机",
    "导风板",
    "制热启动",
    "化霜恢复",
    "压缩机",
    "室内风机",
    "四通阀",
    "温度传感器",
    "高压保护"
  ],
  "related_modules": [
    "上下扫风控制",
    "风速控制",
    "智能化霜控制",
    "电辅热控制",
    "运行模式切换控制"
  ],
  "intent_patterns": [
    "constraint_request",
    "fault_protection_request",
    "mode_linkage_request",
    "priority_request"
  ],
  "key_dimensions": [
    "生效条件",
    "触发阈值",
    "保护动作",
    "退出条件",
    "恢复逻辑",
    "优先级",
    "异常处理",
    "安全/保护"
  ],
  "default_rules": [
    "制热启动和化霜恢复阶段通常启用防冷风逻辑",
    "防冷风期间室内风机通常停止或以微风运行",
    "导风板通常保持水平或关闭位置以避免冷风直吹",
    "防冷风结束后通常恢复用户目标风速与风向"
  ],
  "must_confirm_rules": [
    "触发条件是温度、时间、电流、反馈还是组合条件",
    "保护触发后的动作限制范围",
    "退出条件和恢复条件是否使用滞回机制",
    "保护期间收到用户指令时是拒绝、缓存还是延后执行",
    "故障与保护并发时如何定义优先级"
  ],
  "common_missing_items": [
    "未定义适用模式和禁用场景",
    "未定义优先级与互斥关系",
    "未定义异常处理或降级策略",
    "未定义关机/断电后的恢复逻辑",
    "未定义用户反馈方式"
  ],
  "inference_rules": [
    {
      "pattern": "防冷风什么时候触发",
      "intent_type": "constraint_request",
      "need_complete": [
        "触发条件",
        "保护动作",
        "退出条件",
        "恢复逻辑",
        "优先级"
      ]
    },
    {
      "pattern": "防冷风触发后系统怎么处理",
      "intent_type": "fault_protection_request",
      "need_complete": [
        "触发条件",
        "保护动作",
        "退出条件",
        "恢复逻辑",
        "优先级"
      ]
    },
    {
      "pattern": "防冷风结束后如何恢复",
      "intent_type": "mode_linkage_request",
      "need_complete": [
        "触发条件",
        "保护动作",
        "退出条件",
        "恢复逻辑",
        "优先级"
      ]
    }
  ],
  "output_templates": {
    "rewrite_template": "当【触发条件】满足时，系统应启用制热防冷风控制，对【执行器/控制逻辑】采取【保护动作】。待【退出条件】满足后，系统应退出保护状态，并按【恢复规则】恢复相关功能；若检测到【异常场景】，则按【故障处理规则】执行。"
  }
}