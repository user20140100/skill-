# ============================================================
# 本地复现环境变量（复制为 .env 后按需填写）
# 注意：SkillEvaluator 与 SkillSpector 使用不同的 NVIDIA key 变量名
# ============================================================

# ---- SkillEvaluator（三层评估框架）----
# LLM provider：nv_build | openai | anthropic | ...
SKILL_EVAL_LLM_PROVIDER=nv_build
# NVIDIA Build (build.nvidia.com) 的 API key（README 示例写法）
NVIDIA_API_KEY=
# 或使用通用 LLM key 变量
# SKILL_EVAL_LLM_API_KEY=
# SKILL_EVAL_LLM_MODEL=
# SKILL_EVAL_LLM_BASE_URL=

# Tier2 语义去重所需的 embedding 配置
# SKILL_EVAL_EMBEDDING_PROVIDER=
# SKILL_EVAL_EMBEDDING_API_KEY=
# SKILL_EVAL_EMBEDDING_MODEL=
# SKILL_EVAL_EMBEDDING_BASE_URL=

# 其他可选 provider
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- SkillSpector（安全扫描器）----
# LLM provider：nv_build（默认）| openai | anthropic | openai_compatible | ...
# 走 OpenAI 兼容网关时用 openai_compatible（下划线，SkillSpector 的 adapter 名）
SKILLSPECTOR_PROVIDER=openai_compatible
# openai_compatible 网关的凭据（token.cvte.com 等）
SKILLSPECTOR_COMPAT_BASE_URL=
SKILLSPECTOR_COMPAT_API_KEY=
SKILLSPECTOR_MODEL=
# SKILLSPECTOR_OUTPUT_LANGUAGE=
# LLM 并发限制：受限网关（RPM 低）设为 1~2 避免 429 触发语义分析 incomplete
SKILLSPECTOR_MAX_LLM_CONCURRENCY=2

# ---- 通用：uv 运行时依赖下载 ----
# 容器内 `uv tool run` 会联网拉取 skillspector 依赖；默认 PyPI 在容器内易超时
UV_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
UV_HTTP_TIMEOUT=300

# ---- 通用 ----
# LangSmith 追踪（可选）
# LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=
