b\u3001\u7b5b\u9009\u3001\u5bfc\u51fa\u6708\u5ea6\u6c47\u603b\uff1b**\u4e0d\u53ef\u65b0\u589e/\u4fee\u6539/\u5220\u9664/\u5ba1\u6279\u4efb\u4f55\u7533\u8bf7** |\n\n\u6743\u9650\u89c4\u5219\uff1a\n1. \u8de8\u90e8\u95e8\u8bbf\u95ee\uff08\u5458\u5de5\u67e5\u770b\u4ed6\u4eba\u7533\u8bf7\u3001\u4e3b\u7ba1\u67e5\u770b\u975e\u672c\u90e8\u95e8\u7533\u8bf7\uff09\u4e00\u5f8b\u62d2\u7edd\uff0c\u8fd4\u56de\u65e0\u6743\u9650\u63d0\u793a\u4e14\u4e0d\u66b4\u9732\u6570\u636e\u662f\u5426\u5b58\u5728\u3002\n2. \u4e3b\u7ba1\u4e0d\u5728\u5c97\u6216\u5ba1\u6279\u4eba\u4e3a\u7a7a\u65f6\uff0c\u672c\u671f\u6309\u300c\u8f6c\u4ea4\u672c\u90e8\u95e8\u6307\u5b9a\u4ee3\u7406\u5ba1\u6279\u4eba\u300d\u5904\u7406\uff1b\u82e5\u65e0\u4ee3\u7406\u4eba\uff0c\u5219\u7531 HR \u624b\u52a8\u6307\u5b9a\u5ba1\u6279\u4eba\uff08\u89c1 9. \u5f02\u5e38\u573a\u666f E3\uff09\u3002\n3. \u4eba\u5458\u90e8\u95e8\u8c03\u52a8\u540e\uff0c\u5386\u53f2\u7533\u8bf7\u4ecd\u5f52\u5c5e\u539f\u90e8\u95e8\u4e0e\u539f\u5ba1\u6279\u94fe\uff0c\u65b0\u7533\u8bf7\u5f52\u5c5e\u65b0\u90e8\u95e8\u3002\n4. \u6240\u6709\u67e5\u770b\u3001\u4fee\u6539\u3001\u5ba1\u6279\u3001\u5bfc\u51fa\u64cd\u4f5c\u5747\u8bb0\u5f55\u64cd\u4f5c\u65e5\u5fd7\uff08\u64cd\u4f5c\u4eba\u3001\u65f6\u95f4\u3001IP\u3001\u52a8\u4f5c\u3001\u5bf9\u8c61 ID\uff09\u3002\n\n---\n\n## 3. \u529f\u80fd\u9700\u6c42\n\n### 3.1 \u63d0\u4ea4/\u7f16\u8f91\u52a0\u73ed\u7533\u8bf7\uff08FR-01\uff09\n\n| \u5b57\u6bb5 | \u7c7b\u578b | \u5fc5\u586b | \u6821\u9a8c\u89c4\u5219 |\n| --- | --- | --- | --- |\n| \u52a0\u73ed\u65e5\u671f | \u65e5\u671f | \u662f | \u4e0d\u5f97\u665a\u4e8e\u5f53\u524d\u65e5\u671f +1 \u5929\uff1b\u4e0d\u5f97\u65e9\u4e8e\u5f53\u524d\u65e5\u671f \u221290 \u5929\uff08\u8d85\u51fa\u8303\u56f4\u9700\u63d0\u793a\u8865\u5f55\u8bf4\u660e\uff09\uff1b\u4e0d\u53ef\u9009\u672a\u6765\u8d85\u8fc7 1 \u5929 |\n| \u5f00\u59cb\u65f6\u95f4 | \u65f6\u95f4\uff08HH:mm\uff09 | \u662f | \u7cbe\u786e\u5230\u5206\u949f |\n| \u7ed3\u675f\u65f6\u95f4 | \u65f6\u95f4\uff08HH:mm\uff09 | \u662f | \u5fc5\u987b\u665a\u4e8e\u5f00\u59cb\u65f6\u95f4\uff1b\u5141\u8bb8\u8de8\u5929\uff08\u7ed3\u675f\u65f6\u95f4\u843d\u5728\u6b21\u65e5\uff09\uff0c\u8de8\u5929\u65f6\u52a0\u73ed\u65e5\u671f\u4e3a\u5f00\u59cb\u65f6\u95f4\u6240\u5728\u65e5\u671f |\n| \u52a0\u73ed\u4e8b\u7531 | \u6587\u672c | \u5426 | \u2264 200 \u5b57\uff0c\u8d85\u51fa\u65f6\u7981\u6b62\u63d0\u4ea4\u5e76\u63d0\u793a\u5269\u4f59\u5b57\u6570 |\n| \u52a0\u73ed\u65f6\u957f | \u6570\u503c\uff08\u5c0f\u65f6\uff09 | \u7cfb\u7edf\u751f\u6210 | \u7531\u8d77\u6b62\u65f6\u95f4\u81ea\u52a8\u8ba1\u7b97\uff0c\u53ea\u8bfb\uff0c\u4e0d\u53ef\u624b\u5de5\u4fee\u6539 |\n\n\u529f\u80fd\u8981\u6c42\uff1a\n- FR-01.1 \u8868\u5355\u5b9e\u65f6\u8ba1\u7b97\u5e76\u5c55\u793a\u52a0\u73ed\u65f6\u957f\uff0c\u683c\u5f0f\u4fdd\u7559 2 \u4f4d\u5c0f\u6570\u3002\n- FR-01.2 \u63d0\u4ea4\u524d\u9700\u4e8c\u6b21\u786e\u8ba4\u5f39\u7a97\uff0c\u5c55\u793a\u65e5\u671f\u3001\u8d77\u6b62\u65f6\u95f4\u3001\u65f6\u957f\u3001\u662f\u5426\u6cd5\u5b9a\u8282\u5047\u65e5\u3002\n- FR-01.3 \u540c\u4e00\u5458\u5de5\u540c\u4e00\u65e5\u671f\u5141\u8bb8\u591a\u6761\u52a0\u73ed\u7533\u8bf7\uff08\u5982\u5206\u6bb5\u52a0\u73ed\uff09\uff0c\u4f46\u65f6\u95f4\u6bb5\u4e0d\u5f97\u91cd\u53e0\uff1b\u91cd\u53e0\u65f6\u62e6\u622a\u5e76\u63d0\u793a\u5df2\u6709\u7533\u8bf7\u5355\u53f7\u3002\n- FR-01.4 \u300c\u5f85\u5ba1\u6279\u300d\u72b6\u6001\u4e0b\u5458\u5de5\u53ef\u64a4\u56de\u4e3a\u300c\u8349\u7a3f\u300d\u540e\u518d\u4fee\u6539\uff1b\u300c\u5df2\u9a73\u56de\u300d\u72b6\u6001\u4e0b\u53ef\u4fee\u6539\u540e\u91cd\u65b0\u63d0\u4ea4\uff0c\u91cd\u65b0\u63d0\u4ea4\u540e\u5ba1\u6279\u8bb0\u5f55\u4fdd\u7559\u4e14\u5ba1\u6279\u94fe\u91cd\u65b0\u8ba1\u7b97\u3002\n- FR-01.5 \u300c\u5df2\u901a\u8fc7\u300d\u7684\u7533\u8bf7\u4e0d\u53ef\u4fee\u6539\u3001\u4e0d\u53ef\u5220\u9664\uff1b\u5982\u9700\u66f4\u6b63\uff0c\u7531\u5458\u5de5\u63d0\u4ea4\u65b0\u5355\u5e76\u7ebf\u4e0b\u8bf4\u660e\uff0c\u6216\u7531 HR \u8d70\u540e\u53f0\u6570\u636e\u4fee\u6b63\u6d41\u7a0b\uff08\u9700\u53cc\u4eba\u590d\u6838\uff0c\u8bb0\u5f55\u65e5\u5fd7\uff09\u3002\n- FR-01.6 \u63d0\u4ea4\u6210\u529f\u540e\u751f\u6210\u552f\u4e00\u7533\u8bf7\u5355\u53f7\uff0c\u89c4\u5219\uff1a`OT` + yyyyMMdd + 4 \u4f4d\u6d41\u6c34\uff0c\u5982 `OT202611180007`\u3002\n\n### 3.2 \u52a0\u73ed\u65f6\u957f\u81ea\u52a8\u8ba1\u7b97\uff08FR-02\uff09\n- FR-02.1 \u65f6\u957f =\uff08\u7ed3\u675f\u65f6\u95f4 \u2212 \u5f00\u59cb\u65f6\u95f4\uff09\uff0c\u5355\u4f4d\u5c0f\u65f6\uff0c\u4fdd\u7559 2 \u4f4d\u5c0f\u6570\uff0c\u4e0d\u505a\u53d6\u6574\u3002\n- FR-02.2 \u672c\u671f\u4e0d\u81ea\u52a8\u6263\u9664\u7528\u9910/\u4f11\u606f\u65f6\u95f4\uff1b\u5982\u516c\u53f8\u540e\u7eed\u9700\u6263\u9664\uff0c\u4f5c\u4e3a\u53ef\u914d\u7f6e\u9879\u9884\u7559\uff08\u89c1 10. \u5f85\u786e\u8ba4\u4e8b\u9879 Q1\uff09\u3002\n- FR-02.3 \u52a0\u73ed\u65f6\u957f\u6309**\u6700\u7ec8\u5ba1\u6279\u901a\u8fc7**\u65f6\u7684\u7cfb\u7edf\u8ba1\u7b97\u503c\u4e3a\u51c6\uff1b\u82e5\u8d77\u6b62\u65f6\u95f4\u88ab\u4fee\u6539\uff0c\u65f6\u957f\u4e0e\u52a0\u7b7e\u5224\u5b9a\u5747\u91cd\u65b0\u8ba1\u7b97\u3002\n- FR-02.4 \u5355\u65e5\u7d2f\u8ba1\u52a0\u73ed\u65f6\u957f\u8d85\u8fc7 12 \u5c0f\u65f6\u65f6\uff0c\u63d0\u4ea4\u65f6\u7ed9\u51fa\u5f3a\u63d0\u793a\u5e76\u8981\u6c42\u786e\u8ba4\uff08\u4ec5\u63d0\u793a\uff0c\u4e0d\u5f3a\u5236\u62e6\u622a\uff09\u3002\n\n### 3.3 \u5ba1\u6279\u6d41\u7a0b\uff08FR-03\uff09\n\n```\n\u5458\u5de5\u63d0\u4ea4\n  \u2502\n  \u251c\u2500 \u65f6\u957f \u2264 4 \u5c0f\u65f6\uff1a\u90e8\u95e8\u4e3b\u7ba1\u5ba1\u6279 \u2500 \u540c\u610f \u2192 \u5df2\u901a\u8fc7\n  \u2502                              \u2514 \u9a73\u56de\uff08\u5fc5\u586b\u539f\u56e0\uff09\u2192 \u5df2\u9a73\u56de\n  \u2502\n  \u2514\u2500 \u65f6\u957f > 4 \u5c0f\u65f6\uff1a\u90e8\u95e8\u4e3b\u7ba1\u5ba1\u6279 \u2500 \u540c\u610f \u2192 \u90e8\u95e8\u603b\u76d1\u52a0\u7b7e \u2500 \u540c\u610f \u2192 \u5df2\u901a\u8fc7\n                    \uff08\u9a73\u56de \u2192 \u5df2\u9a73\u56de\uff09              \u2514 \u9a73\u56de\uff08\u5fc5\u586b\u539f\u56e0\uff09\u2192 \u5df2\u9a73\u56de\n```\n\n- FR-03.1 \u52a0\u7b7e\u5224\u5b9a\u4f9d\u636e\u4e3a\u52a0\u73ed\u65f6\u957f > 4 \u5c0f\u65f6\uff08\u4e25\u683c\u5927\u4e8e 4\uff0c\u7b49\u4e8e 4 \u5c0f\u65f6\u4e0d\u52a0\u7b7e\uff09\u3002\n- FR-03.2 \u9a73\u56de\u4e3a\u7ec8\u6001\uff1a\u4efb\u4e00\u73af\u8282\u9a73\u56de\uff0c\u5355\u636e\u72b6\u6001\u5373\u4e3a\u300c\u5df2\u9a73\u56de\u300d\uff0c\u6d41\u7a0b\u7ed3\u675f\uff0c\u4e0d\u518d\u6d41\u8f6c\u81f3\u603b\u76d1\u3002\n- FR-03.3 \u9a73\u56de\u65f6\u5fc5\u987b\u586b\u5199\u539f\u56e0\uff0c1\u2013200 \u5b57\uff0c\u672a\u586b\u5199\u4e0d\u53ef\u63d0\u4ea4\u3002\n- FR-03.4 \u5ba1\u6279\u64cd\u4f5c\u9700\u586b\u5199\u5ba1\u6279\u610f\u89c1\uff08\u540c\u610f\u65f6\u9009\u586b\uff0c\u2264200 \u5b57\uff09\uff0c\u5e76\u8bb0\u5f55\u5ba1\u6279\u4eba\u3001\u5ba1\u6279\u65f6\u95f4\u3001\u5ba1\u6279\u52a8\u4f5c\u3002\n- FR-03.5 \u5ba1\u6279\u4eba\u4e0d\u53ef\u5ba1\u6279\u672c\u4eba\u63d0\u4ea4\u7684\u7533\u8bf7\uff1b\u82e5\u5224\u5b9a\u4e3a\u540c\u4e00\u4eba\uff0c\u81ea\u52a8\u5411\u4e0a\u63d0\u5347\u81f3\u5176\u4e0a\u7ea7/\u603b\u76d1\u5ba1\u6279\uff0c\u5e76\u8bb0\u5f55\u8df3\u8fc7\u539f\u56e0\u3002\n- FR-03.6 \u6d88\u606f\u901a\u77e5\uff1a\u63d0\u4ea4\u3001\u5ba1\u6279\u901a\u8fc7\u3001\u9a73\u56de\u65f6\uff0c\u5411\u76f8\u5173\u4eba\u53d1\u9001\u7ad9\u5185\u6d88\u606f + \u90ae\u4ef6\uff08\u53ef\u914d\u7f6e\u5f00\u5173\uff09\u3002\n- FR-03.7 \u672c\u671f\u4e0d\u8981\u6c42\u5ba1\u6279\u8d85\u65f6\u81ea\u52a8\u5347\u7ea7\u6216\u50ac\u529e\uff08\u4f5c\u4e3a V1.1 \u5019\u9009\uff0c\u89c1 Q4\uff09\u3002\n\n### 3.4 \u6cd5\u5b9a\u8282\u5047\u65e5\u81ea\u52a8\u6807\u8bb0\uff08FR-04\uff09\n- FR-04.1 \u7cfb\u7edf\u4f9d\u636e\u8282\u5047\u65e5\u65e5\u5386\uff08\u9700\u652f\u6301\u56fd\u52a1\u9662\u53d1\u5e03\u7684\u6cd5\u5b9a\u8282\u5047\u65e5\u53ca\u8c03\u4f11\u5b89\u6392\uff09\u81ea\u52a8\u5224\u65ad\u52a0\u73ed\u65e5\u671f\u5c5e\u6027\uff1a`\u5de5\u4f5c\u65e5 / \u4f11\u606f\u65e5 / \u6cd5\u5b9a\u8282\u5047\u65e5`\u3002\n- FR-04.2 \u5c5e\u4e8e\u6cd5\u5b9a\u8282\u5047\u65e5\u65f6\uff0c\u7533\u8bf7\u5355\u5217\u8868\u4e0e\u8be6\u60c5\u4ee5\u6807\u7b7e\u300c\u6cd5\u5b9a\u8282\u5047\u65e5\u300d\u6807\u8bc6\uff0cHR \u6c47\u603b\u4e2d\u5355\u72ec\u6210\u5217\u7edf\u8ba1\u3002\n- FR-04.3 \u8c03\u4f11\u4e0a\u73ed\u65e5\uff08\u5982\u8282\u524d\u7684\u5468\u516d\u8865\u73ed\uff09\u6309\u5de5\u4f5c\u65e5\u5904\u7406\uff0c\u4e0d\u6807\u8bb0\u4e3a\u8282\u5047\u65e5\u3002\n- FR-04.4 \u8282\u5047\u65e5\u65e5\u5386\u7531 HR \u5728\u540e\u53f0\u7ef4\u62a4\uff08\u6309\u5e74\u4efd\u5bfc\u5165/\u7f16\u8f91\uff09\uff0c\u7ef4\u62a4\u540e\u65b0\u63d0\u4ea4\u7684\u5355\u636e\u6309\u65b0\u65e5\u5386\u91cd\u65b0\u6807\u8bb0\uff1b**\u5df2\u63d0\u4ea4\u5355\u636e\u4e0d\u81ea\u52a8\u56de\u6eaf\u4fee\u6539\u6807\u8bb0**\uff0c\u5982\u9700\u66f4\u6b63\u7531 HR \u624b\u52a8\u89e6\u53d1\u91cd\u65b0\u8ba1\u7b97\u5e76\u8bb0\u5f55\u65e5\u5fd7\u3002\n- FR-04.5 \u5f53\u52a0\u73ed\u65f6\u6bb5\u8de8\u5929\u4e14\u8de8\u5165\u6b21\u65e5\u96f6\u70b9\u540e\uff0c\u6309\u52a0\u73ed\u65e5\u671f\uff08\u5f00\u59cb\u65f6\u95f4\u6240\u5728\u65e5\uff09\u7684\u5c5e\u6027\u5224\u5b9a\u3002\n\n### 3.5 \u5217\u8868\u4e0e\u67e5\u8be2\uff08FR-05\uff09\n\u5458\u5de5\u7aef\u5217\u8868\u5b57\u6bb5\uff1a\u7533\u8bf7\u5355\u53f7\u3001\u52a0\u73ed\u65e5\u671f\u3001\u52a0\u73ed\u65f6\u957f\u3001\u72b6\u6001\u3001\u63d0\u4ea4\u65f6\u95f4\uff1b\n- \u7b5b\u9009\u6761\u4ef6\uff1a\u72b6\u6001\uff08\u5168\u90e8/\u5f85\u5ba1\u6279/\u5df2\u901a\u8fc7/\u5df2\u9a73\u56de\uff09\u3001\u6708\u4efd\uff08\u9ed8\u8ba4\u5f53\u6708\uff09\uff1b\n- \u9ed8\u8ba4\u6392\u5e8f\uff1a\u63d0\u4ea4\u65f6\u95f4\u5012\u5e8f\uff1b\u5206\u9875 20 \u6761/\u9875\uff1b\n- \u70b9\u51fb\u884c\u8fdb\u5165\u8be6\u60c5\uff0c\u8be6\u60c5\u9875\u5c55\u793a\u5b8c\u6574\u5b57\u6bb5\u4e0e\u5ba1\u6279\u6d41\u8f6c\u8bb0\u5f55\uff08\u65f6\u95f4\u8f74\uff09\u3002\n\n\u4e3b\u7ba1/\u603b\u76d1\u7aef\u5217\u8868\u5b57\u6bb5\uff1a\u5728\u4e0a\u8ff0\u57fa\u7840\u4e0a\u589e\u52a0\u300c\u7533\u8bf7\u4eba\u3001\u90e8\u95e8\u300d\uff0c\u5e76\u652f\u6301\u6309\u7533\u8bf7\u4eba\u3001\u5f85\u6211\u5ba1\u6279\uff08\u9ed8\u8ba4\u89c6\u56fe\uff09\u7b5b\u9009\u3002\n\nHR \u7aef\u5217\u8868\u5b57\u6bb5\uff1a\u7533\u8bf7\u4eba\u3001\u5de5\u53f7\u3001\u90e8\u95e8\u3001\u52a0\u73ed\u65e5\u671f\u3001\u661f\u671f\u3001\u5f00\u59cb\u65f6\u95f4\u3001\u7ed3\u675f\u65f6\u95f4\u3001\u65f6\u957f\u3001\u65e5\u671f\u5c5e\u6027\uff08\u5de5\u4f5c\u65e5/\u4f11\u606f\u65e5/\u6cd5\u5b9a\u8282\u5047\u65e5\uff09\u3001\u72b6\u6001\u3001\u5ba1\u6279\u4eba\u3001\u63d0\u4ea4\u65f6\u95f4\uff1b\n- \u7b5b\u9009\u6761\u4ef6\uff1a\u6708\u4efd/\u81ea\u5b9a\u4e49\u65e5\u671f\u533a\u95f4\u3001\u90e8\u95e8\u3001\u5458\u5de5\uff08\u59d3\u540d\u6216\u5de5\u53f7\u6a21\u7cca\u641c\u7d22\uff09\u3001\u72b6\u6001\u3001\u65e5\u671f\u5c5e\u6027\uff1b\n- \u652f\u6301\u5408\u8ba1\u884c\uff1a\u7b5b\u9009\u7ed3\u679c\u603b\u4eba\u6570\u3001\u603b\u65f6\u957f\u3001\u6309\u65e5\u671f\u5c5e\u6027\u5206\u7ec4\u65f6\u957f\u5c0f\u8ba1\u3002\n\n### 3.6 \u6708\u5ea6\u6c47\u603b\u5bfc\u51fa\uff08FR-06\uff09\n- FR-06.1 HR \u9009\u62e9\u6708\u4efd\uff08\u6216\u533a\u95f4\uff09+ \u90e8\u95e8\uff08\u9ed8\u8ba4\u5168\u90e8\uff09\u540e\u5bfc\u51fa Excel\uff08.xlsx\uff09\u3002\n- FR-06.2 \u5bfc\u51fa\u5185\u5bb9\u542b\u660e\u7ec6\u8868\uff08\u540c 3.5 HR \u5217\u8868\u5b57\u6bb5\uff0c\u4ec5\u5bfc\u51fa\u300c\u5df2\u901a\u8fc7\u300d\u6570\u636e\uff0c\u53ef\u9009\u5305\u542b\u5176\u4ed6\u72b6\u6001\uff09\u4e0e\u6c47\u603b\u8868\uff08\u6309\u4eba\u3001\u6309\u90e8\u95e8\u7edf\u8ba1\u5f53\u6708\u603b\u65f6\u957f\u3001\u6cd5\u5b9a\u8282\u5047\u65e5\u65f6\u957f\u3001\u4f11\u606f\u65e5\u65f6\u957f\u3001\u5de5\u4f5c\u65e5\u65f6\u957f\u3001\u52a0\u73ed\u6b21\u6570\uff09\u3002\n- FR-06.3 \u6587\u4ef6\u540d\uff1a`\u52a0\u73ed\u6c47\u603b\u8868_YYYYMM_\u5bfc\u51fa\u65f6\u95f4.xlsx`\uff1b\u8868\u5185\u542b\u5bfc\u51fa\u7b5b\u9009\u6761\u4ef6\u8bf4\u660e\u3002\n- FR-06.4 \u5355\u6b21\u5bfc\u51fa\u4e0a\u9650 50,000 \u884c\uff0c\u8d85\u51fa\u65f6\u63d0\u793a\u7f29