\u5e95\u90e8\u5b9e\u65f6\u603b\u989d\uff1b\n2. **\u5ba1\u6279\u9875**\uff1a\u5355\u636e\u6982\u8981 \u2192 \u660e\u7ec6\u884c\u5217\u8868\uff08\u542b\u603b\u989d\uff09\u2192 \u884c\u5185\u7f29\u7565\u56fe \u2192 \u70b9\u51fb\u653e\u5927\u9884\u89c8\u5c42 \u2192 \u5ba1\u6279\u610f\u89c1\u4e0e\u64cd\u4f5c\u6309\u94ae\uff1b\n3. **\u5217\u8868\u9875**\uff1a\u65b0\u589e\u300c\u660e\u7ec6\u884c\u6570 / \u8d39\u7528\u7c7b\u578b\u6c47\u603b\u300d\u5217\uff0c\u652f\u6301\u5c55\u5f00\u67e5\u770b\uff1b\n4. **\u8d22\u52a1\u5bfc\u51fa\u9875**\uff1a\u7b5b\u9009\u533a + \u5bfc\u51fa\u7c92\u5ea6\u9009\u62e9 + \u5b57\u6bb5/\u6a21\u677f\u9009\u62e9 + \u5bfc\u51fa\u8bb0\u5f55\u4e0e\u4e0b\u8f7d\u4e2d\u5fc3\uff1b\n5. \u5386\u53f2\u5355\u636e\u8be6\u60c5\u9875\u4e0e\u65b0\u7248\u5e03\u5c40\u4fdd\u6301\u4e00\u81f4\uff0c\u4f46\u7f16\u8f91\u63a7\u4ef6\u7981\u7528\u3002\n\n\u5177\u4f53\u89c6\u89c9\u4e0e\u5e03\u5c40\u7531 UI/UX \u8f93\u51fa\u8bbe\u8ba1\u7a3f\uff0c\u672c\u6587\u6863\u7ea6\u5b9a\u4fe1\u606f\u8981\u7d20\u4e0e\u4ea4\u4e92\u903b\u8f91\u3002\n\n---\n\n## 10. \u63a5\u53e3\u9700\u6c42\uff08\u6982\u8981\uff09\n\n| \u63a5\u53e3 | \u8bf4\u660e |\n| --- | --- |\n| \u4fdd\u5b58/\u63d0\u4ea4\u62a5\u9500\u5355 | \u5165\u53c2\u542b\u660e\u7ec6\u884c\u6570\u7ec4\u4e0e\u5173\u8054\u9644\u4ef6 ID\uff0c\u670d\u52a1\u7aef\u6821\u9a8c\u603b\u989d\u4e0e\u5fc5\u586b\u9879 |\n| \u9644\u4ef6\u4e0a\u4f20 | \u5206\u7247/\u76f4\u4f20\u5bf9\u8c61\u5b58\u50a8\uff0c\u8fd4\u56de\u6587\u4ef6 Key \u4e0e\u9884\u89c8\u5730\u5740 |\n| \u9644\u4ef6\u9884\u89c8/\u4e0b\u8f7d | \u9274\u6743\u540e\u8fd4\u56de\u9650\u65f6\u7b7e\u540d URL |\n| \u5ba1\u6279\u64cd\u4f5c | \u4f20\u5165\u5355\u636e ID\u3001\u52a8\u4f5c\u3001\u610f\u89c1\u3001\u53ef\u9009\u5173\u8054\u660e\u7ec6\u884c ID |\n| \u5bfc\u51fa\u4efb\u52a1 | \u4f20\u5165\u7b5b\u9009\u6761\u4ef6\u4e0e\u7c92\u5ea6\uff0c\u8fd4\u56de\u4efb\u52a1 ID\uff1b\u63d0\u4f9b\u8fdb\u5ea6\u67e5\u8be2\u4e0e\u7ed3\u679c\u4e0b\u8f7d\u5730\u5740 |\n| \u8d39\u7528\u7c7b\u578b\u914d\u7f6e | \u589e\u5220\u6539\u67e5\u4e0e\u542f\u7528\u72b6\u6001\u7ef4\u62a4 |\n\n\u4e0e\u4e3b\u6570\u636e\uff08\u5458\u5de5\u3001\u90e8\u95e8\uff09\u3001\u6d88\u606f\u901a\u77e5\uff08\u5f85\u5ba1\u6279\u63d0\u9192\uff09\u3001\u6587\u4ef6\u670d\u52a1\u7684\u65e2\u6709\u96c6\u6210\u9700\u56de\u5f52\u9a8c\u8bc1\u3002\n\n---\n\n## 11. \u9a8c\u6536\u6807\u51c6\n\n| \u7f16\u53f7 | \u9a8c\u6536\u6761\u4ef6 |\n| --- | --- |\n| AC-1 | \u4e00\u5f20\u5355\u636e\u53ef\u6dfb\u52a0 \u2265 2 \u79cd\u4e0d\u540c\u8d39\u7528\u7c7b\u578b\uff0c\u603b\u989d\u81ea\u52a8\u7b49\u4e8e\u5404\u884c\u4e4b\u548c\uff0c\u8bef\u5dee\u4e3a 0 |\n| AC-2 | \u660e\u7ec6\u884c\u5fc5\u586b\u6821\u9a8c\u3001\u91d1\u989d\u6821\u9a8c\u3001\u65e5\u671f\u6821\u9a8c\u3001\u884c\u6570\u4e0a\u9650\u63d0\u793a\u5747\u6309\u89c4\u5219\u751f\u6548 |\n| AC-3 | \u300c\u9700\u53d1\u7968\u300d\u7c7b\u578b\u672a\u4e0a\u4f20\u7167\u7247\u65f6\u65e0\u6cd5\u63d0\u4ea4\uff0c\u63d0\u793a\u51c6\u786e\u5230\u5177\u4f53\u660e\u7ec6\u884c |\n| AC-4 | \u4e3b\u7ba1\u5728\u5ba1\u6279\u9875\u53ef\u76f4\u63a5\u9884\u89c8\u5e76\u4e0b\u8f7d\u660e\u7ec6\u884c\u5bf9\u5e94\u7684\u5168\u90e8\u53d1\u7968\u7167\u7247 |\n| AC-5 | \u9000\u56de\u8865\u5145\u6750\u6599\u53ef\u5b9a\u4f4d\u5230\u660e\u7ec6\u884c\uff0c\u5458\u5de5\u7aef\u9ad8\u4eae\u663e\u793a\u5e76\u53ef\u4fee\u6539\u540e\u91cd\u65b0\u63d0\u4ea4 |\n| AC-6 | \u8d22\u52a1\u6309\u671f\u95f4/\u90e8\u95e8/\u7c7b\u578b\u7b5b\u9009\u5bfc\u51fa\u7684 Excel \u6570\u636e\u4e0e\u7cfb\u7edf\u67e5\u8be2\u7ed3\u679c\u5b8c\u5168\u4e00\u81f4\uff0c\u542b\u6c47\u603b\u9875 |\n| AC-7 | \u8d85\u4e0a\u9650\u5bfc\u51fa\u8f6c\u5f02\u6b65\u4efb\u52a1\u5e76\u6210\u529f\u83b7\u53d6\u6587\u4ef6\uff0c\u524d\u53f0\u65e0\u963b\u585e |\n| AC-8 | \u62bd\u53d6 \u2265 1000 \u6761\u5386\u53f2\u5355\u636e\uff1a\u53ef\u67e5\u770b\u3001\u603b\u989d\u4e00\u81f4\u3001\u5ba1\u6279\u8bb0\u5f55\u5b8c\u6574\u3001\u65e0\u53d1\u7968\u5b57\u6bb5\u4e0d\u62a5\u9519 |\n| AC-9 | \u5386\u53f2\u5355\u636e\u4e0d\u53ef\u7f16\u8f91\u3001