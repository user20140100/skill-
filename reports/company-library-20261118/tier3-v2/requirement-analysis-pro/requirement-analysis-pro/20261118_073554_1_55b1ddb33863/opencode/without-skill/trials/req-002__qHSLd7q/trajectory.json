8ba1\u98ce\u9669\u9ad8 |\n| P3 | \u8d22\u52a1\u65e0\u6cd5\u6279\u91cf\u5bfc\u51fa\u62a5\u9500\u6570\u636e | \u9700\u4eba\u5de5\u9010\u5355\u67e5\u770b\u3001\u624b\u5de5\u5f55\u5165\u8868\u683c | \u6548\u7387\u4f4e\u3001\u6613\u51fa\u9519\u3001\u96be\u4ee5\u5bf9\u63a5\u8d26\u52a1\u7cfb\u7edf |\n\n---\n\n## 4. \u6539\u9020\u8303\u56f4\n\n### 4.1 \u8303\u56f4\u5185\uff08In Scope\uff09\n1. \u62a5\u9500\u5355\u586b\u5199\u9875\u652f\u6301\u591a\u8d39\u7528\u660e\u7ec6\u884c\u7684\u589e\u3001\u5220\u3001\u6539\uff1b\n2. \u660e\u7ec6\u884c\u5173\u8054\u53d1\u7968\u7167\u7247\u7684\u4e0a\u4f20\u3001\u9884\u89c8\u3001\u4e0b\u8f7d\uff1b\n3. \u5ba1\u6279\u9875\u5c55\u793a\u660e\u7ec6\u884c\u4e0e\u53d1\u7968\u7167\u7247\uff1b\n4. \u8d22\u52a1\u5bfc\u51fa\u529f\u80fd\uff08\u6761\u4ef6\u7b5b\u9009 + \u6587\u4ef6\u751f\u6210\uff09\uff1b\n5. \u5386\u53f2\u6570\u636e\u517c\u5bb9\u4e0e\u5c55\u793a\u9002\u914d\uff1b\n6. \u76f8\u5173\u6570\u636e\u7ed3\u6784\u3001\u63a5\u53e3\u3001\u6743\u9650\u7684\u8c03\u6574\u3002\n\n### 4.2 \u8303\u56f4\u5916\uff08Out of Scope\uff09\n1. \u62a5\u9500\u6807\u51c6\u7684\u89c4\u5219\u5f15\u64ce\u91cd\u6784\uff08\u5982\u5dee\u65c5\u6807\u51c6\u81ea\u52a8\u6821\u9a8c\uff09\uff0c\u672c\u6b21\u4ec5\u4fdd\u7559\u73b0\u6709\u89c4\u5219\uff1b\n2. \u79fb\u52a8\u7aef\u539f\u751f App \u6539\u7248\uff08\u5982\u73b0\u72b6\u4e3a Web\uff0c\u672c\u6b21\u4e0d\u542b App \u4e13\u9879\u5f00\u53d1\uff09\uff1b\n3. \u4e0e\u7b2c\u4e09\u65b9\u53d1\u7968\u9a8c\u771f\u5e73\u53f0\u7684\u5bf9\u63a5\uff08\u672c\u6b21\u4ec5\u652f\u6301\u5f71\u50cf\u7559\u5b58\uff0c\u9a8c\u771f\u80fd\u529b\u5217\u5165\u540e\u7eed\u89c4\u5212\uff09\uff1b\n4. \u4ed8\u6b3e/\u6253\u6b3e\u6d41\u7a0b\u672c\u8eab\u7684\u6539\u9020\uff1b\n5. \u5386\u53f2\u5355\u636e\u6570\u636e\u7684\u6279\u91cf\u8865\u5f55\u53d1\u7968\u7167\u7247\u3002\n\n---\n\n## 5. \u89d2\u8272\u4e0e\u6743\u9650\n\n| \u89d2\u8272 | \u4e3b\u8981\u64cd\u4f5c | \u6743\u9650\u8bf4\u660e |\n| --- | --- | --- |\n| \u5458\u5de5\uff08\u63d0\u4ea4\u4eba\uff09 | \u65b0\u5efa/\u7f16\u8f91/\u63d0\u4ea4\u672c\u4eba\u62a5\u9500\u5355\u3001\u4e0a\u4f20\u53d1\u7968\u3001\u64a4\u56de\u672a\u5ba1\u5355\u636e\u3001\u67e5\u770b\u672c\u4eba\u5355\u636e | \u4ec5\u53ef\u64cd\u4f5c\u672c\u4eba\u521b\u5efa\u7684\u5355\u636e |\n| \u90e8\u95e8\u4e3b\u7ba1\uff08\u5ba1\u6279\u4eba\uff09 | \u67e5\u770b\u5f85\u5ba1\u5355\u636e\u660e\u7ec6\u4e0e\u53d1\u7968\u3001\u540c\u610f/\u9a73\u56de/\u9000\u56de\u8865\u5145\u6750\u6599 | \u4ec5\u53ef\u5ba1\u6279\u672c\u90e8\u95e8\u7684\u5355\u636e |\n| \u8d22\u52a1 | \u67e5\u770b\u5168\u516c\u53f8\u751f\u6548\u5355\u636e\u3001\u5bfc\u51fa\u62a5\u9500\u6570\u636e\u3001\u7ef4\u62a4\u8d39\u7528\u7c7b\u578b\u4e0e\u5bfc\u51fa\u6a21\u677f | \u53ea\u8bfb + \u5bfc\u51fa\uff1b\u4e0d\u53c2\u4e0e\u5ba1\u6279\u51b3\u7b56 |\n| \u7cfb\u7edf\u7ba1\u7406\u5458 | \u8d39\u7528\u7c7b\u578b\u914d\u7f6e\u3001\u5b58\u50a8\u914d\u7f6e\u3001\u6743\u9650\u914d\u7f6e | \u540e\u53f0\u7ba1\u7406\uff0c\u4e0d\u53c2\u4e0e\u4e1a\u52a1\u6d41\u8f6c |\n\n---\n\n## 6. \u529f\u80fd\u9700\u6c42\n\n### FR-1 \u591a\u8d39\u7528\u7c7b\u578b\u660e\u7ec6\n\n**\u4f18\u5148\u7ea7\uff1a\u9ad8**\n\n**\u63cf\u8ff0**\uff1a\u5c06\u62a5\u9500\u5355\u7684\u6570\u636e\u7ed3\u6784\u7531\u300c\u5355\u636e\u2014\u5355\u4e00\u8d39\u7528\u300d\u8c03\u6574\u4e3a\u300c\u5355\u636e\u2014\u591a\u6761\u8d39\u7528\u660e\u7ec6\u884c\u300d\u3002\n\n| \u7f16\u53f7 | \u9700\u6c42\u70b9 | \u8bf4\u660e |\n| --- | --- | --- |\n| FR-1.1 | \u65b0\u589e\u660e\u7ec6\u884c | \u5355\u636e\u586b\u5199\u9875\u63d0\u4f9b\u300c\u6dfb\u52a0\u8d39\u7528\u300d\u6309\u94ae\uff0c\u652f\u6301\u6dfb\u52a0\u591a\u6761\u660e\u7ec6\u884c |\n| FR-1.2 | \u660e\u7ec6\u884c\u5b57\u6bb5 | \u6bcf\u884c\u5305\u542b\uff1a\u8d39\u7528\u7c7b\u578b\u3001\u53d1\u751f\u65e5\u671f\u3001\u91d1\u989d\u3001\u5e01\u79cd\uff08\u9ed8\u8ba4 CNY\uff09\u3001\u5907\u6ce8\u3001\u53d1\u7968\u7167\u7247\uff08\u89c1 FR-2\uff09 |\n| FR-1.3 | \u5220\u9664/\u7f16\u8f91\u660e\u7ec6\u884c | \u5355\u636e\u5728\u300c\u8349\u7a3f/\u88ab\u9a73\u56de\u300d\u72b6\u6001\u4e0b\u53ef\u81ea\u7531\u589e\u5220\u6539\uff1b\u63d0\u4ea4\u540e\u4e0d\u53ef\u589e\u5220\u6539\uff0c\u4ec5\u53ef\u901a\u8fc7\u9a73\u56de\u9000\u56de\u4fee\u6539 |\n| FR-1.4 | \u603b\u989d\u81ea\u52a8\u6c47\u603b | \u5355\u636e\u62a5\u9500\u603b\u989d = \u5404\u660e\u7ec6\u884c\u91d1\u989d\u4e4b\u548c\uff0c\u7cfb\u7edf\u81ea\u52a8\u8ba1\u7b97\uff0c\u53ea\u8bfb\u5c55\u793a\uff0c\u4e0d\u5141\u8bb8\u624b\u5de5\u586b\u5199 |\n| FR-1.5 | \u8d39\u7528\u7c7b\u578b\u53ef\u914d\u7f6e | \u8d39\u7528\u7c7b\u578b\u7531\u8d22\u52a1\u5728\u540e\u53f0\u7ef4\u62a4\uff08\u540d\u79f0\u3001\u542f\u7528\u72b6\u6001\u3001\u6392\u5e8f\u3001\u662f\u5426\u9700\u53d1\u7968\uff09\uff0c\u4e0b\u62c9\u9009\u62e9 |\n| FR-1.6 | \u6700\u5c11\u4e00\u6761\u660e\u7ec6 | \u63d0\u4ea4\u65f6\u81f3\u5c11\u5b58\u5728 1 \u6761\u5b8c\u6574\u586b\u5199\u7684\u660e\u7ec6\u884c\uff0c\u5426\u5219\u4e0d\u5141\u8bb8\u63d0\u4ea4 |\n| FR-1.7 | \u660e\u7ec6\u884c\u6392\u5e8f\u4e0e\u5c55\u793a | \u5ba1\u6279\u4e0e\u8be6\u60c5\u9875\u6309\u300c\u53d1\u751f\u65e5\u671f + \u8d39\u7528\u7c7b\u578b\u300d\u805a\u5408\u5c55\u793a\uff0c\u652f\u6301\u540c\u7c7b\u8d39\u7528\u5c0f\u8ba1 |\n\n**\u4e1a\u52a1\u89c4\u5219**\n- R1\uff1a\u540c\u4e00\u5355\u636e\u5185\u5141\u8bb8\u51fa\u73b0\u91cd\u590d\u8d39\u7528\u7c7b\u578b\uff08\u5982\u4e24\u5929\u9910\u8d39\u5206\u4e24\u884c\uff09\uff0c\u4e0d\u505a\u53bb\u91cd\u9650\u5236\uff1b\n- R2\uff1a\u660e\u7ec6\u884c\u91d1\u989d\u5fc5\u987b > 0\uff0c\u6700\u591a\u4fdd\u7559 2 \u4f4d\u5c0f\u6570\uff1b\n- R3\uff1a\u53d1\u751f\u65e5\u671f\u4e0d\u5f97\u665a\u4e8e\u5355\u636e\u521b\u5efa\u65e5\u671f\uff0c\u4e0d\u5f97\u65e9\u4e8e\u7cfb\u7edf\u5141\u8bb8\u7684\u6700\u65e9\u53ef\u62a5\u9500\u65e5\u671f\uff08\u6cbf\u7528\u73b0\u6709\u89c4\u5219\uff09\uff1b\n- R4\uff1a\u5355\u5f20\u5355\u636e\u660e\u7ec6\u884c\u6570\u4e0a\u9650 50 \u884c\uff0c\u8d85\u51fa\u63d0\u793a\u62c6\u5206\u63d0\u4ea4\uff1b\n- R5\uff1a\u5355\u636e\u603b\u989d\u4e0a\u9650\u6cbf\u7528\u73b0\u6709\u62a5\u9500\u989d\u5ea6\u89c4\u5219\uff0c\u6539\u9020\u540e\u6309\u6c47\u603b\u503c\u6821\u9a8c\u3002\n\n### FR-2 \u53d1\u7968\u7167\u7247\u4e0a\u4f20\u4e0e\u67e5\u770b\n\n**\u4f18\u5148\u7ea7\uff1a\u9ad8**\n\n| \u7f16\u53f7 | \u9700\u6c42\u70b9 | \u8bf4\u660e |\n| --- | --- | --- |\n| FR-2.1 | \u4e0a\u4f20\u5165\u53e3 | \u6bcf\u6761\u660e\u7ec6\u884c\u652f\u6301\u4e0a\u4f20 1~N \u5f20\u53d1\u7968\u7167\u7247\uff0c\u9ed8\u8ba4\u4e0a\u9650 5 \u5f20/\u884c |\n| FR-2.2 | \u6587\u4ef6\u9650\u5236 | \u652f\u6301 jpg/jpeg/png/pdf/webp\uff1b\u5355\u6587\u4ef6\u5927\u5c0f \u2264 10MB\uff1b\u683c\u5f0f\u6216\u5927\u5c0f\u4e0d\u7b26\u9700\u660e\u786e\u63d0\u793a |\n| FR-2.3 | \u5fc5\u4f20\u63a7\u5236 | \u5f53\u8d39\u7528\u7c7b\u578b\u914d\u7f6e\u4e3a\u300c\u9700\u53d1\u7968\u300d\u65f6\uff0c\u8be5\u660e\u7ec6\u884c\u53d1\u7968\u7167\u7247\u5fc5\u586b |\n| FR-2.4 | \u9884\u89c8 | \u63d0\u4ea4\u9875\u4e0e\u5ba1\u6279\u9875\u652f\u6301\u70b9\u51fb\u7f29\u7565\u56fe\u653e\u5927\u9884\u89c8\uff0c\u652f\u6301\u591a\u56fe\u5de6\u53f3\u5207\u6362\u3001\u65cb\u8f6c\u3001\u9002\u5e94\u7a97\u53e3 |\n| FR-2.5 | \u4e0b\u8f7d/\u6253\u5370 | \u5ba1\u6279\u4eba\u4e0e\u8d22\u52a1\u53ef\u4e0b\u8f7d\u539f\u56fe\uff1b\u5ba1\u6279\u9875\u652f\u6301\u300c\u6253\u5370\u5355\u636e\uff08\u542b\u7968\u636e\uff09\u300d |\n| FR-2.6 | \u4e0a\u4f20\u4ea4\u4e92 | \u652f\u6301\u672c\u5730\u9009\u62e9\u3001\u62d6\u62fd\u4e0a\u4f20\u3001\u62cd\u7167\u4e0a\u4f20\uff08\u79fb\u52a8\u7aef/\u6444\u50cf\u5934\uff09\uff1b\u663e\u793a\u4e0a\u4f20\u8fdb\u5ea6\uff0c\u5931\u8d25\u53ef\u91cd\u8bd5 |\n| FR-2.7 | \u5173\u8054\u5173\u7cfb | \u53d1\u7968\u7167\u7247\u4e0e\u660e\u7ec6\u884c\u4e00\u4e00\u7ed1\u5b9a\uff0c\u4e0d\u53ef\u8de8\u884c\u6df7\u7528\uff1b\u5220\u9664\u660e\u7ec6\u884c\u65f6\u5176\u53d1\u7968\u4e00\u5e76\u5931\u6548 |\n| FR-2.8 | \u5b89\u5168\u4e0e\u5b58\u50a8 | \u5f71\u50cf\u6587\u4ef6\u5b58\u4e8e\u5bf9\u8c61\u5b58\u50a8/\u6587\u4ef6\u670d\u52a1\uff0c\u8bbf\u95ee\u8d70\u9274\u6743\u7b7e\u540d\u94fe\u63a5\uff0c\u7981\u6b62\u65e0\u9274\u6743\u516c\u5f00\u8bbf\u95ee |\n\n**\u4e1a\u52a1\u89c4\u5219**\n- R6\uff1a\u9a73\u56de\u9000\u56de\u540e\uff0c\u5458\u5de5\u53ef\u66ff\u6362/\u8865\u5145\u53d1\u7968\u7167\u7247\uff1b\n- R7\uff1a\u5355\u636e\u8fdb\u5165\u7ec8\u6001\uff08\u901a\u8fc7\u5e76\u5f52\u6863\uff09\u540e\uff0c\u53d1\u7968\u7167\u7247\u53ea\u8bfb\uff0c\u4e0d\u53ef\u5220\u9664\u6216\u66ff\u6362\uff1b\n- R8\uff1a\u9700\u4fdd\u7559\u6587\u4ef6\u539f\u59cb\u540d\u79f0\u3001\u5927\u5c0f\u3001\u683c\u5f0f\u3001\u4e0a\u4f20\u4eba\u3001\u4e0a\u4f20\u65f6\u95f4\u7528\u4e8e\u5ba1\u8ba1\u3002\n\n### FR-3 \u5ba1\u6279\u73af\u8282\u6539\u9020\n\n**\u4f18\u5148\u7ea7\uff1a\u9ad8**\n\n| \u7f16\u53f7 | \u9700\u6c42\u70b9 | \u8bf4\u660e |\n| --- | --- | --- |\n| FR-3.1 | \u660e\u7ec6\u5217\u8868\u5c55\u793a | \u5ba1\u6279\u9875\u5b8c\u6574\u5c55\u793a\u6240\u6709\u660e\u7ec6\u884c\uff08\u7c7b\u578b\u3001\u65e5\u671f\u3001\u91d1\u989d\u3001\u5907\u6ce8\uff09\u4e0e\u603b\u989d |\n| FR-3.2 | \u53d1\u7968\u540c\u5c4f\u53ef\u89c1 | \u70b9\u51fb\u660e\u7ec6\u884c\u5373\u53ef\u67e5\u770b\u5bf9\u5e94\u53d1\u7968\u7167\u7247\uff0c\u65e0\u9700\u8df3\u8f6c\u65b0\u9875\u9762\u4e0b\u8f7d\u540e\u518d\u67e5\u770b |\n| FR-3.3 | \u5feb\u901f\u5b9a\u4f4d | \u652f\u6301\u300c\u9010\u6761\u5ba1\u6279\u89c6\u56fe\u300d\uff1a\u5de6\u53f3\u4e24\u4fa7\u5206\u522b\u4e3a\u660e\u7ec6\u4fe1\u606f\u4e0e\u53d1\u7968\u5927\u56fe\uff0c\u4fbf\u4e8e\u6838\u5bf9 |\n| FR-3.4 | \u5ba1\u6279\u52a8\u4f5c | \u540c\u610f\u3001\u9a73\u56de\uff08\u9700\u586b\u610f\u89c1\uff09\u3001\u9000\u56de\u8865\u5145\u6750\u6599\uff08\u6307\u5b9a\u5177\u4f53\u660e\u7ec6\u884c\u9700\u8865\u53d1\u7968/\u6539\u91d1\u989d\uff09 |\n| FR-3.5 | \u5b9a\u4f4d\u95ee\u9898 | \u9000\u56de\u8865\u5145\u65f6\uff0c\u5ba1\u6279\u610f\u89c1\u53ef\u5173\u8054\u5230\u67d0\u6761\u660e\u7ec6\u884c\uff0c\u5458\u5de5\u7aef\u9ad8\u4eae\u8be5\u95ee\u9898\u884c |\n| FR-3.6 | \u90e8\u5206\u901a\u8fc7\uff08\u5f85\u786e\u8ba4\uff09 | \u662f