a1 |\n\n---\n\n## 1. \u80cc\u666f\u4e0e\u76ee\u6807\n\n### 1.1 \u73b0\u72b6\u95ee\u9898\n1. \u4e00\u5f20\u62a5\u9500\u5355\u4ec5\u652f\u6301\u586b\u5199\u4e00\u79cd\u8d39\u7528\u7c7b\u578b\uff0c\u5458\u5de5\u591a\u7c7b\u8d39\u7528\u9700\u62c6\u6210\u591a\u5355\u63d0\u4ea4\uff0c\u64cd\u4f5c\u7e41\u7410\u3001\u5ba1\u6279\u91cf\u5927\u3002\n2. \u5ba1\u6279\u4eba\u5728\u5ba1\u6279\u65f6\u65e0\u6cd5\u67e5\u770b\u53d1\u7968\u7167\u7247\uff0c\u65e0\u6cd5\u6838\u5b9e\u8d39\u7528\u771f\u5b9e\u6027\uff0c\u53ea\u80fd\u7ebf\u4e0b\u7d22\u8981\u7968\u636e\u3002\n\n### 1.2 \u6539\u9020\u76ee\u6807\n1. \u652f\u6301\u4e00\u5f20\u62a5\u9500\u5355\u586b\u5199\u591a\u79cd\u8d39\u7528\u7c7b\u578b\uff08\u5982\u6253\u8f66\u8d39\u3001\u9910\u8d39\u3001\u4f4f\u5bbf\u8d39\u5206\u884c\u5217\u793a\uff09\u3002\n2. \u5ba1\u6279\u4eba\u5728\u5ba1\u6279\u754c\u9762\u53ef\u76f4\u63a5\u67e5\u770b\u6bcf\u6761\u8d39\u7528\u5bf9\u5e94\u7684\u53d1\u7968\u7167\u7247\u3002\n3. \u8d22\u52a1\u652f\u6301\u6309\u6761\u4ef6\u5bfc\u51fa\u62a5\u9500\u6570\u636e\u3002\n4. \u5386\u53f2\u62a5\u9500\u5355\u53ef\u7ee7\u7eed\u6b63\u5e38\u67e5\u770b\uff0c\u6539\u9020\u4e0d\u5f71\u54cd\u5b58\u91cf\u6570\u636e\u3002\n\n---\n\n## 2. \u672f\u8bed\u5b9a\u4e49\n\n| \u672f\u8bed | \u8bf4\u660e |\n| --- | --- |\n| \u62a5\u9500\u5355 | \u5458\u5de5\u63d0\u4ea4\u7684\u4e00\u6b21\u8d39\u7528\u62a5\u9500\u7533\u8bf7 |\n| \u8d39\u7528\u660e\u7ec6\u884c | \u62a5\u9500\u5355\u4e2d\u7684\u4e00\u6761\u8d39\u7528\u8bb0\u5f55\uff0c\u542b\u8d39\u7528\u7c7b\u578b\u3001\u91d1\u989d\u3001\u65e5\u671f\u3001\u53d1\u7968\u7b49 |\n| \u53d1\u7968\u7167\u7247 | \u4e0e\u8d39\u7528\u660e\u7ec6\u884c\u5173\u8054\u7684\u7968\u636e\u5f71\u50cf\u9644\u4ef6 |\n\n---\n\n## 3. \u89d2\u8272\u4e0e\u6743\u9650\n\n| \u89d2\u8272 | \u6743\u9650 |\n| --- | --- |\n| \u5458\u5de5 | \u65b0\u5efa\u3001\u7f16\u8f91\u3001\u5220\u9664\uff08\u63d0\u4ea4\u524d\uff09\u3001\u63d0\u4ea4\u3001\u64a4\u56de\u672c\u4eba\u62a5\u9500\u5355\uff1b\u67e5\u770b\u672c\u4eba\u62a5\u9500\u5355\u53ca\u5ba1\u6279\u8fdb\u5ea6 |\n| \u90e8\u95e8\u4e3b\u7ba1 | \u67e5\u770b\u5f85\u529e/\u5df2\u529e\u62a5\u9500\u5355\uff1b\u67e5\u770b\u8d39\u7528\u660e\u7ec6\u4e0e\u53d1\u7968\u7167\u7247\uff1b\u5ba1\u6279\u901a\u8fc7\u3001\u9a73\u56de\uff08\u9700\u586b\u5199\u610f\u89c1\uff09 |\n| \u8d22\u52a1 | \u67e5\u770b\u6240\u6709\u5df2\u5ba1\u6279\u62a5\u9500\u5355\uff1b\u5bfc\u51fa\u62a5\u9500\u6570\u636e\uff1b\u4e0d\u4fee\u6539\u4e1a\u52a1\u6570\u636e |\n\n---\n\n## 4. \u529f\u80fd\u9700\u6c42\n\n### 4.1 \u591a\u8d39\u7528\u7c7b\u578b\u586b\u62a5\uff08FR-1\uff09\n\n**FR-1.1 \u8d39\u7528\u660e\u7ec6\u7ed3\u6784**\n- \u62a5\u9500\u5355\u7531\u300c\u5355\u5934\u4fe1\u606f + \u591a\u6761\u8d39\u7528\u660e\u7ec6\u884c\u300d\u7ec4\u6210\u3002\n- \u5355\u5934\u4fe1\u606f\uff1a\u62a5\u9500\u4eba\u3001\u6240\u5c5e\u90e8\u95e8\u3001\u62a5\u9500\u4e8b\u7531\u3001\u8d39\u7528\u53d1\u751f\u671f\u95f4\u3001\u62a5\u9500\u603b\u91d1\u989d\uff08\u7cfb\u7edf\u81ea\u52a8\u6c47\u603b\uff0c\u53ea\u8bfb\uff09\u3001\u72b6\u6001\u3002\n- \u8d39\u7528\u660e\u7ec6\u884c\u5b57\u6bb5\uff1a\u8d39\u7528\u7c7b\u578b\uff08\u5fc5\u586b\uff09\u3001\u91d1\u989d\uff08\u5fc5\u586b\uff09\u3001\u53d1\u751f\u65e5\u671f\uff08\u5fc5\u586b\uff09\u3001\u5907\u6ce8\uff08\u9009\u586b\uff09\u3001\u53d1\u7968\u7167\u7247\uff08\u81f3\u5c11 1 \u5f20\uff0c\u5fc5\u586b\uff09\u3002\n\n**FR-1.2 \u8d39\u7528\u7c7b\u578b**\n- \u8d39\u7528\u7c7b\u578b\u53ef\u9009\u9879\u5305\u62ec\uff1a\u6253\u8f66\u8d39\u3001\u9910\u8d39\u3001\u4f4f\u5bbf\u8d39\u3001\u4ea4\u901a\u8d39\u3001\u529e\u516c\u7528\u54c1\u8d39\u3001\u57f9\u8bad\u8d39\u3001\u5176\u4ed6\uff08\u53ef\u901a\u8fc7\u540e\u53f0\u914d\u7f6e\u7ef4\u62a4\uff0c\u542b\u542f\u7528/\u505c\u7528\uff09\u3002\n- \u540c\u4e00\u5f20\u62a5\u9500\u5355\u5141\u8bb8\u591a\u6761\u76f8\u540c\u7c7b\u578b\u7684\u660e\u7ec6\u884c\u3002\n\n**FR-1.3 \u660e\u7ec6\u884c\u64cd\u4f5c**\n- \u652f\u6301\u5728\u586b\u62a5\u9875\u65b0\u589e\u3001\u7f16\u8f91\u3001\u5220\u9664\u660e\u7ec6\u884c\uff1b\u81f3\u5c11\u4fdd\u7559 1 \u6761\u660e\u7ec6\u624d\u53ef\u63d0\u4ea4\u3002\n- \u65b0\u589e\u660e\u7ec6\u884c\u4e3a\u9875\u5185\u8ffd\u52a0\uff0c\u65e0\u9700\u4fdd\u5b58\u540e\u518d\u6dfb\u52a0\u3002\n- \u5355\u5f20\u62a5\u9500\u5355\u660e\u7ec6\u884c\u4e0a\u9650 50 \u6761\u3002\n\n**FR-1.4 \u91d1\u989d\u6c47\u603b**\n- \u63d0\u4ea4\u524d\u7cfb\u7edf\u81ea\u52a8\u8ba1\u7b97\u5404\u660e\u7ec6\u884c\u91d1\u989d\u4e4b\u548c\u4f5c\u4e3a\u62a5\u9500\u603b\u91d1\u989d\uff1b\u660e\u7ec6\u91d1\u989d\u53d8\u66f4\u65f6\u5b9e\u65f6\u5237\u65b0\u3002\n- \u5355\u884c\u91d1\u989d > 0\uff0c\u4fdd\u7559\u4e24\u4f4d\u5c0f\u6570\u3002\n\n**\u9a8c\u6536\u6807\u51c6**\n1. \u5458\u5de5\u53ef\u5728\u4e00\u5f20\u5355\u4e2d\u540c\u65f6\u586b\u5199\u6253\u8f66\u8d39\u3001\u9910\u8d39\u3001\u4f4f\u5bbf\u8d39\u5e76\u6210\u529f\u63d0\u4ea4\u3002\n2. \u5220\u9664\u6700\u540e\u4e00\u6761\u660e\u7ec6\u884c\u65f6\u63d0\u793a\"\u81f3\u5c11\u4fdd\u7559\u4e00\u6761\u8d39\u7528\u660e\u7ec6\"\u3002\n3. \u603b\u91d1\u989d\u4e0e\u660e\u7ec6\u6c42\u548c\u4e00\u81f4\uff0c\u65e0\u6d6e\u70b9\u8bef\u5dee\u3002\n\n### 4.2 \u53d1\u7968\u7167\u7247\u4e0a\u4f20\u4e0e\u67e5\u770b\uff08FR-2\uff09\n\n**FR-2.1 \u4e0a\u4f20**\n- \u6bcf\u6761\u8d39\u7528\u660e\u7ec6\u884c\u53ef\u4e0a\u4f20 1\u20139 \u5f20\u53d1\u7968\u7167\u7247\u3002\n- \u652f\u6301\u683c\u5f0f\uff1aJPG\u3001JPEG\u3001PNG\u3001HEIC\u3001PDF\uff1b\u5355\u6587\u4ef6\u5927\u5c0f \u2264 10MB\u3002\n- \u652f\u6301\u62cd\u7167\u4e0a\u4f20\uff08\u79fb\u52a8\u7aef\uff09\u4e0e\u672c\u5730\u6587\u4ef6\u9009\u62e9\uff08PC \u7aef\uff09\u3002\n\n**FR-2.2 \u9884\u89c8**\n- \u5458\u5de5\u5728\u586b\u62a5\u9875\u3001\u4e3b\u7ba1\u5728\u5ba1\u6279\u9875\u53ef\u70b9\u51fb\u56fe\u7247\u653e\u5927\u9884\u89c8\uff0c\u652f\u6301\u5de6\u53f3\u5207\u6362\u3001\u65cb\u8f6c\u3001\u7f29\u653e\u3002\n- \u5ba1\u6279\u8be6\u60c5\u9875\u6309\u660e\u7ec6\u884c\u5206\u7ec4\u5c55\u793a\u5bf9\u5e94\u53d1\u7968\uff0c\u70b9\u51fb\u660e\u7ec6\u884c\u53ef\u5feb\u901f\u5b9a\u4f4d\u5176\u53d1\u7968\u3002\n\n**FR-2.3 \u7f16\u8f91\u4e0e\u5220\u9664**\n- \u63d0\u4ea4\u524d\u5458\u5de5\u53ef\u589e\u5220\u660e\u7ec6\u884c\u5185\u7684\u7167\u7247\uff1b\u63d0\u4ea4\u540e\u7167\u7247\u53ea\u8bfb\uff0c\u9a73\u56de\u540e\u56de\u5230\u53ef\u7f16\u8f91\u72b6\u6001\u3002\n\n**FR-2.4 \u6743\u9650\u4e0e\u5b89\u5168**\n- \u53d1\u7968\u7167\u7247\u4ec5\u62a5\u9500\u5355\u5173\u8054\u4eba\uff08\u62a5\u9500\u4eba\u3001\u5ba1\u6279\u94fe\u4e0a\u7684\u4e3b\u7ba1\u3001\u8d22\u52a1\uff09\u53ef\u8bbf\u95ee\uff1b\u901a\u8fc7\u5e26\u9274\u6743\u7684\u4e34\u65f6 URL \u8bbf\u95ee\uff0c\u7981\u6b62\u672a\u6388\u6743\u76f4\u94fe\u3002\n\n**\u9a8c\u6536\u6807\u51c6**\n1. \u4e3b\u7ba1\u5ba1\u6279\u754c\u9762\u53ef\u76f4\u63a5\u770b\u5230\u6bcf\u6761\u660e\u7ec6\u7684\u53d1\u7968\u7167\u7247\u5e76\u653e\u5927\u67e5\u770b\u3002\n2. \u975e\u5173\u8054\u7528\u6237\u8bbf\u95ee\u7167\u7247 URL \u8fd4\u56de 403\u3002\n\n### 4.3 \u5ba1\u6279\u6d41\u7a0b\uff08FR-3\uff09\n\n**FR-3.1 \u6d41\u7a0b\u72b6\u6001**\n- \u72b6\u6001\u673a\uff1a\u8349\u7a3f \u2192 \u5f85\u5ba1\u6279 \u2192 \u5ba1\u6279\u4e2d\uff08\u9884\u7559\uff09\u2192 \u5df2\u901a\u8fc7 \u2192 \u5df2\u9a73\u56de / \u5df2\u64a4\u56de\u3002\n- \u5458\u5de5\u63d0\u4ea4\u540e\u8fdb\u5165\u90e8\u95e8\u4e3b\u7ba1\u5f85\u5ba1\u6279\uff1b\u4e3b\u7ba1\u53ef\u901a\u8fc7\u6216\u9a73\u56de\u3002\n- \u9a73\u56de\u5fc5\u987b\u586b\u5199\u9a73\u56de\u610f\u89c1\uff0c\u5355\u636e\u9000\u56de\u5458\u5de5\u53ef\u7f16\u8f91\u540e\u91cd\u65b0\u63d0\u4ea4\u3002\n- \u5458\u5de5\u53ef\u5728\"\u5f85\u5ba1\u6279\"\u72b6\u6001\u4e0b\u64a4\u56de\u4e3a\u8349\u7a3f\u3002\n\n**FR-3.2 \u5ba1\u6279\u754c\u9762**\n- \u5c55\u793a\u5355\u5934\u4fe1\u606f\u3001\u660e\u7ec6\u884c\u5217\u8868\uff08\u7c7b\u578b/\u91d1\u989d/\u65e5\u671f/\u5907\u6ce8\uff09\u3001\u603b\u91d1\u989d\u3001\u53d1\u7968\u7167\u7247\u3002\n- \u652f\u6301\u5bfc\u51fa\u5355\u5355\u660e\u7ec6\uff08\u53ef\u9009\uff0c\u975e\u672c\u6b21\u5f3a\u5236\u9879\uff09\u3002\n\n**\u9a8c\u6536\u6807\u51c6**\n1. \u9a73\u56de\u540e\u5458\u5de5\u6536\u5230\u901a\u77e5\uff0c\u53ef\u7f16\u8f91\u5e76\u91cd\u65b0\u63d0\u4ea4\u3002\n2. \u72b6\u6001\u6d41\u8f6c\u8bb0\u5f55\u64cd\u4f5c\u4eba\u3001\u65f6\u95f4\u3001\u610f\u89c1\uff0c\u53ef\u8ffd\u6eaf\u3002\n\n### 4.4 \u8d22\u52a1\u5bfc\u51fa\uff08FR-4\uff09\n\n**FR-4.1 \u67e5\u8be2\u6761\u4ef6**\n- \u652f\u6301\u6309\u4ee5\u4e0b\u7ec4\u5408\u6761\u4ef6\u7b5b\u9009\uff1a\u62a5\u9500\u671f\u95f4\uff08\u65e5\u671f\u8303\u56f4\uff09\u3001\u90e8\u95e8\u3001\u62a5\u9500\u4eba\u3001\u8d39\u7528\u7c7b\u578b\u3001\u5355\u636e\u72b6\u6001\u3001\u63d0\u4ea4\u65f6\u95f4\u8303\u56f4\u3002\n\n**FR-4.2 \u5bfc\u51fa\u5185\u5bb9**\n- \u683c\u5f0f\uff1aXLSX\u3002\n- \u7c92\u5ea6\uff1a\u6309\u8d39\u7528\u660e\u7ec6\u884c\u5bfc\u51fa\uff08\u4e00\u884c\u4e00\u6761\uff09\uff0c\u540c\u65f6\u5305\u542b\u5355\u5934\u5b57\u6bb5\u4ee5\u4fbf\u6c47\u603b\u3002\n- \u5b57\u6bb5\uff1a\u62a5\u9500\u5355\u53f7\u3001\u62a5\u9500\u4eba\u3001\u90e8\u95e8\u3001\u62a5\u9500\u4e8b\u7531\u3001\u8d39\u7528\u7c7b\u578b\u3001\u91d1\u989d\u3001\u53d1\u751f\u65e5\u671f\u3001\u5907\u6ce8\u3001\u5355\u636e\u72b6\u6001\u3001\u63d0\u4ea4\u65f6\u95f4\u3001\u5ba1\u6279\u5b8c\u6210\u65f6\u95f4\u3001\u5ba1\u6279\u4eba\u3001\u53d1\u7968\u5f20\u6570\u3002\n\n**FR-4.3 \u5bfc\u51fa\u9650\u5236**\n- \u5355\u6b21\u5bfc\u51fa\u4e0a\u9650 50,000 \u884c\uff1b\u8d85\u51fa\u65f6\u63d0\u793a\u7f29\u5c0f\u7b5b\u9009\u8303\u56f4\u3002\n- \u6570\u636e\u91cf\u8f83\u5927\u65f6\u91c7\u7528\u5f02\u6b65\u5bfc\u51fa\uff0c\u5b8c\u6210\u540e\u5728\u5bfc\u51fa\u4e2d\u5fc3\u4e0b\u8f7d\u5e76\u901a\u77e5\u3002\n\n**\u9a8c\u6536\u6807\u51c6**\n1. \u8d22\u52a1\u53ef\u6309\u90e8\u95e8+\u6708\u4efd\u5bfc\u51fa XLSX\uff0c\u884c\u6570\u636e\u4e0e\u7cfb\u7edf\u5185\u660e\u7ec6\u4e00\u81f4\u3002\n2. \u5bfc\u51fa\u6587\u4ef6\u53ef\u6b63\u5e38\u6253\u5f00\uff0c\u91d1\u989d\u5b57\u6bb5\u4e3a\u6570\u503c\u7c7b\u578b\u800c\u975e\u6587\u672c\u3002\n\n### 4.5 \u5386\u53f2\u6570\u636e\u517c\u5bb9\uff08FR-5\uff09\n\n**FR-5.1 \u6570\u636e\u8fc1\u79fb**\n- \u5b58\u91cf\u5355\u8d39\u7528\u7c7b\u578b\u7684\u62a5\u9500\u5355\u8fc1\u79fb\u4e3a\u300c1 \u6761\u660e\u7ec6\u884c\u300d\u7684\u65b0\u7ed3\u6784\uff1b\u539f\u5355\u5b57\u6bb5\u6309\u6620\u5c04\u89c4\u5219\u586b\u5145\uff0c\u65e0\u6cd5\u6620\u5c04\u5b57\u6bb5\u4fdd\u7559\u4e8e\u6269\u5c55\u5b57\u6bb5\u3002\n- \u8fc1\u79fb\u5728\u7070\u5ea6\u671f\u95f4\u53ef\u56de\u6eda\u3002\n\n**FR-5.2 \u67e5\u770b\u517c\u5bb9**\n- \u5386\u53f2\u62a5\u9500\u5355\u5728\u65b0\u754c\u9762\u4e0b\u6309\u5355\u660e\u7ec6\u6a21\u5f0f\u6b63\u5e38\u5c55\u793a\uff0c\u5ba1\u6279\u8bb0\u5f55\u3001\u9644\u4ef6\u4e0d\u4e22\u5931\u3002\n- \u5386\u53f2\u5355\u636e\u4e0d\u5141\u8bb8\u7f16\u8f91\uff0c\u4ec5\u53ef\u67e5\u770b\u4e0e\u5bfc\u51fa\u3002\n\n**\u9a8c\u6536\u6807\u51c6**\n1. \u8fc1\u79fb\u540e\u5386\u53f2\u5355\u636e\u5217\u8868\u53ef\u6253\u5f00\u3001\u91d1\u989d\u4e0e\u65e7\u7cfb\u7edf\u4e00\u81f4\u3002\n2. \u8d22\u52a1\u5bfc\u51fa\u5305\u542b\u5386\u53f2\u5355\u636e\u6570\u636e\u3002\n\n---\n\n## 5. \u975e\u529f\u80fd\u9700\u6c42\n\n| \u7f16\u53f7 | \u9700\u6c42 |\n| --- | --- |\n| NFR-1 | \u586b\u62a5\u9875\u9996\u5c4f\u52a0\u8f7d \u2264 2s\uff1b\u5ba1\u6279\u8be6\u60c5\u52a0\u8f7d\uff08\u542b\u7f29\u7565\u56fe\uff09\u2264 3s |\n| NFR-2 | \u7167\u7247\u4e0a\u4f20\u652f\u6301\u65ad\u70b9/\u5931\u8d25\u91cd\u8bd5\uff1b\u4e0a\u4f20\u63a5\u53e3 P95 \u2264 5s\uff0810MB \u5185\uff09 |\n| NFR-3 | \u5e76\u53d1\uff1a\u652f\u6301 500 \u4eba\u540c\u65f6\u5728\u7ebf\u586b\u62a5\uff0c\u6708\u672b\u5ba1\u6279\u9ad8\u5cf0\u4e0d\u964d\u7ea7 |\n| NFR-4 | \u9644\u4ef6\u5b58\u50a8\u4f7f\u7528\u5bf9\u8c61\u5b58\u50a8\uff0c\u4fdd\u7559\u671f \u2265 5 \u5e74\uff0c\u9700\u652f\u6301\u5907\u4efd |\n| NFR-5 | \u517c\u5bb9 Chrome/Edge \u6700\u65b0\u4e24\u4e2a\u5927\u7248\u672c\uff0c\u79fb\u52a8\u7aef iOS/Android App \u5f53\u524d\u7248\u672c |\n| NFR-6 | \u64cd\u4f5c\u65e5\u5fd7\u5b8c\u6574\u8bb0\u5f55\u63d0\u4ea4/\u5ba1\u6279/\u5bfc\u51fa\u884c\u4e3a\uff0c\u6ee1\u8db3\u5ba1\u8ba1\u8981\u6c42 |\n\n---\n\n## 6. \u6570\u636e\u6a21\u578b\uff08\u6982\u8981\uff09\n\n- `expense_report`\uff08\u62a5\u9500\u5355\uff09\uff1aid\u3001user_id\u3001dept_id\u3001title\u3001period_start\u3001period_end\u3001total_amount\u3001status\u3001created_at\u3001updated_at\n- `expense_item`\uff08\u8d39\u7528\u660e\u7ec6\uff09\uff1aid\u3001report_id\u3001expense_type\u3001amount\u3001happen_date\u3001remark\n- `expense_attachment`\uff08\u53d1\u7968\u9644\u4ef6\uff09\uff1aid\u3001item_id\u3001file_key\u3001file_type\u3001file_size\u3001uploaded_at\n- `expense_type_config`\uff08\u7c7b\u578b\u5b57\u5178\uff09\uff1acode\u3001name\u3001enabled\u3001sort\n- `approval_record`\uff08\u5ba1\u6279\u8bb0\u5f55\uff09\uff1aid\u3001report_id\u3001approver_id\u3001action\u3001comment\u3001created_at\n\n> \u8fc1\u79fb\u6620\u5c04\uff1a\u65e7\u8868 `amount/expense_type/invoice_file` \u2192 \u65b0\u8868\u5bf9\u5e94\u751f\u6210 1 \u6761 `expense_item` \u4e0e\u82e5\u5e72 `expense_attachment`\u3002\n\n---\n\n## 7. \u754c\u9762\u6539\u9020\u70b9\n\n1. \u586b\u62a5\u9875\uff1a\u65b0\u589e\u300c\u8d39\u7528\u660e\u7ec6\u300d\u53ef\u589e\u5220\u8868\u683c\u533a\uff1b\u6bcf\u884c\u542b\u53d1\u7968\u4e0a\u4f20\u7f29\u7565\u56fe\u3002\n2. \u5ba1\u6279\u8be6\u60c5\u9875\uff1a\u65b0\u589e\u660e\u7ec6\u8868\u683c + \u53d1\u7968\u753b\u5eca\u533a\u57df\u3002\n3. \u8d22\u52a1\u4e2d\u5fc3\uff1a\u65b0\u589e\u300c\u62a5\u9500\u5bfc\u51fa\u300d\u9875\u9762\uff0c\u542b\u7b5b\u9009\u5668\u4e0e\u5f02\u6b65\u5bfc\u51fa\u4efb\u52a1\u5217\u8868\u3002\n4. \u5386\u53f2\u5355\u636e\u67e5\u770b\u9875\uff1a\u7edf\u4e00\u8d70\u65b0\u8be6\u60c5\u7ec4\u4ef6\uff0c\u517c\u5bb9\u65e7\u6570\u636e\u6e32\u67d3\u3002\n\n---\n\n## 8. \u8303\u56f4\u5916\uff08Out of Scope\uff09\n\n- \u4e0e\u5916\u90e8\u8d22\u52a1/ERP \u7cfb\u7edf\u7684\u81ea\u52a8\u5bf9\u63a5\u3002\n- OCR \u81ea\u52a8\u8bc6\u522b\u53d1\u7968\u91d1\u989d\u4e0e\u771f\u4f2a\u6821\u9a8c\u3002\n- \u591a\u7ea7/\u81ea\u5b9a\u4e49\u5ba1\u6279\u6d41\u5f15\u64ce\u6539\u902