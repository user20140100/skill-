c\u91cd\u65b0\u7f16\u8f91\u540e\u63d0\u4ea4 | P2 |\n\n### 5.4 \u8d22\u52a1\u5bfc\u51fa\uff08FR-04\uff09\n\n| \u7f16\u53f7 | \u9700\u6c42\u63cf\u8ff0 | \u4f18\u5148\u7ea7 |\n| --- | --- | --- |\n| FR-04-1 | \u8d22\u52a1\u7aef\u63d0\u4f9b\u62a5\u9500\u6570\u636e\u67e5\u8be2\u9875\uff0c\u7b5b\u9009\u6761\u4ef6\uff1a\u63d0\u4ea4\u65e5\u671f\u533a\u95f4\u3001\u62a5\u9500\u4eba\u3001\u90e8\u95e8\u3001\u8d39\u7528\u7c7b\u578b\u3001\u5355\u636e\u72b6\u6001 | P0 |\n| FR-04-2 | \u652f\u6301\u6309\u67e5\u8be2\u6761\u4ef6\u5bfc\u51fa Excel\uff08.xlsx\uff09\uff0c\u5bfc\u51fa\u7c92\u5ea6\u4e3a\u300c\u8d39\u7528\u660e\u7ec6\u884c\u300d\uff0c\u6bcf\u884c\u5305\u542b\uff1a\u5355\u636e\u7f16\u53f7\u3001\u62a5\u9500\u4eba\u3001\u90e8\u95e8\u3001\u4e8b\u7531\u3001\u63d0\u4ea4\u65f6\u95f4\u3001\u5ba1\u6279\u72b6\u6001\u3001\u5ba1\u6279\u4eba\u3001\u5ba1\u6279\u65f6\u95f4\u3001\u8d39\u7528\u7c7b\u578b\u3001\u8d39\u7528\u65e5\u671f\u3001\u91d1\u989d\u3001\u53d1\u7968\u5f20\u6570\u3001\u5408\u8ba1 | P0 |\n| FR-04-3 | \u652f\u6301\u52fe\u9009\u6307\u5b9a\u5355\u636e\u5bfc\u51fa\u6216\u5168\u91cf\u6309\u6761\u4ef6\u5bfc\u51fa\uff1b\u5355\u6b21\u5bfc\u51fa\u4e0a\u9650 10,000 \u884c\uff0c\u8d85\u9650\u7ed9\u51fa\u63d0\u793a\u5e76\u5efa\u8bae\u7f29\u5c0f\u8303\u56f4 | P1 |\n| FR-04-4 | \u5bfc\u51fa\u6570\u636e\u4ee5\u5ba1\u6279\u901a\u8fc7\uff08\u53ef\u901a\u8fc7\u72b6\u6001\u7b5b\u9009\u5305\u542b\u5176\u4ed6\u72b6\u6001\uff09\u7684\u6700\u65b0\u7248\u672c\u4e3a\u51c6\uff0c\u91d1\u989d\u4e0e\u5355\u636e\u9875\u5c55\u793a\u4e00\u81f4 | P0 |\n\n### 5.5 \u5386\u53f2\u6570\u636e\u517c\u5bb9\uff08FR-05\uff09\n\n| \u7f16\u53f7 | \u9700\u6c42\u63cf\u8ff0 | \u4f18\u5148\u7ea7 |\n| --- | --- | --- |\n| FR-05-1 | \u5386\u53f2\u5355\u636e\uff08\u5355\u8d39\u7528\u7c7b\u578b\uff09\u8fc1\u79fb/\u6620\u5c04\u4e3a\u300c1 \u6761\u660e\u7ec6\u300d\u7684\u65b0\u7ed3\u6784\uff0c\u5386\u53f2\u5217\u8868\u4e0e\u8be6\u60c5\u9875\u53ef\u6b63\u5e38\u67e5\u770b\uff0c\u5c55\u793a\u5185\u5bb9\u4e0d\u53d8 | P0 |\n| FR-05-2 | \u5386\u53f2\u5355\u636e\u4e3a\u53ea\u8bfb\uff0c\u4e0d\u53ef\u7f16\u8f91\u3001\u4e0d\u53ef\u91cd\u65b0\u63d0\u4ea4 | P0 |\n| FR-05-3 | \u5386\u53f2\u5355\u636e\u7eb3\u5165\u8d22\u52a1\u5bfc\u51fa\u8303\u56f4\uff0c\u7f3a\u5931\u5b57\u6bb5\uff08\u5982\u53d1\u7968\u5f20\u6570\uff09\u4ee5\u7a7a/0 \u5904\u7406\uff0c\u4e0d\u963b\u65ad\u5bfc\u51fa | P1 |\n| FR-05-4 | \u8fc1\u79fb\u9700\u6709\u56de\u6eda\u65b9\u6848\uff0c\u4e0a\u7ebf\u524d\u5728\u9884\u53d1\u5e03\u73af\u5883\u5b8c\u6210\u5168\u91cf\u6570\u636e\u6821\u9a8c\uff08\u5355\u636e\u6570\u3001\u91d1\u989d\u5408\u8ba1\u4e00\u81f4\uff09 | P0 |\n\n## 6. \u975e\u529f\u80fd\u9700\u6c42\n\n| \u7c7b\u522b | \u8981\u6c42 |\n| --- | --- |\n| \u6027\u80fd | \u5355\u636e\u4fdd\u5b58/\u63d0\u4ea4\u54cd\u5e94 \u2264 2s\uff1b10 \u5f20\u4ee5\u5185\u53d1\u7968\u4e0a\u4f20\u603b\u65f6\u957f \u2264 15s\uff08\u6b63\u5e38\u7f51\u7edc\uff09\uff1b\u5bfc\u51fa 10,000 \u884c \u2264 60s\uff0c\u53ef\u91c7\u7528\u5f02\u6b65\u5bfc\u51fa+\u4e0b\u8f7d\u901a\u77e5 |\n| \u5b58\u50a8 | \u53d1\u7968\u6587\u4ef6\u5b58\u5bf9\u8c61\u5b58\u50a8\uff08OSS/COS/S3 \u7b49\uff09\uff0c\u6570\u636e\u5e93\u4ec5\u5b58\u5143\u6570\u636e\u4e0e\u8bbf\u95ee\u5730\u5740\uff1b\u9884\u7559\u5e74\u589e \u2265 500GB \u6269\u5c55\u80fd\u529b |\n| \u5b89\u5168 | \u6587\u4ef6\u7c7b\u578b\u767d\u540d\u5355\u6821\u9a8c + \u5185\u5bb9\u6821\u9a8c\uff0c\u9632\u4f2a\u88c5\u6269\u5c55\u540d\uff1b\u4e0b\u8f7d\u94fe\u63a5\u4f7f\u7528\u5e26\u6709\u6548\u671f\u7684\u7b7e\u540d URL\uff1b\u64cd\u4f5c\u65e5\u5fd7\u7559\u75d5\uff08\u63d0\u4ea4\u3001\u5ba1\u6279\u3001\u5bfc\u51fa\u3001\u5220\u9664\uff09 |\n| \u6743\u9650 | \u4e25\u683c\u6309\u89d2\u8272\u63a7\u5236\u53ef\u89c1\u4e0e\u53ef\u64cd\u4f5c\u8303\u56f4\uff1b\u5bfc\u51fa\u64cd\u4f5c\u8bb0\u5f55\u64cd\u4f5c\u4eba\u4e0e\u7b5b\u9009\u6761\u4ef6 |\n| \u517c\u5bb9\u6027 | \u517c\u5bb9 Chrome/Edge \u6700\u65b0\u4e24\u4e2a\u5927\u7248\u672c\uff1b\u5982\u73b0\u6709\u7cfb\u7edf\u542b\u79fb\u52a8\u7aef\uff0c\u9700\u540c\u6b65\u9002\u91