n\n| \u5b57\u6bb5 | \u7c7b\u578b | \u5fc5\u586b | \u6821\u9a8c\u89c4\u5219 |\n| --- | --- | --- | --- |\n| \u52a0\u73ed\u65e5\u671f | \u65e5\u671f | \u662f | \u4e0d\u5f97\u665a\u4e8e\u5f53\u65e5\u53ef\u63d0\u4ea4\u8303\u56f4\u4e0a\u9650\uff08\u652f\u6301\u5f53\u65e5\u53ca\u4e4b\u524d\uff0c\u5177\u4f53\u4ee5\u914d\u7f6e\u4e3a\u51c6\uff09\uff1b\u4e0d\u5f97\u65e9\u4e8e\u7cfb\u7edf\u5141\u8bb8\u7684\u5386\u53f2\u8303\u56f4 |\n| \u5f00\u59cb\u65f6\u95f4 | \u65f6\u95f4 | \u662f | \u65f6:\u5206\uff0c24 \u5c0f\u65f6\u5236 |\n| \u7ed3\u675f\u65f6\u95f4 | \u65f6\u95f4 | \u662f | \u5fc5\u987b\u665a\u4e8e\u5f00\u59cb\u65f6\u95f4\uff1b\u652f\u6301\u8de8\u5929\uff08\u7ed3\u675f\u65f6\u95f4\u843d\u5728\u6b21\u65e5\uff09 |\n| \u52a0\u73ed\u4e8b\u7531 | \u6587\u672c | \u5426 | \u4e0d\u8d85\u8fc7 200 \u5b57\uff0c\u8d85\u51fa\u65f6\u7981\u6b62\u63d0\u4ea4\u5e76\u63d0\u793a |\n| \u52a0\u73ed\u65f6\u957f | \u6570\u503c | \u2014 | \u7cfb\u7edf\u6839\u636e\u8d77\u6b62\u65f6\u95f4\u81ea\u52a8\u8ba1\u7b97\uff0c\u53ea\u8bfb\uff0c\u4e0d\u53ef\u624b\u5de5\u4fee\u6539 |\n\n#### 3.1.2 \u4e1a\u52a1\u89c4\u5219\n1. **\u65f6\u957f\u8ba1\u7b97**\uff1a\u52a0\u73ed\u65f6\u957f = \u7ed3\u675f\u65f6\u95f4 \u2212 \u5f00\u59cb\u65f6\u95f4\uff0c\u5355\u4f4d\u5c0f\u65f6\uff0c\u4fdd\u7559 1 \u4f4d\u5c0f\u6570\uff1b\u8de8\u5929\u573a\u666f\u6309 24:00 \u62c6\u5206\u7d2f\u52a0\uff1b\n2. **\u6cd5\u5b9a\u8282\u5047\u65e5\u81ea\u52a8\u6807\u8bb0**\uff1a\u63d0\u4ea4\u65f6\u7cfb\u7edf\u4f9d\u636e\u8282\u5047\u65e5\u65e5\u5386\u5224\u65ad\u52a0\u73ed\u65e5\u671f\u662f\u5426\u4e3a\u6cd5\u5b9a\u8282\u5047\u65e5\uff0c\u82e5\u662f\u5219\u81ea\u52a8\u6253\u4e0a\u300c\u6cd5\u5b9a\u8282\u5047\u65e5\u300d\u6807\u7b7e\uff0c\u5458\u5de5\u4e0d\u53ef\u624b\u5de5\u6dfb\u52a0\u6216\u79fb\u9664\uff1b\n3. **\u91cd\u590d\u63d0\u4ea4\u6821\u9a8c**\uff1a\u540c\u4e00\u5458\u5de5\u540c\u4e00\u65e5\u671f\u5b58\u5728\u300c\u5f85\u5ba1\u6279/\u5df2\u901a\u8fc7\u300d\u8bb0\u5f55\u65f6\uff0c\u518d\u6b21\u63d0\u4ea4\u9700\u7ed9\u51fa\u91cd\u590d\u63d0\u9192\uff0c\u7531\u5458\u5de5\u786e\u8ba4\u540e\u51b3\u5b9a\u662f\u5426\u7ee7\u7eed\uff1b\n4. **\u64a4\u56de**\uff1a\u72b6\u6001\u4e3a\u300c\u5f85\u5ba1\u6279\u300d\u4e14\u5c1a\u65e0\u5ba1\u6279\u4eba\u5904\u7406\u65f6\uff0c\u5458\u5de5\u53ef\u64a4\u56de\u7533\u8bf7\uff0c\u64a4\u56de\u540e\u72b6\u6001\u53d8\u4e3a\u300c\u5df2\u64a4\u56de\u300d\uff0c\u53ef\u7f16\u8f91\u540e\u91cd\u65b0\u63d0\u4ea4\u3002\n\n#### 3.1.3 \u9a8c\u6536\u8981\u70b9\n- \u8d77\u6b62\u65f6\u95f4\u5012\u6302\u3001\u7ed3\u675f\u65f6\u95f4\u7b49\u4e8e\u5f00\u59cb\u65f6\u95f4\u65f6\u65e0\u6cd5\u63d0\u4ea4\uff1b\n- \u4e8b\u7531 201 \u5b57\u65f6\u88ab\u62e6\u622a\uff1b\n- \u65f6\u957f\u4e0e\u4eba\u5de5\u8ba1\u7b97\u7ed3\u679c\u4e00\u81f4\uff0c\u8de8\u5929\u7528\u4f8b\u6b63\u786e\uff1b\n- \u6cd5\u5b9a\u8282\u5047\u65e5\u65e5\u671f\u63d0\u4ea4\u540e\u5217\u8868\u4e0e\u8be6\u60c5\u6b63\u786e\u663e\u793a\u6807\u7b7e\u3002\n\n### 3.2 \u5ba1\u6279\u6d41\u7a0b\n\n**\u529f\u80fd\u7f16\u53f7\uff1aF-02**\n\n#### 3.2.1 \u6d41\u7a0b\u56fe\n\n```mermaid\ngraph TD\n    A[\u5458\u5de5\u63d0\u4ea4\u7533\u8bf7] --> B{\u65f6\u957f > 4 \u5c0f\u65f6?}\n    B -- \u5426 --> C[\u90e8\u95e8\u4e3b\u7ba1\u5ba1\u6279]\n    B -- \u662f --> C\n    C --> D{\u4e3b\u7ba1\u7ed3\u679c}\n    D -- \u9a73\u56de --> G[\u5df2\u9a73\u56de: \u9700\u586b\u5199\u9a73\u56de\u539f\u56e0]\n    D -- \u540c\u610f --> E{\u65f6\u957f > 4 \u5c0f\u65f6?}\n    E -- \u5426 --> F[\u5df2\u901a\u8fc7]\n    E -- \u662f --> H[\u90e8\u95e8\u603b\u76d1\u5ba1\u6279]\n    H --> I{\u603b\u76d1\u7ed3\u679c}\n    I -- \u9a73\u56de --> G\n    I -- \u540c\u610f --> F\n```\n\n#### 3.2.2 \u6d41\u8f6c\u89c4\u5219\n1. \u63d0\u4ea4\u540e\u6309\u52a0\u73ed\u65e5\u671f\u5f52\u5c5e\u7684\u5458\u5de5\u6240\u5728\u90e8\u95e8\uff0c\u81ea\u52a8\u8def\u7531\u81f3\u8be5\u90e8\u95e8\u4e3b\u7ba1\uff1b\n2. **\u5355\u7ea7\u5ba1\u6279**\uff1a\u65f6\u957f \u2264 4 \u5c0f\u65f6\uff0c\u4ec5\u9700\u90e8\u95e8\u4e3b\u7ba1\u5ba1\u6279\uff1b\n3. **\u591a\u7ea7\u5ba1\u6279**\uff1a\u65f6\u957f > 4 \u5c0f\u65f6\uff0c\u90e8\u95e8\u4e3b\u7ba1\u540c\u610f\u540e\u81ea\u52a8\u6d41\u8f6c\u81f3\u90e8\u95e8\u603b\u76d1\u4e8c\u6b21\u5ba1\u6279\uff0c\u603b\u76d1\u540c\u610f\u540e\u7f6e\u4e3a\u300c\u5df2\u901a\u8fc7\u300d\uff1b\n4. \u4efb\u4e00\u5ba1\u6279\u73af\u8282**\u9a73\u56de\u5373\u7ec8\u6b62**\uff0c\u72b6\u6001\u7f6e\u4e3a\u300c\u5df2\u9a73\u56de\u300d\uff0c\u9a73\u56de\u539f\u56e0\u5fc5\u586b\uff1b\n5. \u9a73\u56de\u540e\u7684\u7533\u8bf7\u5141\u8bb8\u5458\u5de5\u4fee\u6539\u540e\u91cd\u65b0\u63d0\u4ea4\uff0c\u91cd\u65b0\u8d70\u5b8c\u6574\u5ba1\u6279\u94fe\uff1b\n6. \u6cd5\u5b9a\u8282\u5047\u65e5\u6807\u8bb0\u4e0d\u6539\u53d8\u5ba1\u6279\u94fe\u8def\uff0c\u4ec5\u4f5c\u4e3a\u6807\u7b7e\u4f9b\u5ba1\u6279\u4eba\u4e0e HR \u8bc6\u522b\uff1b\n7. \u5ba1\u6279\u4eba\u53d8\u66f4\uff08\u79bb\u804c/\u8c03\u5c97\uff09\u65f6\uff0c\u5f85\u529e\u7531\u7cfb\u7edf\u8f6c\u4ea4\u81f3\u5176\u7ee7\u4efb\u4e3b\u7ba1\uff0c\u65e0\u7ee7\u4efb\u65f6\u4e0a\u62a5 HR \u4eba\u5de5\u6307\u6d3e\uff08\u53ef\u4f5c\u4e3a\u4e8c\u671f\u80fd\u529b\uff0c\u672c\u671f\u5148\u652f\u6301 HR \u624b\u52a8\u6539\u6d3e\u5e76\u7559\u75d5\uff09\u3002\n\n#### 3.2.3 \u901a\u77e5\u89c4\u5219\n1. \u6d41\u8f6c\u5230\u5ba1\u6279\u8282\u70b9\u65f6\uff0c\u7ad9\u5185\u4fe1\u901a\u77e5\u5f53\u524d\u5ba1\u6279\u4eba\uff08\u53ef\u6269\u5c55\u90ae\u4ef6/\u4f01\u4e1a IM\uff0c\u5f85\u786e\u8ba4\uff09\uff1b\n2. \u5ba1\u6279\u7ed3\u675f\uff08\u901a\u8fc7/\u9a73\u56de\uff09\u65f6\u901a\u77e5\u7533\u8bf7\u5458\u5de5\uff0c\u9a73\u56de\u901a\u77e5\u5305\u542b\u9a73\u56de\u4eba\u4e0e\u539f\u56e0\uff1b\n3. \u5f85\u529e\u8d85\u8fc7 N \u4e2a\u5de5\u4f5c\u65e5\uff08\u9ed8\u8ba4 3\uff0c\u53ef\u914d\u7f6e\uff09\u672a\u5904\u7406\uff0c\u5411\u5ba1\u6279\u4eba\u53d1\u9001\u50ac\u529e\u63d0\u9192\u3002\n\n#### 3.2.4 \u9a8c\u6536\u8981\u70b9\n- 3.5 \u5c0f\u65f6\u4e0e 4.5 \u5c0f\u65f6\u5206\u522b\u547d\u4e2d\u5355\u7ea7/\u4e24\u7ea7\u5ba1\u6279\u8def\u5f84\uff1b\n- \u4e3b\u7ba1\u9a73\u56de\u65f6\u4e0d\u586b\u539f\u56e0\u65e0\u6cd5\u63d0\u4ea4\u9a73\u56de\u64cd\u4f5c\uff1b\n- \u9a73\u56de\u540e\u91cd\u65b0\u63d0\u4ea4\uff0c\u5ba1\u6279\u65e5\u5fd7\u4fdd\u7559\u5b8c\u6574\u5386\u53f2\u8bb0\u5f55\uff1b\n- \u5ba1\u6279\u72b6\u6001\u4e0e\u5217\u8868\u72b6\u6001\u5b9e\u65f6\u4e00\u81f4\u3002\n\n### 3.3 \u5217\u8868\u4e0e\u67e5\u8be2\n\n**\u529f\u80fd\u7f16\u53f7\uff1aF-03**\n\n#### 3.3.1 \u5458\u5de5\u7aef\u5217\u8868\n1. \u5c55\u793a\u5b57\u6bb5\uff1a\u52a0\u73ed\u65e5\u671f\u3001\u52a0\u73ed\u65f6\u957f\u3001\u52a0\u73ed\u4e8b\u7531\u3001\u72b6\u6001\u3001\u6cd5\u5b9a\u8282\u5047\u65e5\u6807\u8bb0\u3001\u63d0\u4ea4\u65f6\u95f4\uff1b\n2. \u72b6\u6001\u679a\u4e3e\uff1a`\u5f85\u5ba1\u6279`\u3001`\u5df2\u901a\u8fc7`\u3001`\u5df2\u9a73\u56de`\uff08\u672c\u671f\u542b `\u5df2\u64a4\u56de`\uff0c\u9700\u5728\u7b5b\u9009\u4e0e\u5c55\u793a\u4e2d\u4f53\u73b0\uff09\uff1b\n3. \u7b5b\u9009\u6761\u4ef6\uff1a\u6309\u72b6\u6001\u7b5b\u9009\u3001\u6309\u6708\u4efd\u7b5b\u9009\uff1b\n4. \u9ed8\u8ba4\u6309\u63d0\u4ea4\u65f6\u95f4\u5012\u5e8f\uff0c\u5206\u9875\u5c55\u793a\uff08\u9ed8\u8ba4\u6bcf\u9875 20 \u6761\uff09\uff1b\n5. \u884c\u5185\u64cd\u4f5c\uff1a\u67e5\u770b\u8be6\u60c5\uff1b\u5f85\u5ba1\u6279\u53ef\u64a4\u56de\uff1b\u5df2\u9a73\u56de/\u5df2\u64a4\u56de\u53ef\u7f16\u8f91\u91cd\u63d0\u3002\n\n#### 3.3.2 \u90e8\u95e8\u4e3b\u7ba1\u7aef\n1. \u5c55\u793a\u672c\u90e8\u95e8\u5168\u90e8\u7533\u8bf7\uff0c\u9ed8\u8ba4\u7b5b\u9009\u300c\u5f85\u5ba1\u6279\u300d\uff0c\u652f\u6301\u6309\u72b6\u6001\u3001\u6708\u4efd\u3001\u5458\u5de5\u59d3\u540d\u7b5b\u9009\uff1b\n2. \u652f\u6301\u5217\u8868\u5185\u5feb\u6377\u8fdb\u5165\u5ba1\u6279\u8be6\u60c5\u9875\u5b8c\u6210\u540c\u610f/\u9a73\u56de\u3002\n\n#### 3.3.3 HR \u7aef\n1. \u53ef\u67e5\u770b\u5168\u516c\u53f8\u7533\u8bf7\u5217\u8868\uff0c\u7b5b\u9009\u7ef4\u5ea6\uff1a\u90e8\u95e8\u3001\u5458\u5de5\u3001\u72b6\u6001\u3001\u6708\u4efd\u3001\u662f\u5426\u6cd5\u5b9a\u8282\u5047\u65e5\uff1b\n2. **\u6309\u6708\u5bfc\u51fa\u6c47\u603b**\uff1a\u9009\u62e9\u6708\u4efd\u540e\u5bfc\u51fa Excel\uff0c\u5185\u5bb9\u5305\u542b\u5458\u5de5\u59d3\u540d\u3001\u90e8\u95e8\u3001\u65e5\u671f\u3001\u65f6\u957f\u3001\u662f\u5426\u6cd5\u5b9a\u8282\u5047\u65e5\u3001\u72b6\u6001\u3001\u5ba1\u6279\u4eba\u3001\u5ba1\u6279\u5b8c\u6210\u65f6\u95f4\uff1b\n3. \u5bfc\u51fa\u540c\u65f6\u7ed9\u51fa\u6c47\u603b\u533a\uff1a\u6309\u90e8\u95e8\u7edf\u8ba1\u603b\u65f6\u957f\u3001\u6309\u4eba\u7edf\u8ba1\u603b\u65f6\u957f\u3002\n\n### 3.4 \u5ba1\u6279\u7559\u75d5\n\n**\u529f\u80fd\u7f16\u53f7\uff1aF-04**\n\n1. \u6bcf\u6761\u7533\u8bf7\u8bb0\u5f55\u5b8c\u6574\u64cd\u4f5c\u65e5\u5fd7\uff1a\u63d0\u4ea4\u3001\u4fee\u6539\u3001\u64a4\u56de\u3001\u540c\u610f\u3001\u9a73\u56de\uff0c\u542b\u64cd\u4f5c\u4eba\u3001\u64cd\u4f5c\u65f6\u95f4\u3001\u5ba1\u6279\u610f\u89c1/\u9a73\u56de\u539f\u56e0\uff1b\n2. \u65e5\u5fd7\u5728\u8be6\u60c5\u9875\u6309\u65f6\u95f4\u8f74\u5c55\u793a\uff0c\u4efb\u4f55\u89d2\u8272\uff08\u6709\u67e5\u770b\u6743\u9650\u8005\uff09\u5747\u53ef\u89c1\uff0c\u4e14\u4e0d\u53ef\u7f16\u8f91\u6216\u5220\u9664\u3002\n\n---\n\n## 4. \u6570\u636e\u5b57\u5178\uff08\u5173\u952e\u5b57\u6bb5\uff09\n\n| \u5b57\u6bb5 | \u7c7b\u578b | \u8bf4\u660e |\n| --- | --- | --- |\n| overtime_date | date | \u52a0\u73ed\u65e5\u671f |\n| start_time / end_time | time | \u8d77\u6b62\u65f6\u95f4\uff0c\u652f\u6301\u8de8\u5929 |\n| duration_hours | decimal(4,1) | \u7cfb\u7edf\u8ba1\u7b97\u7684\u52a0\u73ed\u65f6\u957f |\n| reason | varchar(200) | \u52a0\u73ed\u4e8b\u7531\uff0c\u9009\u586b |\n| status | enum | \u5f85\u5ba1\u6279 / \u5df2\u901a\u8fc7 / \u5df2\u9a73\u56de / \u5df2\u64a4\u56de |\n| is_holiday | bool | \u662f\u5426\u6cd5\u5b9a\u8282\u5047\u65e5\uff0c\u7cfb\u7edf\u6807\u8bb0 |\n| current_approver | user | \u5f53\u524d\u5f85\u5904\u7406\u5ba1\u6279\u4eba |\n\n---\n\n## 5. \u975e\u529f\u80fd\u9700\u6c42\n\n| \u7c7b\u522b | \u8981\u6c42 |\n| --- | --- |\n| \u6743\u9650\u5b89\u5168 | \u540e\u7aef\u5f3a\u5236\u6570\u636e\u6743\u9650\u6821\u9a8c\uff1b\u64cd\u4f5c\u65e5\u5fd7\u4e0d\u53ef\u7be1\