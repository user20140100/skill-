  \u2502 \u5426                          \u2502 \u662f\n   \u25bc                             \u25bc\n[\u5f85\u4e3b\u7ba1\u5ba1\u6279] \u2500\u2500\u540c\u610f\u2500\u2500\u25ba [\u5f85\u603b\u76d1\u5ba1\u6279] \u2500\u2500\u540c\u610f\u2500\u2500\u25ba [\u5df2\u901a\u8fc7]\n   \u2502                        \u2502\n   \u2502 \u9a73\u56de(\u5fc5\u586b\u539f\u56e0)          \u2502 \u9a73\u56de(\u5fc5\u586b\u539f\u56e0)\n   \u25bc                        \u25bc\n[\u5df2\u9a73\u56de] \u25c4\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\n   \u2502\n   \u25bc\n\u5458\u5de5\u53ef\u7f16\u8f91\u540e\u91cd\u65b0\u63d0\u4ea4\uff08\u56de\u5230\u300c\u5f85\u4e3b\u7ba1\u5ba1\u6279\u300d\uff09\n```\n\n**\u72b6\u6001\u5b9a\u4e49**\n\n| \u72b6\u6001 | \u542b\u4e49 | \u662f\u5426\u7ec8\u6001 |\n| --- | --- | --- |\n| \u5f85\u5ba1\u6279 | \u5df2\u63d0\u4ea4\uff0c\u6d41\u7a0b\u672a\u8d70\u5b8c\uff08\u542b\u4e3b\u7ba1\u8282\u70b9\u4e0e\u603b\u76d1\u8282\u70b9\uff0c\u7528\u300c\u5f53\u524d\u8282\u70b9\u300d\u5b57\u6bb5\u533a\u5206\uff09 | \u5426 |\n| \u5df2\u901a\u8fc7 | \u5168\u90e8\u5fc5\u8981\u8282\u70b9\u5ba1\u6279\u901a\u8fc7 | \u662f |\n| \u5df2\u9a73\u56de | \u4efb\u4e00\u8282\u70b9\u88ab\u9a73\u56de | \u5426\uff08\u53ef\u4fee\u6539\u540e\u91cd\u63d0\uff09 |\n\n**\u4e1a\u52a1\u89c4\u5219**\n\n- BR-201\uff1a\u9a73\u56de\u65f6**\u5ba1\u6279\u610f\u89c1\uff08\u539f\u56e0\uff09\u5fc5\u586b**\uff0c\u957f\u5ea6 1\u2013500 \u5b57\uff1b\u4e3a\u7a7a\u65f6\u63d0\u4ea4\u6309\u94ae\u7f6e\u7070\u5e76\u63d0\u793a\u300c\u8bf7\u586b\u5199\u9a73\u56de\u539f\u56e0\u300d\u3002\n- BR-202\uff1a\u4e8c\u7ea7\u5ba1\u6279\u89e6\u53d1\u6761\u4ef6\u4e3a `\u52a0\u73ed\u65f6\u957f > 4`\uff08\u4e25\u683c\u5927\u4e8e\uff1b\u6070\u597d 4.0 h \u4e0d\u89e6\u53d1\uff0c\u89c1 \u00a712 Q2\uff09\u3002\n- BR-203\uff1a\u65f6\u957f\u9608\u503c **4 \u5c0f\u65f6\u4e3a\u53ef\u914d\u7f6e\u53c2\u6570**\uff0c\u8c03\u6574\u540e\u4ec5\u5bf9\u65b0\u7684\u7533\u8bf7\u751f\u6548\uff0c\u5728\u9014\u5355\u636e\u6309\u63d0\u4ea4\u65f6\u5feb\u7167\u6267\u884c\u3002\n- BR-204\uff1a\u4e3b\u7ba1\u5ba1\u6279\u901a\u8fc7\u540e\uff0c\u82e5\u89e6\u53d1\u4e8c\u7ea7\u5ba1\u6279\uff0c\u5355\u636e\u81ea\u52a8\u6d41\u8f6c\u81f3\u90e8\u95e8\u603b\u76d1\u5f85\u529e\uff1b\u4e0d\u89e6\u53d1\u5219\u76f4\u63a5\u7f6e\u4e3a\u300c\u5df2\u901a\u8fc7\u300d\u3002\n- BR-205\uff1a\u4efb\u4e00\u8282\u70b9\u9a73\u56de\uff0c\u5355\u636e\u7acb\u5373\u7ec8\u6b62\u6d41\u7a0b\u7f6e\u4e3a\u300c\u5df2\u9a73\u56de\u300d\uff0c\u5df2\u5b8c\u6210\u7684\u4e0a\u7ea7\u5ba1\u6279\u610f\u89c1\u4fdd\u7559\u5728\u65e5\u5fd7\u4e2d\u3002\n- BR-206\uff1a\u5ba1\u6279\u4eba\u4e0d\u53ef\u4fee\u6539\u7533\u8bf7\u5185\u5bb9\uff1b\u5982\u9700\u8c03\u6574\uff0c\u5fc5\u987b\u9a73\u56de\u7531\u5458\u5de5\u91cd\u65b0\u63d0\u4ea4\u3002\n- BR-207\uff1a\u5355\u636e\u5728\u300c\u5f85\u5ba1\u6279\u300d\u72b6\u6001\u4e0b\uff0c\u5458\u5de5\u53ef\u4e3b\u52a8\u64a4\u56de\uff0c\u64a4\u56de\u540e\u56de\u5230\u300c\u5df2\u9a73\u56de/\u5df2\u64a4\u56de\u300d\u53ef\u7f16\u8f91\u6001\uff0c\u4e0d\u751f\u6210\u5ba1\u6279\u8bb0\u5f55\u4f46\u4fdd\u7559\u64a4\u56de\u65e5\u5fd7\u3002\n- BR-208\uff1a\u5ba1\u6279\u64cd\u4f5c\u9700\u4e8c\u6b21\u786e\u8ba4\u5f39\u7a97\uff08\u542b\u65f6\u957f\u3001\u65e5\u671f\u3001\u4e8b\u7531\u6458\u8981\uff09\uff0c\u9632\u6b62\u8bef\u64cd\u4f5c\u3002\n\n### 6.5 F8\u2013F10 \u5217\u8868\u4e0e\u67e5\u8be2\n\n**\u5458\u5de5\u7aef\u5217\u8868**\n\n| \u5217 | \u8bf4\u660e |\n| --- | --- |\n| \u52a0\u73ed\u65e5\u671f | \u8de8\u5929\u5c55\u793a\u8d77\u6b62\u4e24\u65e5 |\n| \u52a0\u73ed\u65f6\u957f | \u5355\u4f4d h |\n| \u72b6\u6001 | \u5f85\u5ba1\u6279 / \u5df2\u901a\u8fc7 / \u5df2\u9a73\u56de |\n| \u8282\u5047\u65e5\u6807\u8bb0 | \u6709\u5219\u5c55\u793a\u6807\u7b7e |\n| \u63d0\u4ea4\u65f6\u95f4 | `YYYY-MM-DD HH:mm` |\n| \u64cd\u4f5c | \u8be6\u60c5 / \u7f16\u8f91 / \u5220\u9664\uff08\u6309\u72b6\u6001\u4e0e\u6743\u9650\u52a8\u6001\u663e\u793a\uff09 |\n\n- \u7b5b\u9009\u9879\uff1a**\u72b6\u6001**\uff08\u5168\u90e8/\u5f85\u5ba1\u6279/\u5df2\u901a\u8fc7/\u5df2\u9a73\u56de\uff09\u3001**\u6708\u4efd**\uff08`YYYY-MM`\uff0c\u6309\u52a0\u73ed\u65e5\u671f\u5f52\u5c5e\uff09\u3002\n- \u9ed8\u8ba4\u6309\u63d0\u4ea4\u65f6\u95f4\u5012\u5e8f\uff0c\u5206\u9875 20 \u6761/\u9875\u3002\n- \u5f85\u5ba1\u6279\u5355\u636e\u9700\u6709\u660e\u663e\u89c6\u89c9\u6807\u8bc6\uff08\u5982\u89d2\u6807/\u9ad8\u4eae\uff09\u3002\n\n**\u4e3b\u7ba1\u7aef\uff08\u5f85\u5ba1\u6279\u5217\u8868\uff09**\n\n- \u9876\u90e8\u5c55\u793a\u5f85\u529e\u6570\u91cf\u7ea2\u70b9\uff1b\u5217\u8868\u989d\u5916\u5c55\u793a\u7533\u8bf7\u4eba\u3001\u90e8\u95e8\u3001\u63d0\u4ea4\u65f6\u95f4\u3001\u5f53\u524d\u8282\u70b9\u3002\n- \u7b5b\u9009\u9879\uff1a\u72b6\u6001\u3001\u6708\u4efd\u3001\u90e8\u95e8\u5185\u5458\u5de5\uff08\u5173\u952e\u5b57\u641c\u7d22\uff09\u3002\n- \u652f\u6301\u8fdb\u5165\u8be6\u60c5\u5ba1\u6279\uff1b\u4e0d\u652f\u6301\u8de8\u90e8\u95e8\u6570\u636e\u3002\n\n**HR \u7aef**\n\n- \u5168\u516c\u53f8\u67e5\u8be2\uff0c\u7b5b\u9009\u9879\u5728\u901a\u7528\u6761\u4ef6\u4e0a\u589e\u52a0\uff1a**\u90e8\u95e8\u3001\u5458\u5de5\u59d3\u540d/\u5de5\u53f7\u3001\u662f\u5426\u6cd5\u5b9a\u8282\u5047\u65e5**\u3002\n- \u9875\u9762\u9876\u90e8\u5c55\u793a\u7b5b\u9009\u7ed3\u679c\u6c47\u603b\u6761\u6570\u4e0e\u603b\u65f6\u957f\u3002\n- \u4ec5\u63d0\u4f9b\u300c\u67e5\u770b\u8be6\u60c5 + \u5bfc\u51fa\u300d\uff0c\u65e0\u4efb\u4f55\u7f16\u8f91\u7c7b\u6309\u94ae\u3002\n\n### 6.6 F11 \u6309\u6708\u5bfc\u51fa\u6c47\u603b\n\n- \u9009\u62e9\u7edf\u8ba1\u6708\u4efd\uff08\u5fc5\u586b\uff09+ \u53ef\u9009\u90e8\u95e8\uff0c\u70b9\u51fb\u300c\u5bfc\u51fa\u300d\u751f\u6210 **Excel\uff08.xlsx\uff09** \u6587\u4ef6\u3002\n- \u5bfc\u51fa\u5b57\u6bb5\uff1a`\u5de5\u53f7\u3001\u59d3\u540d\u3001\u90e8\u95e8\u3001\u52a0\u73ed\u65e5\u671f\u3001\u5f00\u59cb\u65f6\u95f4\u3001\u7ed3\u675f\u65f6\u95f4\u3001\u52a0\u73ed\u65f6\u957f\u3001\u662f\u5426\u6cd5\u5b9a\u8282\u5047\u65e5\u3001\u5ba1\u6279\u72b6\u6001\u3001\u5ba1\u6279\u4eba\u3001\u9a73\u56de\u539f\u56e0`\u3002\n- \u4ec5\u5bfc\u51fa**\u5df2\u901a\u8fc7**\u72b6\u6001\u7684\u5355\u636e\uff08\u662f\u5426\u9700\u5305\u542b\u5f85\u5ba1\u6279/\u5df2\u9a73\u56de\u89c1 \u00a712 Q6\uff09\u3002\n- \u6392\u5e8f\uff1a\u90e8\u95e8 \u2192 \u5de5\u53f7 \u2192 \u52a0\u73ed\u65e5\u671f\u3002\n- \u6587\u4ef6\u672b\u5c3e\u9644\u6c47\u603b\u884c\uff1a\u6309\u90e8\u95e8\u7edf\u8ba1\u300c\u4eba\u6b21\u300d\u4e0e\u300c\u603b\u65f6\u957f\u300d\u3002\n- \u6587\u4ef6\u540d\uff1a`\u52a0\u73ed\u6c47\u603b_YYYYMM_\u5bfc\u51fa\u65f6\u95f4\u6233.xlsx`\u3002\n- \u6570\u636e\u91cf\u5927\u65f6\u91c7\u7528\u5f02\u6b65\u5bfc\u51fa + \u5b8c\u6210\u901a\u77e5/\u4e0b\u8f7d\u4e2d\u5fc3\uff0c\u907f\u514d\u8bf7\u6c42\u8d85\u65f6\uff1b\u5bfc\u51fa\u64cd\u4f5c\u8bb0\u5f55\u64cd\u4f5c\u4eba\u3001\u7b5b\u9009\u6761\u4ef6\u4e0e\u65f6\u95f4\u3002\n\n### 6.7 F12 \u64cd\u4f5c\u7559\u75d5\n\n\u6bcf\u6761\u7533\u8bf7\u7ef4\u62a4\u4e0d\u53ef\u7be1\u6539\u7684\u64cd\u4f5c\u65e5\u5fd7\uff0c\u5b57\u6bb5\uff1a`\u64cd\u4f5c\u65f6\u95f4\u3001\u64cd\u4f5c\u4eba\uff08\u59d3\u540d+\u5de5\u53f7\uff09\u3001\u64cd\u4f5c\u7c7b\u578b\u3001\u64cd\u4f5c\u524d\u72b6\u6001\u3001\u64cd\u4f5c\u540e\u72b6\u6001\u3001\u5ba1\u6279\u610f\u89c1/\u5907\u6ce8`\u3002\n\n\u64cd\u4f5c\u7c7b\u578b\u679a\u4e3e\uff1a\u63d0\u4ea4\u3001\u7f16\u8f91\u3001\u64a4\u56de\u3001\u5220\u9664\u3001\u4e00\u7ea7\u5ba1\u6279\u901a\u8fc7\u3001\u4e00\u7ea7\u5ba1\u6279\u9a73\u56de\u3001\u4e8c\u7ea7\u5ba1\u6279\u901a\u8fc7\u3001\u4e8c\u7ea7\u5ba1\u6279\u9a73\u56de\u3001\u91cd\u65b0\u63d0\u4ea4\u3002\n\n\u65e5\u5fd7\u5728\u7533\u8bf7\u8be6\u60c5\u9875\u65f6\u95f4\u7ebf\u5c55\u793a\uff0cHR \u53ef\u89c1\u5168\u91cf\uff1b\u65e5\u5fd7\u4ec5\u8ffd\u52a0\uff0c\u4e0d\u63d0\u4f9b\u4efb\u4f55\u5220\u9664/\u4fee\u6539\u5165\u53e3\u3002\n\n### 6.8 F13 \u6d88\u606f\u901a\u77e5\n\n| \u89e6\u53d1\u4e8b\u4ef6 | \u63a5\u6536\u4eba | \u6e20\u9053 |\n| --- | --- | --- |\n| \u63d0\u4ea4\u7533\u8bf7 | \u5f53\u524d\u5ba1\u6279\u4eba | \u7ad9\u5185\u4fe1 + \