6708\u5ea6\u6c47\u603b\u7531\u624b\u5de5\u6570\u5c0f\u65f6\u964d\u4e3a\u5206\u949f\u7ea7\u5bfc\u51fa\u3002\n\n## \u4e0d\u5728\u672c\u6b21\u8303\u56f4\n- \u52a0\u73ed\u4e0e\u85aa\u916c/\u8c03\u4f11\u7684\u81ea\u52a8\u5151\u6362\u8ba1\u7b97\uff08\u672c\u671f\u4ec5\u505a\u7533\u8bf7\u3001\u5ba1\u6279\u3001\u7edf\u8ba1\uff09\uff1b\n- \u4e0e\u8003\u52e4\u673a/\u6253\u5361\u6570\u636e\u81ea\u52a8\u5bf9\u8d26\u6821\u9a8c\uff08\u672c\u671f\u52a0\u73ed\u65f6\u957f\u4ee5\u5458\u5de5\u586b\u62a5 + \u4e3b\u7ba1\u6838\u51c6\u4e3a\u51c6\uff09\uff1b\n- \u79fb\u52a8\u7aef App \u72ec\u7acb\u5f00\u53d1\uff08\u82e5\u73b0\u7cfb\u7edf\u4e3a Web\uff0c\u672c\u671f\u53ea\u505a\u73b0\u6709\u7aef\u9002\u914d\uff0c\u975e\u65b0\u589e App\uff09\uff1b\n- \u52a0\u73ed\u9884\u7b97/\u989d\u5ea6\u7ba1\u63a7\u3002\n\n## \u7528\u6237\u4e0e\u573a\u666f\n| \u89d2\u8272 | \u4e3b\u8981\u573a\u666f |\n|---|---|\n| \u5458\u5de5 | \u63d0\u4ea4\u52a0\u73ed\u7533\u8bf7\u3001\u67e5\u770b/\u4fee\u6539\u81ea\u5df1\u7684\u7533\u8bf7\u3001\u67e5\u770b\u5ba1\u6279\u8fdb\u5ea6\u4e0e\u7ed3\u679c |\n| \u90e8\u95e8\u4e3b\u7ba1 | \u5ba1\u6279\u672c\u90e8\u95e8\u52a0\u73ed\u7533\u8bf7\uff08\u540c\u610f/\u9a73\u56de\uff0c\u9a73\u56de\u9700\u586b\u539f\u56e0\uff09 |\n| \u90e8\u95e8\u603b\u76d1 | \u5ba1\u6279\"\u65f6\u957f > 4 \u5c0f\u65f6\"\u7684\u52a0\u73ed\u7533\u8bf7\uff08\u4e8c\u7ea7\u52a0\u7b7e\uff09 |\n| HR | \u67e5\u770b\u5168\u516c\u53f8\u7533\u8bf7\u3001\u6309\u6708\u5bfc\u51fa\u6c47\u603b |\n\n\u4e3b\u6d41\u7a0b\uff1a\u5458\u5de5\u586b\u5199\u5e76\u63d0\u4ea4 \u2192\uff08\u65f6\u957f \u22644h\uff09\u90e8\u95e8\u4e3b\u7ba1\u5ba1\u6279 \u2192\uff08\u65f6\u957f >4h\uff09\u90e8\u95e8\u4e3b\u7ba1\u5ba1\u6279\u901a\u8fc7\u540e\u8fdb\u5165\u90e8\u95e8\u603b\u76d1\u5ba1\u6279 \u2192 \u901a\u8fc7\u540e\u751f\u6548 \u2192 HR \u6c47\u603b/\u5bfc\u51fa\u3002\n\n## \u529f\u80fd\u9700\u6c42\n1. **\u52a0\u73ed\u7533\u8bf7\u8868\u5355**\uff1a\u5b57\u6bb5\u542b\u52a0\u73ed\u65e5\u671f\u3001\u5f00\u59cb\u65f6\u95f4\u3001\u7ed3\u675f\u65f6\u95f4\u3001\u52a0\u73ed\u4e8b\u7531\uff08\u9009\u586b\uff0c\u2264200 \u5b57\uff09\u3002\n2. **\u65f6\u957f\u81ea\u52a8\u8ba1\u7b97**\uff1a\u7cfb\u7edf\u6309\u5f00\u59cb/\u7ed3\u675f\u65f6\u95f4\u81ea\u52a8\u8ba1\u7b97\u52a0\u73ed\u65f6\u957f\uff0c\u5458\u5de5\u4e0d\u53ef\u624b\u6539\uff1b\u5904\u7406\u8de8\u5929\u52a0\u73ed\uff08\u7ed3\u675f\u65f6\u95f4\u65e9\u4e8e\u5f00\u59cb\u65f6\u95f4\u89c6\u4e3a\u6b21\u65e5\uff09\u3002\n3. **\u63d0\u4ea4\u4e0e\u72b6\u6001\u6d41\u8f6c**\uff1a\u63d0\u4ea4\u540e\u72b6\u6001\u4e3a\u300c\u5f85\u5ba1\u6279\u300d\uff0c\u8fdb\u5165\u5ba1\u6279\u94fe\u3002\n4. **\u4e00\u7ea7\u5ba1\u6279\uff08\u90e8\u95e8\u4e3b\u7ba1\uff09**\uff1a\u53ef\u540c\u610f / \u9a73\u56de\uff1b\u9a73\u56de\u5fc5\u987b\u586b\u5199\u9a73\u56de\u539f\u56e0\uff0c\u9a73\u56de\u540e\u72b6\u6001\u4e3a\u300c\u5df2\u9a73\u56de\u300d\u5e76\u56de\u9000\u7ed9\u5458\u5de5\u3002\n5. **\u4e8c\u7ea7\u52a0\u7b7e\uff08\u90e8\u95e8\u603b\u76d1\uff09**\uff1a\u5f53\u52a0\u73ed\u65f6\u957f > 4 \u5c0f\u65f6\uff0c\u4e3b\u7ba1\u901a\u8fc7\u540e\u81ea\u52a8\u6d41\u8f6c\u81f3\u90e8\u95e8\u603b\u76d1\u5ba1\u6279\uff1b\u22644 \u5c0f\u65f6\u4e0d\u89e6\u53d1\u3002\n6. **\u6cd5\u5b9a\u8282\u5047\u65e5\u81ea\u52a8\u6807\u8bb0**\uff1a\u52a0\u73ed\u65e5\u671f\u547d\u4e2d\u6cd5\u5b9a\u8282\u5047\u65e5\u7684\uff0c\u7cfb\u7edf\u81ea\u52a8\u6807\u8bb0\u300c\u6cd5\u5b9a\u8282\u5047\u65e5\u52a0\u73ed\u300d\uff0c\u4f9b HR \u7edf\u8ba1\u533a\u5206\u3002\n7. **\u5458\u5de5\u7aef\u5217\u8868\u4e0e\u67e5\u8be2**\uff1a\u5c55\u793a\u65e5\u671f\u3001\u65f6\u957f\u3001\u72b6\u6001\uff08\u5f85\u5ba1\u6279/\u5df2\u901a\u8fc7/\u5df2\u9a73\u56de\uff09\uff1b\u652f\u6301\u6309\u72b6\u6001\u3001\u6309\u6708\u4efd\u7b5b\u9009\u3002\n8. **\u4e3b\u7ba1\u7aef\u5f85\u529e\u5217\u8868**\uff1a\u5c55\u793a\u672c\u90e8\u95e8\u5f85\u5ba1\u6279\u7533\u8bf7\uff0c\u8fdb\u5165\u5ba1\u6279\u64cd\u4f5c\u3002\n9. **HR \u7aef\u67e5\u8be2\u4e0e\u5bfc\u51fa**\uff1a\u53ef\u67e5\u770b\u5168\u516c\u53f8\u7533\u8bf7\uff08\u53ea\u8bfb\uff09\uff1b\u652f\u6301\u6309\u6708\u4efd\u5bfc\u51fa\u52a0\u73ed\u6c47\u603b\u3002\n10. **\u4fee\u6539/\u64a4\u56de\u89c4\u5219**\uff1a\u5458\u5de5\u4ec5\u53ef\u4fee\u6539/\u64a4\u56de\u300c\u5f85\u5ba1\u6279\u300d\u300c\u5df2\u9a73\u56de\u300d\u72b6\u6001\u7684\u672c\u4eba\u7533\u8bf7\uff1b\u300c\u5df2\u901a\u8fc7\u300d\u4e0d\u53ef\u6539\u3002\n\n## \u975e\u529f\u80fd\u9700\u6c42\n- **\u6743\u9650\u4e0e\u6570\u636e\u9694\u79bb**\uff1a\u5458\u5de5\u4ec5\u53ef\u89c1/\u6539\u672c\u4eba\uff1b\u4e3b\u7ba1\u4ec5\u53ef\u89c1/\u5ba1\u6279\u672c\u90e8\u95e8\uff1bHR \u53ef\u89c1\u5168\u516c\u53f8\u4f46\u53ea\u8bfb\u3001\u4e0d\u53ef\u6539\u3002\u4ee5\u89d2\u8272 + \u90e8\u95e8\u7ef4\u5ea6\u505a\u6570\u636e\u884c\u7ea7\u8fc7\u6ee4\u3002\n- **\u7559\u75d5/\u5ba1\u8ba1**\uff1a\u63d0\u4ea4\u3001\u5ba1\u6279\u3001\u9a73\u56de\u3001\u4fee\u6539\u7b49\u64cd\u4f5c\u8bb0\u5f55\u64cd\u4f5c\u4eba\u4e0e\u65f6\u95f4\u6233\uff0c\u4e0d\u53ef\u7be1\u6539\u3002\n- **\u8282\u5047\u65e5\u6570\u636e**\uff1a\u9700\u7ef4\u62a4\u6cd5\u5b9a\u8282\u5047\u65e5\u65e5\u5386\uff08\u542b\u8c03\u4f11\uff09\uff0c\u5efa\u8bae\u6bcf\u5e74\u53ef\u914d\u7f6e\u66f4\u65b0\u3002\n- **\u5e76\u53d1**\uff1a\u6708\u5e95/\u6708\u521d\u63d0\u4ea4\u4e0e\u5ba1\u6279\u9ad8\u5cf0\uff0c\u6309\u73b0\u7cfb\u7edf\u540c\u7c7b\u6a21\u5757\u5e76\u53d1\u6807\u51c6\u3002\n- **\u517c\u5bb9**\uff1a\u6cbf\u7528\u73b0\u6709\u5185\u90e8\u7cfb\u7edf\u7684\u6d4f\u89c8\u5668/\u7ec8\u7aef\u517c\u5bb9\u57fa\u7ebf\u3002\n\n## \u8f93\u5165 / \u8f93\u51fa\n- \u8f93\u5165\uff1a\u5458\u5de5\u586b\u62a5\u7684\u65e5\u671f\u3001\u8d77\u6b62\u65f6\u95f4\u3001\u4e8b\u7531\uff1b\u7ec4\u7ec7\u67b6\u6784\u4e0e\u90e8\u95e8\u5f52\u5c5e\uff1b\u5ba1\u6279\u4eba\u914d\u7f6e\uff1b\u6cd5\u5b9a\u8282\u5047\u65e5\u65e5\u5386\u3002\n- \u8f93\u51fa\uff1a\u5458\u5de5\u7aef/\u4e3b\u7ba1\u7aef/HR \u7aef\u5217\u8868\uff1b\u5ba1\u6279\u7ed3\u679c\u4e0e\u72b6\u6001\uff1bHR \u6309\u6708\u5bfc\u51fa\u7684\u52a0\u73ed\u6c47\u603b\u8868\uff08\u5efa\u8bae Excel/CSV\uff0c\u5b57\u6bb5\u542b\u90e8\u95e8\u3001\u5458\u5de5\u3001\u65e5\u671f\u3001\u65f6\u957f\u3001\u662f\u5426\u8282\u5047\u65e5\u3001\u72b6\u6001\uff09\u3002\n\n## \u8fb9\u754c\u4e0e\u5f02\u5e38\u5904\u7406\n- \u65f6\u957f\u8ba1\u7b97\uff1a\u8de8\u5929\u52a0\u73ed\u3001\u5f00\u59cb=\u7ed3\u675f\uff080 \u65f6\u957f\uff09\u6821\u9a8c\uff0c0 \u65f6\u957f\u662f\u5426\u5141\u8bb8\u63d0\u4ea4\u9700\u786e\u8ba4\uff08\u9ed8\u8ba4\u4e0d\u5141\u8bb8\uff09\u3002\n- \u4e00\u5929\u591a\u6761\u7533\u8bf7\uff1a\u662f\u5426\u5141\u8bb8\u540c\u65e5\u591a\u6b21\u63d0\u4ea4\uff0c\u9ed8\u8ba4\u5141\u8bb8\u4f46\u5404\u81ea\u72ec\u7acb\u5ba1\u6279\u3002\n- \u5ba1\u6279\u4eba\u7f3a\u4f4d\uff1a\u90e8\u95e8\u4e3b\u7ba1/\u603b\u76d1\u7a7a\u7f3a\u6216\u957f\u671f\u672a\u5904\u7406\u65f6\u7684\u8f6c\u4ea4/\u8d85\u65f6\u63d0\u9192\u673a\u5236\u9700\u786e\u8ba4\u3002\n- \u4fee\u6539\u540e\u91cd\u7b97\uff1a\u5458\u5de5\u4fee\u6539\u8d77\u6b62\u65f6\u95f4\u81f4\u65f6\u957f\u8de8\u8fc7 4h \u9608\u503c\u65f6\uff0c\u662f\u5426\u91cd\u65b0\u89e6\u53d1\u52a0\u7b7e\uff0c\u9ed8\u8ba4\u91cd\u65b0\u6309\u65b0\u65f6\u957f\u5224\u5b9a\u5e76\u91cd\u7f6e\u5ba1\u6279\u3002\n- \u9a73\u56de\u540e\u518d\u63d0\u4ea4\uff1a\u4f5c\u4e3a\u65b0\u8bb0\u5f55\u6216\u539f\u8bb0\u5f55\u518d\u63d0\u4ea4\uff0c\u9700\u786e\u8ba4\uff08\u9ed8\u8ba4\u539f\u8bb0\u5f55\u56de\u5230\u300c\u5f85\u5ba1\u6279\u300d\u5e76\u4fdd\u7559\u5386\u53f2\uff09\u3002\n- \u8282\u5047\u65e5\u547d\u4e2d\uff1a\u8de8\u8282\u5047\u65e5\u65f6\u6bb5\u3001\u8c03\u4f11\u4e0a\u73ed\u65e5\u7684\u5224\u5b9a\u8fb9\u754c\u3002\n\n## \u9a8c\u6536\u6807\u51c6\n1. \u5458\u5de5\u63d0\u4ea4\u4e00\u6761 \u22644h \u52a0\u73ed\uff0c\u4e3b\u7ba1\u901a\u8fc7\u540e\u72b6\u6001\u4e3a\u300c\u5df2\u901a\u8fc7\u300d\uff0c\u5168\u7a0b\u65e0\u603b\u76d1\u8282\u70b9\u3002\n2. \u5458\u5de5\u63d0\u4ea4\u4e00\u6761 >4h \u52a0\u73ed\uff0c\u4e3b\u7ba1\u901a\u8fc7\u540e\u81ea\u52a8\u8fdb\u5165\u603b\u76d1\u5ba1\u6279\uff0c\u603b\u76d1\u901a\u8fc7\u540e\u624d\u4e3a\u300c\u5df2\u901a\u8fc7\u300d\u3002\n3. \u4e3b\u7ba1\u9a73\u56de\u672a\u586b\u539f\u56e0\u65f6\u65e0\u6cd5\u63d0\u4ea4\uff1b\u9a73\u56de\u540e\u5458\u5de5\u53ef\u89c1\u9a73\u56de\u539f\u56e0\u5e76\u53ef\u4fee\u6539\u91cd\u63d0\u3002\n4. \u52a0\u73ed\u65f6\u957f\u7531\u8d77\u6b62\u65f6\u95f4\u81ea\u52a8\u7b97\u51fa\uff0c\u524d\u7aef\u4e0d\u53ef\u624b\u6539\uff0c\u8de8\u5929\u8ba1\u7b97\u6b63\u786e\u3002\n5. \u843d\u5728\u6cd5\u5b9a\u8282\u5047\u65e5\u7684\u7533\u8bf7\u81ea\u52a8\u5e26\u300c\u6cd5\u5b9a\u8282\u5047\u65e5\u52a0\u73ed\u300d\u6807\u8bb0\u3002\n6. \u5458\u5de5\u7aef\u4ec5\u80fd\u770b/\u6539\u672c\u4eba\uff1b\u4e3b\u7ba1\u4ec5\u80fd\u770b/\u6279\u672c\u90e8\u95e8\uff1bHR \u80fd\u770b\u5168\u516c\u53f8\u4f46\u6539\u4e0d\u4e86\u3002\n7. \u5458\u5de5\u7aef\u6309\u72b6\u6001\u3001\u6309\u6708\u4efd\u7b5b\u9009\u7ed3\u679c\u6b63\u786e\uff1bHR \u6309\u6708\u5bfc\u51fa\u6c47\u603b\u6570\u636e\u4e0e\u5217\u8868\u4e00\u81f4\u3002\n\n## \u4f9d\u8d56\u4e0e\u7ea6\u675f\n- \u4f9d\u8d56\u73b0\u6709\u5185\u90e8\u7cfb\u7edf\u7684\u7528\u6237\u3001\u7ec4\u7ec7\u67b6\u6784\u3001\u90e8\u95e8\u3001\u89d2\u8272\u6743\u9650\u4f53\u7cfb\u3002\n- \u4f9d\u8d56\u6cd5\u5b9a\u8282\u5047\u65e5\u6570\u636e\u6e90\uff08\u6bcf\u5e74\u9700\u7ef4\u62a4\uff09\u3002\n- \u6cbf\u7528\u73b0\u6709\u6280\u672f\u6808\u4e0e\u90e8\u7f72\u73af\u5883\uff0c\u4e0d\u5f15\u5165\u72ec\u7acb\u65b0\u7cfb\u7edf\u3002\n\n## \u590d\u6742\u5ea6\u4e0e\u5de5\u4f5c\u91cf\n- **\u590d\u6742\u5ea6**\uff1aL\n- **\u9884\u8ba1\u5de5\u65f6**\uff1a8\u201313 \u4eba\u5929\n- **\u7f6e\u4fe1\u5ea6**\uff1a\u4e2d\uff08\u4e0d\u4e86\u89e3\u73b0\u7cfb\u7edf\u6280\u672f\u6808\u3001\u6743\u9650\u6a21\u578b\u4e0e\u662f\u5426\u5df2\u6709\u5ba1\u6279\u5f15\u64ce\uff0c\u6309\u901a\u7528 Web \u5185\u90e8\u7cfb\u7edf\u4f30\u7b97\uff09\n- **\u62c6\u89e3\u4f9d\u636e**\uff1a\n  - \u6570\u636e\u5c42\uff1a\u65b0\u589e\u52a0\u73ed\u7533\u8bf7\u8868\u3001\u5ba1\u6279\u6d41\u6c34/\u72b6\u6001\u8868\u3001\u8282\u5047\u65e5\u65e5\u5386\u8868 \u2192 1\u20131.5 \u4eba\u5929\n  - \u903b\u8f91\u5c42\uff1a\u65f6\u957f\u8ba1\u7b97\uff08\u542b\u8de8\u5929\uff09\u30014h \u9608\u503c\u4e8c\u7ea7\u52a0\u7b7e\u6d41\u8f6c\u3001\u8282\u5047\u65e5\u6807\u8bb0\u3001\u72b6\u6001\u673a \u2192 2.5\u20134 \u4eba\u5929\n  - \u96c6\u6210\u5c42\uff1a\u5bf9\u63a5\u7ec4\u7ec7\u67b6\u6784/\u6743\u9650\uff1b\u8282\u5047\u65e5\u6570\u636e\uff1b\u5bfc\u51fa\u7ec4\u4ef6 \u2192 1.5\u20132.5 \u4eba\u5929\n  - \u754c\u9762\u5c42\uff1a\u5458\u5de5\u8868\u5355+\u5217\u8868\u7b5b\u9009\u3001\u4e3b\u7ba1\u5ba1\u6279\u3001HR \u67e5\u8be2+\u5bfc\u51fa \u2192 3\u20134 \u4eba\u5929\n  - \u975e\u529f\u80fd\uff1a\u884c\u7ea7\u6743\u9650\u9694\u79bb\u3001\u64cd\u4f5c\u7559\u75d5\u3001\u5e76\u53d1 \u2192 1\u20131.5 \u4eba\u5929\n  - \u8054\u8c03\u4e0e\u6d4b\u8bd5 \u2192 1\u20132 \u4eba\u5929\n- **\u5173\u952e\u5047\u8bbe**\uff1a\u2460 \u590d\u7528\u73b0\u6709\u7cfb\u7edf\u767b\u5f55\u4e0e\u7ec4\u7ec7\u67b6\u6784\uff0c\u65e0\u9700\u91cd\u505a\u6743\u9650\u5e95\u5ea7\uff1b\u2461 \u65e0\u73b0\u6210\u901a\u7528\u5ba1\u6279\u6d41\u5f15\u64ce\uff0c\u4e8c\u7ea7\u52a0\u7b7e\u7528\u72b6\u6001\u673a\u81ea\u7814\uff1b\u2462 \u8282\u5047\u65e5\u6570\u636e\u4ee5\u5e74\u5ea6\u9759\u6001\u914d\u7f6e\u8868\u5bfc\u5165\u5373\u53ef\uff1b\u2463 \u5bfc\u51fa\u7528\u73b0\u6709\u62a5\u8868/\u5bfc\u51fa\u7ec4\u4ef6\u3002\n- **\u98ce\u9669/\u4e0d\u786e\u5b9a**\uff1a\n  - \u26a0\ufe0f \u82e5\u73b0\u7cfb\u7edf\u65e0\u7edf\u4e00\u6743\u9650/\u7ec4\u7ec7\u6a21\u578b\u9700\u8865\u9f50\uff08+2\u20134 \u4eba\u5929\uff09\n  - \u26a0\ufe0f \u82e5\u9700\u5bf9\u63a5\u6253\u5361/\u8003\u52e4\u6570\u636e\u6821\u9a8c\u65f6\u957f\uff08+3\u20135 \u4eba\u5929\uff0c\u672c\u671f\u9ed8\u8ba4\u4e0d\u505a\uff09\n  - \u26a0\ufe0f \u82e5\u5ba1\u6279\u6d41\u8981\u53ef\u914d\u7f6e\uff08\u591a\u7ea7/\u81ea\u5b9a\u4e49\u8282\u70b9\uff09\u800c\u975e\u56fa\u5b9a\u4e8c\u7ea7\uff08+2\u20133 \u4eba\u5929\uff09\n  - \u26a0\ufe0f \u6cd5\u5b9a\u8282\u5047\u65e5\u542b\u8c03\u4f11\u7684\u51c6\u786e\u5224\u5b9a\u6570\u636e\u6765\u6e90\u4e0d\u786e\u5