10/\u9a73\u56de |\n\n## 4. \u7528\u6237\u89d2\u8272\u4e0e\u6743\u9650\n\n| \u89d2\u8272 | \u62a5\u9500\u5355\u67e5\u770b | \u65b0\u5efa/\u7f16\u8f91/\u63d0\u4ea4 | \u5ba1\u6279\uff08\u542b\u770b\u53d1\u7968\uff09 | \u9a73\u56de/\u64a4\u56de | \u5bfc\u51fa | \u914d\u7f6e\u8d39\u7528\u7c7b\u578b |\n|---|---|---|---|---|---|---|\n| \u5458\u5de5 | \u672c\u4eba\u5355\u636e + \u88ab\u6284\u9001\u5355\u636e | \u672c\u4eba\u5355\u636e | \u5426 | \u4ec5\u672c\u4eba\u672a\u8fdb\u5165\u5ba1\u6279\u7684\u5355\u636e\u53ef\u64a4\u56de | \u5426 | \u5426 |\n| \u90e8\u95e8\u4e3b\u7ba1 | \u672c\u90e8\u95e8\u4e0b\u5c5e\u5168\u90e8\u5355\u636e | \u672c\u4eba\u5355\u636e\uff08\u517c\u5458\u5de5\u8eab\u4efd\u65f6\uff09 | \u662f\uff0c\u53ef\u67e5\u770b\u5168\u90e8\u660e\u7ec6\u4e0e\u53d1\u7968\u7167\u7247 | \u662f | \u5426\uff08\u672c\u671f\u4e0d\u505a\uff09 |\n| \u8d22\u52a1 | \u5168\u516c\u53f8\u5355\u636e | \u5426\uff08\u9664\u62a5\u9500\u4eba\u672c\u4eba\uff09 | \u662f\uff08\u590d\u6838\u8282\u70b9\uff09 | \u662f | \u662f | \u662f\uff08\u5b57\u5178\u7ef4\u62a4\uff09 |\n| \u7cfb\u7edf\u7ba1\u7406\u5458 | \u6309\u8fd0\u7ef4\u6743\u9650 | \u5426 | \u5426 | \u5426 | \u5426 | \u6743\u9650/\u89d2\u8272\u914d\u7f6e |\n\n\u6743\u9650\u5224\u5b9a\u539f\u5219\uff1a\u83dc\u5355\u53ef\u89c1 \u2260 \u6570\u636e\u53ef\u89c1\uff0c\u6240\u6709\u67e5\u8be2\u4e0e\u5bfc\u51fa\u63a5\u53e3\u5fc5\u987b\u6309\u89d2\u8272 + \u6570\u636e\u8303\u56f4\uff08\u672c\u4eba/\u672c\u90e8\u95e8/\u5168\u516c\u53f8\uff09\u53cc\u91cd\u6821\u9a8c\u3002\n\n## 5. \u9700\u6c42\u8303\u56f4\n\n### 5.1 \u672c\u671f\u8303\u56f4\uff08In Scope\uff09\n1. \u62a5\u9500\u5355\u7ed3\u6784\u6539\u9020\uff1a\u5355\u5934 + \u591a\u660e\u7ec6\u884c + \u660e\u7ec6\u7ea7\u53d1\u7968\u9644\u4ef6\u3002\n2. \u586b\u5355\u3001\u6682\u5b58\u3001\u7f16\u8f91\u3001\u63d0\u4ea4\u3001\u5ba1\u6279\u3001\u9a73\u56de\u3001\u64a4\u56de\u5168\u6d41\u7a0b\u9002\u914d\u591a\u660e\u7ec6\u3002\n3. \u5ba1\u6279\u9875\u53d1\u7968\u7167\u7247\u5728\u7ebf\u67e5\u770b\uff08\u7f29\u7565\u56fe\u5217\u8868 + \u5927\u56fe\u9884\u89c8 + \u4e0b\u8f7d\u539f\u56fe\uff09\u3002\n4. \u8d22\u52a1\u5bfc\u51fa\uff1a\u5217\u8868/\u660e\u7ec6\u4e24\u7c7b\u62a5\u8868\u5bfc\u51fa\uff0cExcel \u4e3a\u4e3b\uff0c\u652f\u6301\u7b5b\u9009\u6761\u4ef6\u3002\n5. \u5386\u53f2\u6570\u636e\u517c\u5bb9\uff1a\u65e7\u5355\u636e\u5728\u65b0\u7248\u672c\u4e2d\u53ef\u67e5\u770b\u3001\u53ef\u7ee7\u7eed\u8d70\u5b8c\u5728\u9014\u5ba1\u6279\uff0c\u53ea\u8bfb\u4e3a\u4e3b\u3002\n6. \u8d39\u7528\u7c7b\u578b\u5b57\u5178\u53ef\u914d\u7f6e\uff08\u65b0\u589e\u3001\u505c\u7528\u3001\u6392\u5e8f\uff09\uff0c\u5e76\u914d\u7f6e\u9ed8\u8ba4\u5ba1\u6279\u9650\u989d\u89c4\u5219\u6cbf\u7528\u73b0\u6709\u903b\u8f91\u3002\n\n### 5.2 \u672c\u671f\u4e0d\u505a\uff08Out of Scope\uff09\n1. OCR \u81ea\u52a8\u8bc6\u522b\u53d1\u7968\u91d1\u989d\u3001\u53d1\u7968\u9a8c\u771f/\u67e5\u91cd\u5bf9\u63a5\u7a0e\u52a1\u5e73\u53f0\uff08\u540e\u7eed\u8fed\u4ee3\uff09\u3002\n2. \u79fb\u52a8\u7aef\u72ec\u7acb\u539f\u751f\u6539\u9020\uff08\u6cbf\u7528\u54cd\u5e94\u5f0f H5 \u80fd\u529b\uff0c\u89c1 \u00a79.4\uff09\u3002\n3. \u62a5\u9500\u9884\u7b97\u7ba1\u63a7\u3001\u6210\u672c\u4e2d\u5fc3\u5206\u644a\u3001\u51ed\u8bc1\u81ea\u52a8\u751f\u6210\u5230\u603b\u8d26\u3002\n4. \u591a\u5e01\u79cd\u6c47\u7387\u6362\u7b97\u6539\u9020\uff08\u6cbf\u7528\u73b0\u72b6\uff0c\u4ec5\u652f\u6301\u672c\u4f4d\u5e01\uff09\u3002\n5. \u5bfc\u51fa\u540e\u7684\u7535\u5b50\u5f52\u6863/\u7b7e\u7ae0\u3002\n\n## 6. \u529f\u80fd\u9700\u6c42\n\n\u9700\u6c42\u7f16\u53f7\u89c4\u5219\uff1a`EXP-<\u6a21\u5757>-<\u5e8f\u53f7>`\uff0c\u4f18\u5148\u7ea7 P0\uff08\u5fc5\u505a\uff09/P1\uff08\u5e94\u505a\uff09/P2\uff08\u53ef\u505a\uff09\u3002\n\n### 6.1 \u5355\u636e\u7ed3\u6784\uff1a\u4e00\u5355\u591a\u8d39\u7528\uff08G1\uff09\n\n| \u7f16\u53f7 | \u9700\u6c42 | \u4f18\u5148\u7ea7 |\n|---|---|---|\n| EXP-FORM-01 | \u65b0\u5efa\u62a5\u9500\u5355\u9875\u62c6\u4e3a\u300c\u5355\u5934\u533a\u300d+\u300c\u8d39\u7528\u660e\u7ec6\u533a\u300d+\u300c\u9644\u4ef6\u533a\u300d\u3002\u5355\u5934\uff1a\u62a5\u9500\u4eba\u3001\u90e8\u95e8\u3001\u62a5\u9500\u4e8b\u7531\u3001\u8d39\u7528\u5f52\u5c5e\u671f\u95f4\u3001\u53d1\u751f\u65e5\u671f\u8303\u56f4\uff08\u81ea\u52a8\u53d6\u660e\u7ec6\u6700\u5c0f/\u6700\u5927\u65e5\u671f\uff0c\u53ea\u8bfb\uff09\u3001\u6574\u5355\u91d1\u989d\uff08\u81ea\u52a8\u6c47\u603b\uff0c\u53ea\u8bfb\uff09 | P0 |\n| EXP-FORM-02 | \u8d39\u7528\u660e\u7ec6\u533a\u4ee5\u53ef\u589e\u5220\u884c\u7684\u8868\u683c\u5448\u73b0\uff0c\u652f\u6301\u300c\u6dfb\u52a0\u4e00\u884c\u300d\u300c\u5220\u9664\u884c\u300d\u300c\u590d\u5236\u4e0a\u4e00\u884c\u300d\uff1b\u81f3\u5c11 1 \u884c\u65b9\u53ef\u63d0\u4ea4\uff0c\u6700\u591a 50 \u884c | P0 |\n| EXP-FORM-03 | \u660e\u7ec6\u884c\u5b57\u6bb5\uff1a\u8d39\u7528\u7c7b\u578b\uff08\u5fc5\u9009\uff0c\u5b57\u5178\uff09\u3001\u53d1\u751f\u65e5\u671f\uff08\u5fc5\u586b\uff0c\u2264 \u4eca\u65e5\uff09\u3001\u91d1\u989d\uff08\u5fc5\u586b\uff0c> 0\uff0c\u4e24\u4f4d\u5c0f\u6570\uff09\u3001\u8bf4\u660e\uff08\u2264 200 \u5b57\uff09\u3001\u53d1\u7968\u9644\u4ef6\uff08\u89c1 EXP-INV-01\uff09\u3001\u5907\u6ce8 | P0 |\n| EXP-FORM-04 | \u540c\u4e00\u5f20\u5355\u5185\u5141\u8bb8\u51fa\u73b0\u76f8\u540c\u8d39\u7528\u7c7b\u578b\u7684\u591a\u884c\uff08\u5982\u4e24\u5929\u9910\u8d39\u5206\u4e24\u884c\uff09\uff1b\u4e0d\u505a\u540c\u7c7b\u578b\u81ea\u52a8\u5408\u5e76 | P0 |\n| EXP-FORM-05 | \u5b9e\u65f6\u6821\u9a8c\u5e76\u5c55\u793a\uff1a\u660e\u7ec6\u91d1\u989d\u4e4b\u548c = \u6574\u5355\u91d1\u989d\uff1b\u660e\u7ec6\u4e3a\u7a7a\u3001\u91d1\u989d\u975e\u6b63\u6570\u3001\u7c7b\u578b\u672a\u9009\u3001\u65e5\u671f\u975e\u6cd5\u65f6\u884c\u5185\u62a5\u9519\u5e76\u963b\u6b62\u63d0\u4ea4\uff0c\u9519\u8bef\u5b9a\u4f4d\u5230\u5177\u4f53\u884c\u53f7 | P0 |\n| EXP-FORM-06 | \u6682\u5b58\u8349\u7a3f\uff1a\u5141\u8bb8\u660e\u7ec6\u4e0d\u5b8c\u6574\uff08\u81f3\u5c11 1 \u884c\u4e14\u5df2\u4fdd\u5b58\u5355\u5934\uff09\uff0c\u8349\u7a3f\u4ec5\u672c\u4eba\u53ef\u89c1\u53ef\u7f16\u8f91 | P0 |\n| EXP-FORM-07 | \u7f16