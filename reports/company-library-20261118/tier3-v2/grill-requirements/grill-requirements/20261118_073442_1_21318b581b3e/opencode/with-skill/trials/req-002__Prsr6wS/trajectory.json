u6301\u589e\u5220\u6539\u660e\u7ec6\u884c\uff1b\u603b\u91d1\u989d\u7531\u5404\u884c\u81ea\u52a8\u6c47\u603b\u4e14\u4e0d\u53ef\u624b\u5de5\u7be1\u6539\u3002\n- **F2 \u8d39\u7528\u7c7b\u578b\u7ef4\u62a4**\uff1a\u8d39\u7528\u7c7b\u578b\u53d6\u81ea\u7edf\u4e00\u5b57\u5178\uff08\u6cbf\u7528/\u6269\u5c55\u73b0\u6709\u8d39\u7528\u7c7b\u578b\u5b57\u5178\uff09\uff0c\u652f\u6301\u6253\u8f66\u8d39\u3001\u9910\u8d39\u3001\u4f4f\u5bbf\u8d39\u7b49\uff1b\u540c\u4e00\u5355\u5185\u7c7b\u578b\u53ef\u91cd\u590d\u6216\u552f\u4e00\uff08\u9ed8\u8ba4\u5141\u8bb8\u91cd\u590d\uff0c\u8bc4\u5ba1\u786e\u8ba4\uff09\u3002\n- **F3 \u53d1\u7968\u7167\u7247\u4e0a\u4f20**\uff1a\u6bcf\u6761\u8d39\u7528\u660e\u7ec6\u53ef\u4e0a\u4f20 \u22651 \u5f20\u53d1\u7968\u7167\u7247\uff08jpg/png\uff0c\u5355\u5f20\u53ca\u5355\u6587\u4ef6\u4e0a\u9650\u89c1\u975e\u529f\u80fd\u9700\u6c42\uff09\uff1b\u652f\u6301\u9884\u89c8\u3001\u5220\u9664\u3001\u91cd\u65b0\u4e0a\u4f20\u3002\n- **F4 \u5ba1\u6279\u7aef\u67e5\u770b\u53d1\u7968**\uff1a\u5ba1\u6279\u8be6\u60c5\u9875\u6309\u8d39\u7528\u660e\u7ec6\u5c55\u793a\u7f29\u7565\u56fe\uff0c\u70b9\u51fb\u67e5\u770b\u5927\u56fe\uff1b\u652f\u6301\u5728\u5f53\u524d\u9875\u76f4\u63a5\u7ffb\u9605\u8be5\u5355\u6240\u6709\u53d1\u7968\uff0c\u65e0\u9700\u8fd4\u56de\u5217\u8868\u3002\n- **F5 \u8d22\u52a1\u5bfc\u51fa**\uff1a\u6309\u7b5b\u9009\u6761\u4ef6\u5bfc\u51fa\u62a5\u9500\u5355\u6e05\u5355\uff08Excel/CSV\uff09\uff0c\u5b57\u6bb5\u542b\u5355\u636e\u53f7\u3001\u62a5\u9500\u4eba\u3001\u90e8\u95e8\u3001\u72b6\u6001\u3001\u5404\u8d39\u7528\u660e\u7ec6\u7c7b\u578b\u4e0e\u91d1\u989d\u3001\u603b\u91d1\u989d\u3001\u53d1\u7968\u5f20\u6570\u53ca\u5f71\u50cf\u94fe\u63a5/\u7f16\u53f7\u3002\n- **F6 \u5386\u53f2\u6570\u636e\u517c\u5bb9**\uff1a\u65e7\u300c\u5355\u8d39\u7528\u7c7b\u578b\u300d\u62a5\u9500\u5355\u5728\u65b0\u7ed3\u6784\u4e2d\u4f5c\u4e3a\"\u4ec5\u4e00\u6761\u660e\u7ec6\"\u5448\u73b0\uff0c\u67e5\u770b\u3001\u5ba1\u6279\u3001\u5bfc\u51fa\u5168\u94fe\u8def\u6b63\u5e38\uff1b\u65b0\u903b\u8f91\u4e0d\u6539\u53d8\u5386\u53f2\u5355\u636e\u539f\u503c\u3002\n- **F7 \u6570\u636e\u6821\u9a8c**\uff1a\u91d1\u989d>0\u3001\u660e\u7ec6\u884c\u975e\u7a7a\u3001\u53d1\u7968\u5fc5\u586b\u7b56\u7565\uff08\u63d0\u4ea4\u65f6\u662f\u5426\u5f3a\u5236\u6bcf\u5f20\u53d1\u7968\uff0c\u8bc4\u5ba1\u786e\u8ba4\uff09\u7b49\u63d0\u4ea4\u524d\u6821\u9a8c\u3002\n\n## \u975e\u529f\u80fd\u9700\u6c42\n- **\u6027\u80fd**\uff1a\u8d39\u7528\u660e\u7ec6\u652f\u6301\u5e38\u89c1 \u226450 \u884c/\u5355\uff1b\u53d1\u7968\u7167\u7247\u5217\u8868\u52a0\u8f7d\u4e0e\u5927\u56fe\u9884\u89c8\u6d41\u7545\uff08\u9996\u5c4f <2s\uff09\uff1b\u8d22\u52a1\u5bfc\u51fa\u4e07\u7ea7\u5355\u636e\u53ef\u5f02\u6b65\u751f\u6210\u4e0d\u8d85\u65f6\u3002\n- **\u5b89\u5168\u4e0e\u5408\u89c4**\uff1a\u53d1\u7968\u5f71\u50cf\u8bbf\u95ee\u9700\u9274\u6743\uff0c\u4ec5\u62a5\u9500\u4eba/\u5ba1\u6279\u94fe\u4e0a\u4eba\u5458/\u8d22\u52a1\u53ef\u89c1\uff1b\u64cd\u4f5c\u7559\u75d5\uff08\u5ba1\u8ba1\u65e5\u5fd7\uff09\u3002\n- **\u517c\u5bb9**\uff1a\u5386\u53f2\u6570\u636e\u5e73\u6ed1\u8fc1\u79fb\uff0c\u65b0\u65e7\u5355\u636e\u8bfb\u53d6\u517c\u5bb9\uff0c\u4e0d\u51fa\u73b0\u6570\u636e\u4e22\u5931\u6216\u9519\u4e71\u3002\n- **\u53ef\u7528\u6027**\uff1a\u73b0\u6709\u7ec8\u7aef\u9002\u914d\uff0c\u65e0\u9700\u91cd\u88c5\u3002\n- **\u5b58\u50a8**\uff1a\u65b0\u589e\u53d1\u7968\u5f71\u50cf\u9700\u8bc4\u4f30\u5bf9\u8c61\u5b58\u50a8\u5bb9\u91cf\u4e0e\u589e\u957f\u3002\n\n## \u8f93\u5165 / \u8f93\u51fa\n- \u8f93\u5165\uff1a\u5458\u5de5\u586b\u5199\u7684\u62a5\u9500\u4e3b\u4fe1\u606f\u3001\u8d39\u7528\u660e\u7ec6\u884c\u3001\u53d1\u7968\u7167\u7247\u6587\u4ef6\u3002\n- \u8f93\u51fa\uff1a\n  - \u5ba1\u6279\u7aef\uff1a\u7ed3\u6784\u5316\u8d39\u7528\u660e\u7ec6 + \u53ef\u70b9\u51fb\u7684\u53d1\u7968\u5f71\u50cf\u3002\n  - \u8d22\u52a1\u5bfc\u51fa\uff1aExcel/CSV \u6e05\u5355\uff08\u660e\u7ec6 + \u91d1\u989d\u6c47\u603b + \u53d1\u7968\u7d22\u5f15/\u94fe\u63a5\uff09\u3002\n  - \u5b58\u50a8\uff1a\u62a5\u9500\u5355\u4e3b\u8868 + \u8d39\u7528\u660e\u7ec6\u5b50\u8868 + \u53d1\u7968\u5f71\u50cf\uff08\u5bf9\u8c61\u5b58\u50a8/\u56fe\u7247\u670d\u52a1\u5668\uff09\u3002\n\n## \u8fb9\u754c\u4e0e\u5f02\u5e38\u5904\u7406\n- \u660e\u7ec6\u884c\u5220\u9664\u540e\u603b\u91d1\u989d\u5b9e\u65f6\u91cd\u7b97\uff1b\u6e05\u7a7a\u6240\u6709\u660e\u7ec6\u4e0d\u5141\u8bb8\u63d0\u4ea4\u3002\n- \u53d1\u7968\u4e0a\u4f20\u5931\u8d25/\u8d85\u5927/\u683c\u5f0f\u975e\u6cd5\u9700\u660e\u786e\u62a5\u9519\u5e76\u53ef\u91cd\u8bd5\uff0c\u4e0d\u5f71\u54cd\u5df2\u586b\u660e\u7ec6\u3002\n- \u5386\u53f2\u5355\u636e\u65e0\"\u660e\u7ec6\u5b50\u8868\"\u8bb0\u5f55\u65f6\uff0c\u6309\u5355\u8d39\u7528\u517c\u5bb9\u6e32\u67d3\u3002\n- \u5ba1\u6279\u4e2d/\u5df2\u5ba1\u6279\u5355\u636e\u7684\u8d39\u7528\u660e\u7ec6\u662f\u5426\u53ef\u6539\uff1a\u9ed8\u8ba4\u63d0\u4ea4\u540e\u8fdb\u5165\u5ba1\u6279\u5373\u9501\u5b9a\uff0c\u4ec5\u9a73\u56de\u540e\u53ef\u7f16\u8f91\uff08\u8bc4\u5ba1\u786e\u8ba4\uff09\u3002\n- \u5bfc\u51fa\u65e0\u6570\u636e / \u8d85\u5927\u6570\u636e\u91cf \u2192 \u63d0\u793a\u6216\u8f6c\u5f02\u6b65\u3002\n\n## \u9a8c\u6536\u6807\u51c6\n- AC1\uff1a\u65b0\u5efa\u62a5\u9500\u5355\u53ef\u6dfb\u52a0 \u22653 \u6761\u4e0d\u540c\u8d39\u7528\u7c7b\u578b\u660e\u7ec6\uff0c\u603b\u91d1\u989d=\u5404\u884c\u4e4b\u548c\uff0c\u63d0\u4ea4\u6210\u529f\u3002\n- AC2\uff1a\u6bcf\u6761\u660e\u7ec6\u4e0a\u4f20\u7684\u53d1\u7968\u7167\u7247\uff0c\u90e8\u95e8\u4e3b\u7ba1\u5728\u5ba1\u6279\u9875\u5747\u53ef\u67e5\u770b\u5927\u56fe\uff0c\u8986\u76d6\u5ba1\u6279\u6d41\u6bcf\u4e00\u6b65\u3002\n- AC3\uff1a\u8d22\u52a1\u6309\u6761\u4ef6\u5bfc\u51fa\uff0c\u5bfc\u51fa\u6587\u4ef6\u5b57\u6bb5\u5b8c\u6574\u3001\u91d1\u989d\u4e0e\u7cfb\u7edf\u4e00\u81f4\u3001\u53d1\u7968\u7d22\u5f15\u53ef\u8ffd\u6eaf\u3002\n- AC4\uff1a\u62bd\u53d6\u5386\u53f2\u62a5\u9500\u5355\uff0c\u6539\u9020\u540e\u4ecd\u53ef\u67e5\u770b\u660e\u7ec6\u4e0e\u539f\u6709\u91d1\u989d\u3001\u72b6\u6001\uff0c\u65e0\u9519\u4e71\u3001\u65e0\u4e22\u5931\u3002\n- AC5\uff1a\u975e\u6cd5\u8f93\u5165\uff08\u8d1f\u6570\u91d1\u989d\u3001\u7a7a\u660e\u7ec6\u3001\u8d85\u5927/\u975e\u6cd5\u53d1\u7968\uff09\u88ab\u6b63\u786e\u62e6\u622a\u5e76\u63d0\u793a\u3002\n\n## \u4f9d\u8d56\u4e0e\u7ea6\u675f\n- \u4f9d\u8d56\u73b0\u6709\u62a5\u9500\u6a21\u5757\u7684\u6570\u636e\u6a21\u578b\u3001\u5ba1\u6279\u6d41\u5f15\u64ce\u3001\u8d39\u7528\u7c7b\u578b\u5b57\u5178\u3002\n- \u4f9d\u8d56\u6587\u4ef6/\u5bf9\u8c61\u5b58\u50a8\u670d\u52a1\u7528\u4e8e\u53d1\u7968\u5f71\u50cf\u3002\n- \u4f9d\u8d56\u73b0\u6709\u6743\u9650\u4f53\u7cfb\u505a\u53d1\u7968\u8bbf\u95ee\u63a7\u5236\u3002\n- \u7ea6\u675f\uff1a\u4e0d\u6539\u52a8\u5386\u53f2\u6570\u636e\uff1b\u6cbf\u7528\u73b0\u6709\u5ba1\u6279\u94fe\u8def\u4e0e\u7ec8\u7aef\u3002\n\n## \u590d\u6742\u5ea6\u4e0e\u5de5\u4f5c\u91cf\n- **\u590d\u6742\u5ea6**\uff1aL\n- **\u9884\u8ba1\u5de5\u65f6**\uff1a10\u201318 \u4eba\u5929\n- **\u7f6e\u4fe1\u5ea6**\uff1a\u4e2d\uff08\u672a\u63a5\u89e6\u73b0\u6709\u62a5\u9500\u6a21\u5757\u6e90\u7801\u4e0e\u6280\u672f\u6808\uff0c\u6309\u901a\u7528\u62a5\u9500\u7cfb\u7edf\u7ed3\u6784\u4f30\u7b97\uff09\n- **\u62c6\u89e3\u4f9d\u636e**\uff1a\n  - \u6570\u636e\u5c42\uff1a\u62a5\u9500\u4e3b\u8868\u62c6\u51fa\"\u8d39\u7528\u660e\u7ec6\u5b50\u8868\"+\u53d1\u7968\u5f71\u50cf\u8868/\u5bf9\u8c61\u5b58\u50a8\u8fc1\u79fb+\u5386\u53f2\u6570\u636e\u517c\u5bb9 \u2192 3\u20135 \u4eba\u5929\n  - \u903b\u8f91\u5c42\uff1a\u591a\u660e\u7ec6\u6c47\u603b\u3001\u6821\u9a8c\u3001\u5ba1\u6279\u4e0e\u65e7\u5355\u517c\u5bb9\u8bfb\u53d6 \u2192 2\u20133 \u4eba\u5929\n  - \u754c\u9762\u5c42\uff1a\u5458\u5de5\u5efa\u5355\u591a\u660e\u7ec6+\u53d1\u7968\u4e0a\u4f20\u3001\u5ba1\u6279\u7aef\u53d1\u7968\u67e5\u770b \u2192 3\u20135 \u4eba\u5929\n  - \u96c6\u6210/\u5bfc\u51fa\uff1a\u8d22\u52a1\u5bfc\u51fa\uff08\u5f02\u6b65\u3001\u5b57\u6bb5\u6620\u5c04\u3001\u53d1\u7968\u7d22\u5f15\uff09\u2192 2\u20133 \u4eba\u5929\n  - \u975e\u529f\u80fd\uff1a\u9274\u6743\u3001\u5ba1\u8ba1\u3001\u5b58\u50a8\u5bb9\u91cf\u9002\u914d \u2192 0.5\u20132 \u4eba\u5929\n- **\u5173\u952e\u5047\u8bbe**\uff1a\n  - \u2460 \u5df2\u6709\u53ef\u590d\u7528\u7684\u8d39\u7528\u7c7b\u578b\u5b57\u5178\u4e0e\u6587\u4ef6/\u5bf9\u8c61\u4e0a\u4f20\u901a\u9053\uff0c\u65e0\u9700\u65b0\u5efa\u3002\n  - \u2461 \u73b0\u6709\u5ba1\u6279\u5f15\u64ce\u652f\u6301\"\u8be6\u60c5\u5185\u5d4c\u5c55\u793a\u81ea\u5b9a\u4e49\u5b57\u6bb5/\u5f71\u50cf\"\uff0c\u65e0\u9700\u6539\u9020\u5ba1\u6279\u6d41\u5f15\u64ce\u672c\u8eab\u3002\n  - \u2462 \u5386\u53f2\u6570\u636e\u53ef\u91c7\u7528\"\u8bfb\u65f6\u517c\u5bb9\"\uff08\u65e7\u5355\u6620\u5c04\u4e3a\u5355\u6761\u660e\u7ec6\uff09\uff0c\u65e0\u9700\u5f3a\u5236\u6570\u636e\u56de\u586b\u8fc1\u79fb\u3002\n  - \u2463 \u53d1\u7968\u7167\u7247\u4ec5\u505a\u5b58\u50a8+\u5c55\u793a\uff0c\u4e0d\u542b OCR/\u67e5\u9a8c\u3002\n- **\u98ce\u9669/\u4e0d\u786e\u5b9a**\uff1a\n  - \u26a0\ufe0f \u82e5\u5ba1\u6279\u5f15\u64ce\u4e0d\u652f\u6301\u8be6\u60c5\u5185\u5d4c\u5f71\u50cf\uff0c\u9700\u6539\u9020\u6e32\u67d3\u5c42\uff08+2\u20133 \u4eba\u5929\uff09\u3002\n  - \u26a0\ufe0f \u82e5\u5386\u53f2\u6570\u636e\u7ed3\u6784\u4e0e\u65b0\u6a21\u578b\u4e0d\u517c\u5bb9\u9700\u5f3a\u5236\u8fc1\u79fb+\u56de\u6eda\u65b9\u6848\uff08+2\u20134 \u4eba\u5929\uff09\u3002\n  - \u26a0\ufe0f \u53d1\u7968\u5f71\u50cf\u5b58\u50a8\u5bb9\u91cf/\u5e26\u5bbd\u65e0\u73b0\u6210\u8d44\u6e90\u9700\u65b0\u7533\u8bf7\uff08+0.5\u20131 \u4eba\u5929\uff09\u3002\n  - \u26a0\ufe0f \u8d22\u52a1\u5bfc\u51fa\u82e5\u9700\u5bf9\u63a5\u73b0\u6709\u62a5\u8868/ERP \u6a21\u677f\uff08+1\u20132 \u4eba\u5929\uff09\u3002\n\n> \u26a0\ufe0f \u6b64\u8bc4\u4f30\u4e3a Agent \u91cf\u7ea7\u4f30\u7b97\uff0c\u9700\u5f00\u53d1\u590d\u6838\u3002\n\n## \u53d7\u76ca\u5bf9\u8c61\n- **\u5c97\u4f4d/\u89d2\u8272**\uff1a\u63d0\u4ea4\u62a5\u9500\u7684\u5458\u5de5\uff08\u4e3b\uff09\u3001\u90e8\u95e8\u4e3b\u7ba1\uff08\u5ba1\u6279\uff09\u3001\u8d22\u52a1\uff08\u5bfc\u51fa\uff09\u3002\n- **\u4eba\u6570**\uff1aP \u2248 200 \u540d\u62a5\u9500\u63d0\u4ea4\u5458\u5de5\uff08\u26a0\ufe0f Agent \u5047\u8bbe\uff0c\u9700\u4e1a\u52a1\u65b9\u786e\u8ba4\uff0