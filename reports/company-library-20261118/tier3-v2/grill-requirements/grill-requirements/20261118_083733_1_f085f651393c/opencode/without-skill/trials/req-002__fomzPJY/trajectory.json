b\u5982\u4e1a\u52a1\u9700\u8981\u8865\u5145\uff0c\u987b\u8d70\u300c\u4f5c\u5e9f + \u65b0\u63d0\u5355\u300d\u6d41\u7a0b |\n| CR-05 | \u65e7\u7248\u5355\u636e\u540c\u6837\u7eb3\u5165\u8d22\u52a1\u5bfc\u51fa\u8303\u56f4\uff0c\u8d39\u7528\u7c7b\u578b\u6309\u539f\u5b57\u5178\u6620\u5c04\u5230\u65b0\u7248\u5b57\u5178\uff1b\u6620\u5c04\u4e0d\u5230\u7684\u843d\u5165\u300c\u5176\u4ed6\u300d\u5e76\u4fdd\u7559\u539f\u59cb\u7c7b\u578b\u6587\u672c\u4e8e\u5907\u6ce8\u5217 |\n| CR-06 | \u8fc1\u79fb\u5728\u4e1a\u52a1\u4f4e\u5cf0\u671f\uff08\u5efa\u8bae\u5468\u65e5 02:00\u201304:00\uff09\u6267\u884c\uff0c\u9884\u8ba1\u7a97\u53e3 \u2264 2h\uff0c\u671f\u95f4\u53ea\u8bfb\uff08\u7981\u6b62\u63d0\u4ea4\u4e0e\u5ba1\u6279\uff09\u5e76\u63d0\u524d\u516c\u544a |\n\n---\n\n## 8. \u8fb9\u754c\u4e0e\u5f02\u5e38\u573a\u666f\n\n| \u573a\u666f | \u5904\u7406\u89c4\u5219 |\n| --- | --- |\n| 8.1 \u5355\u636e\u91d1\u989d\u4e0e\u660e\u7ec6\u5408\u8ba1\u4e0d\u4e00\u81f4\uff08\u5e76\u53d1\u4fee\u6539/\u810f\u6570\u636e\uff09 | \u4ee5\u660e\u7ec6\u5408\u8ba1\u4e3a\u51c6\uff0c\u4fdd\u5b58\u65f6\u670d\u52a1\u7aef\u91cd\u7b97\u5e76\u8986\u76d6\uff1b\u5ba1\u6279\u9875\u5c55\u793a\u670d\u52a1\u7aef\u8ba1\u7b97\u503c |\n| 8.2 \u591a\u5e01\u79cd | \u672c\u671f\u652f\u6301 CNY\uff1b\u82e5\u5df2\u6709\u5386\u53f2\u5916\u5e01\u5355\u636e\uff0c\u6309\u539f\u5355\u5e01\u79cd\u4e0e\u6c47\u7387\u5b57\u6bb5\u5c55\u793a\uff0c\u5bfc\u51fa\u4fdd\u7559\u539f\u59cb\u5e01\u79cd + \u6298\u7b97 CNY \u91d1\u989d\uff08\u6298\u7b97\u7387\u53d6\u62a5\u9500\u5f53\u6708\u516c\u53f8\u6c47\u7387\u8868\uff09 |\n| 8.3 \u540c\u4e00\u53d1\u7968\u88ab\u91cd\u590d\u4e0a\u4f20 | \u672c\u671f\u4e0d\u505a\u53d1\u7968\u53f7\u67e5\u91cd\uff08Out of Scope\uff09\uff0c\u4f46\u5728\u9644\u4ef6\u533a\u663e\u793a\u6587\u4ef6\u540d\u91cd\u590d\u63d0\u793a |\n| 8.4 \u4e0a\u4f20\u4e2d\u63d0\u4ea4 / \u63d0\u4ea4\u77ac\u95f4\u9644\u4ef6\u5931\u8d25 | \u63d0\u4ea4\u524d\u9501\u5b9a\uff0c\u5b58\u5728\u672a\u4e0a\u4f20\u5b8c\u6210\u7684\u9644\u4ef6\u65f6\u7981