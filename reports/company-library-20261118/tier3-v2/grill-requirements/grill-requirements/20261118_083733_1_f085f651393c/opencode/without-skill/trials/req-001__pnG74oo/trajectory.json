f4 | \u65f6\u95f4 | \u662f | \u683c\u5f0f HH:mm\uff1b\u7cbe\u786e\u5230\u5206\u949f |\n| \u7ed3\u675f\u65f6\u95f4 | \u65f6\u95f4 | \u662f | \u683c\u5f0f HH:mm\uff1b\u5fc5\u987b\u665a\u4e8e\u5f00\u59cb\u65f6\u95f4 |\n| \u52a0\u73ed\u65f6\u957f | \u6570\u503c | \u7cfb\u7edf | \u81ea\u52a8\u8ba1\u7b97\uff0c\u53ea\u8bfb\uff0c\u5355\u4f4d\u5c0f\u65f6 |\n| \u52a0\u73ed\u4e8b\u7531 | \u591a\u884c\u6587\u672c | \u5426 | \u2264 200 \u5b57\uff0c\u8d85\u51fa\u7981\u6b62\u8f93\u5165\u5e76\u63d0\u793a |\n\n**\u8f93\u5165 / \u5904\u7406 / \u8f93\u51fa**\n- \u8f93\u5165\uff1a\u4e0a\u8ff0\u5b57\u6bb5\u3002\n- \u5904\u7406\uff1a\u6821\u9a8c\u5fc5\u586b\u4e0e\u89c4\u5219 \u2192 \u8ba1\u7b97\u65f6\u957f \u2192 \u5224\u65ad\u8282\u5047\u65e5 \u2192 \u5224\u65ad\u662f\u5426\u9700\u8981\u603b\u76d1\u8282\u70b9 \u2192 \u751f\u6210\u7533\u8bf7\u5355\uff08\u72b6\u6001 = \u5f85\u5ba1\u6279\uff09\u2192 \u5199\u5165\u7559\u75d5\u3002\n- \u8f93\u51fa\uff1a\u63d0\u4ea4\u6210\u529f\u63d0\u793a\uff0c\u751f\u6210\u5355\u53f7\uff0c\u8fdb\u5165\u5ba1\u6279\u6d41\u3002\n\n**\u5f02\u5e38\u4e0e\u63d0\u793a**\n| \u573a\u666f | \u63d0\u793a\u6587\u6848 |\n|---|---|\n| \u7ed3\u675f\u65f6\u95f4 \u2264 \u5f00\u59cb\u65f6\u95f4 | \u300c\u7ed3\u675f\u65f6\u95f4\u5fc5\u987b\u665a\u4e8e\u5f00\u59cb\u65f6\u95f4\u300d |\n| \u52a0\u73ed\u65e5\u671f\u4e0e\u5df2\u6709\u7533\u8bf7\u91cd\u590d | \u300c\u8be5\u65e5\u671f\u5df2\u5b58\u5728\u52a0\u73ed\u7533\u8bf7\uff0c\u662f\u5426\u7ee7\u7eed\u63d0\u4ea4\uff1f\u300d\uff08\u5141\u8bb8\u63d0\u4ea4\u5e76\u6807\u8bb0\u91cd\u590d\uff09 |\n| \u4e8b\u7531\u8d85\u8fc7 200 \u5b57 | \u300c\u52a0\u73ed\u4e8b\u7531\u4e0d\u80fd\u8d85\u8fc7 200 \u5b57\u300d |\n| \u5fc5\u586b\u9879\u7f3a\u5931 | \u5b9a\u4f4d\u5230\u5177\u4f53\u5b57\u6bb5\u5e76\u63d0\u793a\u300c\u8bf7\u586b\u5199XXX\u300d |\n\n---\n\n### F-02 \u52a0\u73ed\u65f6\u957f\u81ea\u52a8\u8ba1\u7b97\n**\u89c4\u5219**\n- BR-T01\uff1a\u52a0\u73ed\u65f6\u957f =\uff08\u7ed3\u675f\u65f6\u95f4 \u2212 \u5f00\u59cb\u65f6\u95f4\uff09\uff0c\u5355\u4f4d\u5c0f\u65f6\uff0c\u56db\u820d\u4e94\u5165\u4fdd\u7559 1 \u4f4d\u5c0f\u6570\u3002\n- BR-T02\uff1a\u7ed3\u675f\u65f6\u95f4\u65e9\u4e8e\u5f00\u59cb\u65f6\u95f4\u89c6\u4e3a\u8de8\u5929\u52a0\u73ed\uff08\u5982 20:00\u201302:00\uff09\uff0c\u65f6\u957f\u6309 `(24:00 \u2212 \u5f00\u59cb) + \u7ed3\u675f` \u8ba1\u7b97\uff0c\u52a0\u73ed\u65e5\u671f\u8bb0\u4e3a\u5f00\u59cb\u65f6\u95f4\u6240\u5728\u65e5\u671f\u3002\n- BR-T03\uff1a\u65f6\u957f\u7531\u7cfb\u7edf\u8ba1\u7b97\u5e76\u56fa\u5316\u5230\u7533\u8bf7\u5355\uff0c\u7528\u6237\u4e0d\u53ef\u624b\u5de5\u4fee\u6539\u3002\n- BR-T04\uff1a\u65f6\u957f\u4e3a\u5ba1\u6279\u5206\u652f\u5224\u65ad\u4f9d\u636e\uff08>4h \u89e6\u53d1\u603b\u76d1\u5ba1\u6279\uff09\u3002\n\n**\u793a\u4f8b**\n| \u5f00\u59cb | \u7ed3\u675f | \u65f6\u957f |\n|---|---|---|\n| 18:00 | 20:30 | 2.5 |\n| 09:00 | 12:00 | 3.0 |\n| 09:00 | 13:00 | 4.0\uff08\u4e0d\u89e6\u53d1\u603b\u76d1\uff09 |\n| 09:00 | 13:30 | 4.5\uff08\u89e6\u53d1\u603b\u76d1\uff09 |\n| 20:00 | 02:00 | 6.0\uff08\u8de8\u5929\uff09 |\n\n---\n\n### F-03 \u7f16\u8f91\u4e0e\u64a4\u56de\u7533\u8bf7\n- BR-E01\uff1a\u4ec5\u72b6\u6001\u4e3a\u300c\u5f85\u5ba1\u6279\u300d\u4e14\u5f53\u524d\u5ba1\u6279\u8282\u70b9\u5c1a\u672a\u4ea7\u751f\u4efb\u4f55\u5ba1\u6279\u8bb0\u5f55\u7684\u7533\u8bf7\u53ef\u7f16\u8f91\u3002\n- BR-E02\uff1a\u7f16\u8f91\u540e\u539f\u5ba1\u6279\u8bb0\u5f55\u6e05\u7a7a\uff0c\u6d41\u7a0b\u4ece\u5934\u5f00\u59cb\uff08\u91cd\u65b0\u81f3\u90e8\u95e8\u4e3b\u7ba1\uff09\uff0c\u5e76\u5728\u7559\u75d5\u4e2d\u4fdd\u7559\u4fee\u6539\u524d\u540e\u503c\u3002\n- BR-E03\uff1a\u72b6\u6001\u4e3a\u300c\u5df2\u9a73\u56de\u300d\u7684\u7533\u8bf7\u53ef\u7f16\u8f91\u540e\u91cd\u65b0\u63d0\u4ea4\uff0c\u4e5f\u53ef\u653e\u5f03\u3002\n- BR-E04\uff1a\u72b6\u6001\u4e3a\u300c\u5df2\u901a\u8fc7\u300d\u7684\u7533\u8bf7\u4e0d\u53ef\u7f16\u8f91\u3001\u4e0d\u53ef\u64a4\u56de\uff1b\u5982\u9700\u66f4\u6b63\u987b\u7531 HR \u8d70\u7ebf\u4e0b\u66f4\u6b63\u6d41\u7a0b\uff08\u672c\u671f\u4e0d\u652f\u6301\u7ebf\u4e0a\u64a4\u9500\uff09\u3002\n- BR-E05\uff1a\u64a4\u56de\u540e\u72b6\u6001\u7f6e\u4e3a\u300c\u5df2\u64a4\u56de\u300d\uff0c\u4e0d\u518d\u8fdb\u5165\u7edf\u8ba1\u6c47\u603b\u3002\n\n---\n\n### F-04 \u6cd5\u5b9a\u8282\u5047\u65e5\u81ea\u52a8\u6807\u8bb0\n- BR-H01\uff1a\u7cfb\u7edf\u7ef4\u62a4\u6cd5\u5b9a\u8282\u5047\u65e5\u65e5\u5386\uff08\u542b\u8c03\u4f11\u5de5\u4f5c\u65e5\uff09\uff0c\u652f\u6301 HR \u5e74\u5ea6\u7ef4\u62a4\u3002\n- BR-H02\uff1a\u52a0\u73ed\u65e5\u671f\u547d\u4e2d\u6cd5\u5b9a\u8282\u5047\u65e5\uff0c\u5219\u81ea\u52a8\u6253\u6807\u300c\u6cd5\u5b9a\u8282\u5047\u65e5\u300d\uff0c\u6807\u8bb0\u53ea\u8bfb\u3001\u7528\u6237\u4e0d\u53ef\u589e\u5220\u3002\n- BR-H03\uff1a\u8c03\u4f11\u4e0a\u73ed\u65e5\u4e0d\u6807\u8bb0\u4e3a\u6cd5\u5b9a\u8282\u5047\u65e5\u3002\n- BR-H04\uff1a\u8de8\u5929\u52a0\u73ed\u6309\u5f00\u59cb\u65f6\u95f4\u6240\u5728\u65e5\u671f\u5224\u5b9a\u6807\u8bb0\u3002\n- BR-H05\uff1aHR \u6c47\u603b\u4e0e\u5bfc\u51fa\u9700\u5355\u72ec\u5217\u793a\u6cd5\u5b9a\u8282\u5047\u65e5\u52a0\u73ed\u65f6\u957f\uff0c\u4fbf\u4e8e\u6309\u6cd5\u89c4\u500d\u6570\u6838\u7b97\u3002\n\n---\n\n### F-05 \u90e8\u95e8\u4e3b\u7ba1\u5ba1\u6279\n- \u64cd\u4f5c\u9879\uff1a**\u540c\u610f** / **\u9a73\u56de**\u3002\n- \u9a73\u56de\u5fc5\u987b\u586b\u5199\u539f\u56e0\uff0c\u539f\u56e0\u5fc5\u586b\u4e14 \u2264 200 \u5b57\uff0c\u5426\u5219\u4e0d\u5141\u8bb8\u63d0\u4ea4\u3002\n- \u540c\u610f\u65f6\u5ba1\u6279\u610f\u89c1\u9009\u586b\uff08\u2264 200 \u5b57\uff09\u3002\n- \u5ba1\u6279\u540e\u7533\u8bf7\u72b6\u6001\u66f4\u65b0\uff0c\u5e76\u901a\u77e5\u7533\u8bf7\u4eba\u3002\n- BR-A01\uff1a\u4e3b\u7ba1\u8d85\u8fc7 N \u5929\uff08\u9ed8\u8ba4 3 \u5929\uff09\u672a\u5904\u7406\uff0c\u7cfb\u7edf\u63d0\u9192\u4e00\u6b21\uff1b\u4e0d\u81ea\u52a8\u901a\u8fc7\u3002\n- BR-A02\uff1a\u4e3b\u7ba1\u4e0d\u53ef\u5ba1\u6279\u975e\u672c\u90e8\u95e8\u7533\u8bf7\u3002\n\n---\n\n### F-06 \u603b\u76d1\u989d\u5916\u5ba1\u6279\uff08\u6761\u4ef6\u5206\u652f\uff09\n- BR-A03\uff1a\u5f53 `\u52a0\u73ed\u65f6\u957f > 4 \u5c0f\u65f6` \u65f6\uff0c\u4e3b\u7ba1\u540c\u610f\u540e\u6d41\u7a0b\u6d41\u8f6c\u81f3\u90e8\u95e8\u603b\u76d1\u8282\u70b9\uff1b\u603b\u76d1\u540c\u610f \u2192 \u5df2\u901a\u8fc7\uff0c\u603b\u76d1\u9a73\u56de \u2192 \u5df2\u9a73\u56de\uff08\u539f\u56e0\u5fc5\u586b\uff09\u3002\n- BR-A04\uff1a`\u52a0\u73ed\u65f6\u957f \u2264 4 \u5c0f\u65f6` \u65f6\u4e0d\u751f\u6210\u603b\u76d1\u8282\u70b9\uff0c\u4e3b\u7ba1\u540c\u610f\u5373\u4e3a\u5df2\u901a\u8fc7\u3002\n- BR-A05\uff1a\u5206\u652f\u5224\u65ad\u5728\u7533\u8bf7\u63d0\u4ea4\u65f6\u786e\u5b9a\u5e76\u8bb0\u5f55\uff0c\u7f16\u8f91\u540e\u91cd\u7b97\u3002\n- BR-A06\uff1a\u82e5\u516c\u53f8\u672a\u914d\u7f6e\u90e8\u95e8\u603b\u76d1\uff0c\u5219\u8be5\u8282\u70b9\u81ea\u52a8\u8df3\u8fc7\u5e76\u8bb0\u5f55\u300c\u65e0\u603b\u76d1\uff0c\u8282\u70b9\u8df3\u8fc7\u300d\u7559\u75d5\uff08\u662f\u5426\u5141\u8bb8\u8df3\u8fc7\u9700\u4e1a\u52a1\u786e\u8ba4\uff0c\u89c1 \u00a79\uff09\u3002\n\n---\n\n### F-07 \u5ba1\u6279\u7559\u75d5\n\u6bcf\u6761\u7533\u8bf7\u7684\u64cd\u4f5c\u65e5\u5fd7\u987b\u5305\u542b\uff1a\u64cd\u4f5c\u65f6\u95f4\u3001\u64cd\u4f5c\u4eba\uff08\u59d3\u540d+\u5de5\u53f7\uff09\u3001\u64cd\u4f5c\u52a8\u4f5c\uff08\u63d0\u4ea4/\u7f16\u8f91/\u64a4\u56de/\u540c\u610f/\u9a73\u56de\uff09\u3001\u5ba1\u6279\u610f\u89c1\u6216\u9a73\u56de\u539f\u56e0\u3001\u52a0\u73ed\u65f6\u957f\u3002\u65e5\u5fd7\u53ea\u8bfb\u3001\u4e0d\u53ef\u5220\u9664\uff0c\u5458\u5de5/\u4e3b\u7ba1/HR \u5728\u8be6\u60c5\u9875\u53ef\u67e5\u770b\u6d41\u7a0b\u8f68\u8ff9\u3002\n\n---\n\n### F-08 \u5458\u5de5\u7aef\u5217\u8868\u4e0e\u7b5b\u9009\n**\u5217\u8868\u5b57\u6bb5**\uff1a\u52a0\u73ed\u65e5\u671f\u3001\u52a0\u73ed\u65f6\u957f\u3001\u72b6\u6001\uff08\u5f85\u5ba1\u6279 / \u5df2\u901a\u8fc7 / \u5df2\u9a73\u56de\uff09\u3001\u6cd5\u5b9a\u8282\u5047\u65e5\u6807\u8bb0\u3001\u5f53\u524d\u5904\u7406\u4eba\u3002\n**\u7b5b\u9009\u6761\u4ef6**\uff1a\n- \u6309\u72b6\u6001\uff1a\u5355\u9009/\u591a\u9009\uff08\u5f85\u5ba1\u6279\u3001\u5df2\u901a\u8fc7\u3001\u5df2\u9a73\u56de\u3001\u5df2\u64a4\u56de\uff09\uff1b\n- \u6309\u6708\u4efd\uff1a\u5e74-\u6708\u9009\u62e9\u5668\uff0c\u9ed8\u8ba4\u5f53\u6708\uff1b\n- \u652f\u6301\u6309\u52a0\u73ed\u65e5\u671f\u5012\u5e8f\u6392\u5217\uff0c\u5206\u9875\u5c55\u793a\uff08\u9ed8\u8ba4 20 \u6761/\u9875\uff09\u3002\n**\u9ed8\u8ba4\u8303\u56f4**\uff1a\u4ec5\u663e\u793a\u672c\u4eba\u7533\u8bf7\u3002\n\n---\n\n### F-09 \u4e3b\u7ba1\u7aef\u5f85\u5ba1\u6279\u5217\u8868\n- \u300c\u5f85\u6211\u5ba1\u6279\u300d\u5217\u8868\uff08\u9ed8\u8ba4\u89c6\u56fe\uff09\uff0c\u5b57\u6bb5\u542b\u7533\u8bf7\u4eba\u3001\u90e8\u95e8\u3001\u52a0\u73ed\u65e5\u671f\u3001\u65f6\u957f\u3001\u63d0\u4ea4\u65f6\u95f4\u3001\u6cd5\u5b9a\u8282\u5047\u65e5\u6807\u8bb0\uff1b\n- \u652f\u6301\u6309\u90e8\u95e8\u5185\u5458\u5de5\u59d3\u540d/\u5de5\u53f7\u641c\u7d22\u3001\u6309\u6708\u4efd\u7b5b\u9009\uff1b\n- \u652f\u6301\u6279\u91cf\u540c\u610f\uff08\u672c\u671f\u53ef\u9009\uff0cP2\uff09\uff0c\u6279\u91cf\u9a73\u56de\u5fc5\u987b\u9010\u6761\u586b\u5199\u539f\u56e0\u3002\n\n---\n\n### F-10 HR \u6708\u5ea6\u6c47\u603b\u4e0e\u5bfc\u51fa\n- \u67e5\u8be2\u6761\u4ef6\uff1a\u6708\u4efd\uff08\u5fc5\u586b\uff09\u3001\u90e8\u95e8\u3001\u5458\u5de5\u3001\u662f\u5426\u6cd5\u5b9a\u8282\u5047\u65e5\uff1b\n- \u6c47\u603b\u7ef4\u5ea6\uff1a\u6309\u5458\u5de5 \u00d7 \u6708\u4efd\u6c47\u603b\u52a0\u73ed\u6b21\u6570\u3001\u52a0\u73ed\u603b\u65f6\u957f\u3001\u6cd5\u5b9a\u8282\u5047\u65e5\u52a0\u73ed\u65f6\u957f\uff1b\u6309\u90e8\u95e8\u6c47\u603b\u603b\u65f6\u957f\u4e0e\u4eba\u6570\uff1b\n- \u660e\u7ec6\u53ef\u4e0b\u94bb\u67e5\u770b\uff1b\n- \u5bfc\u51fa\uff1aExcel\uff08.xlsx\uff09\uff0c\u5b57\u6bb5\u5305\u542b \u5de5\u53f7\u3001\u59d3\u540d\u3001\u90e8\u95e8\u3001\u6708\u4efd\u3001\u52a0\u73ed\u6b21\u6570\u3001\u52a0\u73ed\u603b\u65f6\u957f\u3001\u6cd5\u5b9a\u8282\u5047\u65e5\u52a0\u73ed\u65f6\u957f\u3001\u5404\u72b6\u6001\u6570\u91cf\uff1b\n- BR-X01\uff1a\u4ec5\u7edf\u8ba1\u72b6\u6001\u4e3a\u300c\u5df2\u901a\u8fc7\u300d\u7684\u7533\u8bf7\uff1b\n- BR-X02\uff1a\u5bfc\u51fa\u64cd\u4f5c\u9700\u5199\u5165\u64cd\u4f5c\u65e5\u5fd7\uff08\u5bfc\u51fa\u4eba\u3001\u65f6\u95f4\u3001\u67e5\u8be2\u6761\u4ef6\uff09\uff1b\n- BR-X03\uff1a\u5355\u6b21\u5bfc\u51fa\u4e0a\u9650 50,000 \u884c\uff0c\u8d85\u51fa\u63d0\u793a\u6309\u6708\u5206\u6279\u5bfc\u51fa\u3002\n\n---\n\n### F-11 \u901a\u77e5\n- \u63d0\u4ea4\u6210\u529f \u2192 \u901a\u77e5\u5f53\u524d\u5ba1\u6279\u4eba\uff1b\n- \u5ba1\u6279\u901a\u8fc7/\u9a73\u56de \u2192 \u901a\u77e5\u7533\u8bf7\u4eba\uff1b\n- \u6d41\u8f6c\u81f3\u603b\u76d1 \u2192 \u901a\u77e5\u603b\u76d1\uff1b\n- \u6e20\u9053\uff1a\u590d\u7528\u7cfb\u7edf\u73b0\u6709\u7ad9\u5185\u6d88\u606f + \u4f01\u4e1a\u5fae\u4fe1/\u90ae\u4ef6\uff08\u4ee5\u73b0\u6709\u80fd\u529b\u4e3a\u51c6\uff09\u3002\n\n---\n\n## 6. \u4e1a\u52a1\u6d41\u7a0b\n\n```mermaid\ngraph TD\n    A[\u5458\u5de5\u586b\u5199\u52a0\u73ed\u7533\u8bf7] --> B[\u7cfb\u7edf\u8ba1\u7b97\u65f6\u957f/\u5224\u5b9a\u8282\u5047\u65e5]\n    B --> C{\u65f6\u957f > 4 \u5c0f\u65f6?}\n    C -->|\u5426| D[\u90e8\u95e8\u4e3b\u7ba1\u5ba1\u6279]\n    C -->|\u662f| D\n    D -->|\u9a73\u56de \u539f\u56e0\u5fc5\u586b| E[\u5df2\u9a73\u56de]\n    E --> A\n    D -->|\u540c\u610f| F{\u662f\u5426\u9700\u603b\u76d1\u5ba1\u6279}\n    F -->|\u5426| G[\u5df2\u901a\u8fc7]\n    F -->|\u662f| H[\u90e8\u95e8\u603b\u76d1\u5ba1\u6279]\n    H -->|\u540c\u610f| G\n    H -->|\u9a73\u56de \u539f\u56e0\u5fc5\u586b| E\n    G --> I[HR \u6708\u5ea6\u6c47\u603b/\u5bfc\u51fa]\n```\n\n**\u72b6\u6001\u6d41\u8f6c**\n| \u5f53\u524d\u72b6\u6001 | \u52a8\u4f5c | \u64cd\u4f5c\u4eba | \u76ee\u6807\u72b6\u6001 |\n|---|---|---|---|\n| \u8349\u7a3f\uff08\u5982\u6709\uff09 | \u63d0\u4ea4 | \u5458\u5de5 | \u5f85\u5ba1\u6279\uff08\u4e3b\u7ba1\u8282\u70b9\uff09 |\n| \u5f85\u5ba1\u6279 | \u540c\u610f\uff08\u65f6\u957f \u22644h\uff09 | \u4e3b\u7ba1 | \u5df2\u901a\u8fc7 |\n| \u5f85\u5ba1\u6279 | \u540c\u610f\uff08\u65f6\u957f >4h\uff09 | \u4e3b\u7ba1 | \u5f85\u5ba1\u6279\uff08\u603b\u76d1\u8282\u70b9\uff09 |\n| \u5f85\u5ba1\u627