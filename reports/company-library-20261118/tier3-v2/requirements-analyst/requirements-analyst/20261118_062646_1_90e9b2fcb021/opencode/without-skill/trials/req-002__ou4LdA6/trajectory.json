6570\u636e\uff0c\u67e5\u770b\u53d1\u7968\u539f\u56fe | \u5168\u516c\u53f8\u8303\u56f4\u53ea\u8bfb + \u5bfc\u51fa\u6743\u9650 |\n| \u7cfb\u7edf\u7ba1\u7406\u5458 | \u7ef4\u62a4\u8d39\u7528\u7c7b\u578b\u5b57\u5178\u3001\u5bfc\u51fa\u6743\u9650\u914d\u7f6e | \u540e\u53f0\u914d\u7f6e\u6743\u9650 |\n\n## 5. \u4e1a\u52a1\u672f\u8bed\u4e0e\u6570\u636e\u6a21\u578b\n\n### 5.1 \u5173\u952e\u7ed3\u6784\u8c03\u6574\n\u539f\u6a21\u578b\uff1a`\u62a5\u9500\u5355(1) \u2014\u2014 \u8d39\u7528\u7c7b\u578b(1)`\n\u65b0\u6a21\u578b\uff1a\n\n```\n\u62a5\u9500\u5355 ExpenseReport (1)\n \u251c\u2500\u2500 \u7533\u8bf7\u4eba / \u90e8\u95e8 / \u62a5\u9500\u671f\u95f4 / \u4e8b\u7531 / \u5355\u636e\u72b6\u6001 / \u5408\u8ba1\u91d1\u989d\n \u251c\u2500\u2500 \u8d39\u7528\u660e\u7ec6 ExpenseItem (N)\n \u2502     \u251c\u2500\u2500 \u8d39\u7528\u7c7b\u578b\uff08\u5b57\u5178\uff1a\u6253\u8f66\u8d39\u3001\u9910\u8d39\u3001\u4f4f\u5bbf\u8d39\u3001\u4ea4\u901a\u8d39\u3001\u5176\u4ed6\u2026\uff09\n \u2502     \u251c\u2500\u2500 \u91d1\u989d\uff08\u5fc5\u586b\uff0c>0\uff0c\u4e24\u4f4d\u5c0f\u6570\uff09\n \u2502     \u251c\u2500\u2500 \u53d1\u751f\u65e5\u671f\uff08\u5fc5\u586b\uff09\n \u2502     \u251c\u2500\u2500 \u8bf4\u660e/\u5907\u6ce8\uff08\u9009\u586b\uff09\n \u2502     \u2514\u2500\u2500 \u53d1\u7968\u9644\u4ef6 Attachment (0..N)\n \u2514\u2500\u2500 \u5ba1\u6279\u8bb0\u5f55 ApprovalLog (N)\n```\n\n- **\u5408\u8ba1\u91d1\u989d**\u7531\u7cfb\u7edf\u6309\u660e\u7ec6\u884c\u81ea\u52a8\u6c47\u603b\uff0c\u4e0d\u5141\u8bb8\u624b\u5de5\u586b\u5199\uff0c\u4fdd\u8bc1\u4e0e\u660e\u7ec6\u4e00\u81f4\u3002\n- **\u8d39\u7528\u7c7b\u578b\u5b57\u5178**\u6539\u4e3a\u540e\u53f0\u53ef\u914d\u7f6e\u9879\uff0c\u652f\u6301\u65b0\u589e/\u505c\u7528\uff0c\u4e0d\u5f71\u54cd\u5386\u53f2\u6570\u636e\u3002\n\n## 6. \u529f\u80fd\u9700\u6c42\n\n### FR-1 \u591a\u8d39\u7528\u7c7b\u578b\u586b\u62a5\n| \u9879 | \u63cf\u8ff0 |\n| --- | --- |\n| \u4f18\u5148\u7ea7 | P0 |\n| \u63cf\u8ff0 | \u5458\u5de5\u65b0\u5efa\u62a5\u9500\u5355\u65f6\uff0c\u53ef\u6dfb\u52a0\u591a\u6761\u8d39\u7528\u660e\u7ec6\uff0c\u6bcf\u6761\u72ec\u7acb\u9009\u62e9\u8d39\u7528\u7c7b\u578b\u3001\u586b\u5199\u91d1\u989d\u4e0e\u53d1\u751f\u65e5\u671f\u3002 |\n| \u89c4\u5219 | 1. \u660e\u7ec6\u884c\u6570\u4e0a\u9650 50 \u884c\uff1b\u81f3\u5c11 1 \u884c\u65b9\u53ef\u63d0\u4ea4\u3002<br>2. \u540c\u4e00\u5355\u636e\u5185\u5141\u8bb8\u51fa\u73b0\u91cd\u590d\u8d39\u7528\u7c7b\u578b\u3002<br>3. \u91d1\u989d\u5408\u8ba1\u81ea\u52a8\u8ba1\u7b97\u5e76\u5b9e\u65f6\u5c55\u793a\u3002<br>4. \u660e\u7ec6\u884c\u652f\u6301\u65b0\u589e\u3001\u7f16\u8f91\u3001\u5220\u9664\uff1b\u5df2\u63d0\u4ea4\u5355\u636e\u7684\u660e\u7ec6\u4e0d\u53ef\u7f16\u8f91\uff08\u9a73\u56de\u540e\u53ef\u7f16\u8f91\uff09\u3002<br>5. \u53d1\u751f\u65e5\u671f\u4e0d\u5f97\u665a\u4e8e\u63d0\u4ea4\u65e5\u671f\uff0c\u4e0d\u5f97\u65e9\u4e8e\u6240\u9009\u62a5\u9500\u671f\u95f4\u8d77\u59cb\u65e5\u3002 |\n| \u754c\u9762 | \u5355\u636e\u4e3b\u4f53\u4fe1\u606f\u533a + \u53ef\u589e\u5220\u884c\u7684\u660e\u7ec6\u8868\u683c + \u5408\u8ba1\u91d1\u989d\u680f |\n\n### FR-2 \u53d1\u7968\u9644\u4ef6\u4e0a\u4f20\u4e0e\u7ba1\u7406\n| \u9879 | \u63cf\u8ff0 |\n| --- | --- |\n| \u4f18\u5148\u7ea7 | P0 |\n| \u63cf\u8ff0 | \u6bcf\u6761\u8d39\u7528\u660e\u7ec6\u53ef\u4e0a\u4f20 0..N \u5f20\u53d1\u7968\u7167\u7247/\u626b\u63cf\u4ef6\u3002 |\n| \u89c4\u5219 | 1. \u652f\u6301\u683c\u5f0f\uff1ajpg\u3001jpeg\u3001png\u3001pdf\uff1b\u5355\u6587\u4ef6 \u226410 MB\uff0c\u5355\u636e\u9644\u4ef6\u603b\u6570 \u226420 \u4e2a\u3002<br>2. \u9644\u4ef6\u4e0e\u8d39\u7528\u660e\u7ec6\u884c\u7ed1\u5b9a\uff1b\u5220\u9664\u660e\u7ec6\u884c\u65f6\u5176\u9644\u4ef6\u4e00\u5e76\u79fb\u9664\uff08\u63d0\u4ea4\u540e\u5220\u9664\u8d70\u8f6f\u5220\u9664\u7559\u75d5\uff09\u3002<br>3. \u652f\u6301\u62cd\u7167\u4e0a\u4f20\uff08\u79fb\u52a8\u7aef\uff09\u4e0e\u672c\u5730\u6587\u4ef6\u4e0a\u4f20\uff08PC\uff09\u3002<br>4. \u4e0a\u4f20\u4e2d\u663e\u793a\u8fdb\u5ea6\uff0c\u5931\u8d25\u53ef\u91cd\u8bd5\uff1b\u6587\u4ef6\u547d\u540d\u4e0e\u5927\u5c0f\u9700\u5165\u5e93\u4fdd\u5b58\u3002 |\n\n### FR-3 \u63d0\u4ea4\u4e0e\u6821\u9a8c\n| \u9879 | \u63cf\u8ff0 |\n| --- | --- |\n| \u4f18\u5148\u7ea7 | P0 |\n| \u63cf\u8ff0 | \u5458\u5de5\u63d0\u4ea4\u62a5\u9500\u5355\uff0c\u7cfb\u7edf\u6267\u884c\u5b8c\u6574\u6027\u6821\u9a8c\u540e\u8fdb\u5165\u5ba1\u6279\u6d41\u3002 |\n| \u89c4\u5219 | 1. \u5fc5\u586b\u6821\u9a8c\uff1a\u62a5\u9500\u4e8b\u7531\u3001\u62a5\u9500\u671f\u95f4\u3001\u81f3\u5c11 1 \u6761\u5b8c\u6574\u660e\u7ec6\u3002<br>2. \u91d1\u989d\u6821\u9a8c\uff1a\u5355\u6761 >0\u3001\u5408\u8ba1 >0\u3001\u5c0f\u6570\u4f4d \u22642\u3002<br>3. \u6821\u9a8c\u4e0d\u901a\u8fc7\u65f6\u5b9a\u4f4d\u5230\u5177\u4f53\u884c\u5e76\u63d0\u793a\uff0c\u4e0d\u521b\u5efa\u5ba1\u6279\u4efb\u52a1\u3002<br>4. \u63d0\u4ea4\u6210\u529f\u540e\u5355\u636e\u72b6\u6001\u7f6e\u4e3a\u300c\u5ba1\u6279\u4e2d\u300d\uff0c\u660e\u7ec6\u4e0e\u91d1\u989d\u9501\u5b9a\u3002 |\n\n### FR-4 \u5ba1\u6279\u8be6\u60c5\u5c55\u793a\uff08\u542b\u53d1\u7968\uff09\n| \u9879 | \u63cf\u8ff0 |\n| --- | --- |\n| \u4f18\u5148\u7ea7 | P0 |\n| \u63cf\u8ff0 | \u90e8\u95e8\u4e3b\u7ba1\u5728\u5f85\u529e\u5217\u8868\u6253\u5f00\u5355\u636e\uff0c\u53ef\u89c1\u5b8c\u6574\u660e\u7ec6\u4e0e\u5168\u90e8\u53d1\u7968\u7167\u7247\u3002 |\n| \u89c4\u5219 | 1. \u8be6\u60c5\u9875\u6309\u8d39\u7528\u7c7b\u578b\u5206\u884c\u5c55\u793a\uff1a\u7c7b\u578b\u3001\u91d1\u989d\u3001\u53d1\u751f\u65e5\u671f\u3001\u8bf4\u660e\u3001\u8be5\u884c\u7684\u53d1\u7968\u7f29\u7565\u56fe\u3002<br>2. \u7f29\u7565\u56fe\u53ef\u70b9\u51fb\u653e\u5927\u9884\u89c8\uff0c\u652f\u6301\u5de6\u53f3\u5207\u6362\u3001\u65cb\u8f6c\u3001\u4e0b\u8f7d\u3001\u5728\u65b0\u7a97\u53e3\u6253\u5f00 PDF\u3002<br>3. \u5c55\u793a\u5355\u636e\u5408\u8ba1\u91d1\u989d\u3001\u7533\u8bf7\u4eba\u3001\u90e8\u95e8\u3001\u4e8b\u7531\u3001\u5386\u53f2\u5ba1\u6279\u8bb0\u5f55\u3002<br>4. \u5ba1\u6279\u64cd\u4f5c\uff1a\u901a\u8fc7\u3001\u9a73\u56de\uff08\u9a73\u56de\u5fc5\u987b\u586b\u5199\u610f\u89c1\uff0c\u53ef\u6307\u5b9a\u9a73\u56de\u5230\u300c\u5458\u5de5\u4fee\u6539\u300d\u8282\u70b9\uff09\u3002<br>5. \u9a73\u56de\u540e\u5355\u636e\u56de\u5230\u300c\u5df2\u9a73\u56de\u300d\u72b6\u6001\uff0c\u5458\u5de5\u53ef\u4fee\u6539\u660e\u7ec6\u4e0e\u9644\u4ef6\u540e\u91cd\u65b0\u63d0\u4ea4\uff0c\u4fdd\u7559\u4e0a\u4e00\u7248\u5ba1\u6279\u610f\u89c1\u3002 |\n\n### FR-5 \u8d22\u52a1\u5bfc\u51fa\n| \u9879 | \u63cf\u8ff0 |\n| --- | --- |\n| \u4f18\u5148\u7ea7 | P0 |\n| \u63cf\u8ff0 | \u8d22\u52a1\u5728\u62a5\u9500\u67e5\u8be2\u5217\u8868\u6309\u6761\u4ef6\u7b5b\u9009\u540e\u5bfc\u51fa Excel\u3002 |\n| \u89c4\u5219 | 1. \u7b5b\u9009\u6761\u4ef6\uff1a\u63d0\u4ea4\u65e5\u671f\u533a\u95f4\u3001\u62a5\u9500\u671f\u95f4\u3001\u90e8\u95e8\u3001\u7533\u8bf7\u4eba\u3001\u8d39\u7528\u7c7b\u578b\u3001\u5355\u636e\u72b6\u6001\u3002<br>2. \u63d0\u4f9b\u4e24\u79cd\u5bfc\u51fa\u7c92\u5ea6\uff1a<br> &nbsp;&nbsp;\u2022 **\u5355\u636e\u6c47\u603b\u5bfc\u51fa**\uff1a\u4e00\u884c\u4e00\u5f20\u5355\uff08\u5355\u53f7\u3001\u7533\u8bf7\u4eba\u3001\u90e8\u95e8\u3001\u5408\u8ba1\u91d1\u989d\u3001\u72b6\u6001\u3001\u5ba1\u6279\u5b8c\u6210\u65f6\u95f4\uff09\u3002<br> &nbsp;&nbsp;\u2022 **\u8d39\u7528\u660e\u7ec6\u5bfc\u51fa**\uff1a\u4e00\u884c\u4e00\u6761\u8d39\u7528\u660e\u7ec6\uff08\u5355\u53f7\u3001\u7533\u8bf7\u4eba\u3001\u90e8\u95e8\u3001\u8d39\u7528\u7c7b\u578b\u3001\u91d1\u989d\u3001\u53d1\u751f\u65e5\u671f\u3001\u8bf4\u660e\u3001\u53d1\u7968\u6570\u91cf\u3001\u53d1\u7968\u6587\u4ef6\u540d\uff09\u3002<br>3. \u5bfc\u51fa\u6587\u4ef6\u547d\u540d\uff1a`\u62a5\u9500\u5bfc\u51fa_{\u7c92\u5ea6}_{yyyyMMddHHmm}.xlsx`\u3002<br>4. \u5355\u6b21\u5bfc\u51fa\u4e0a\u9650 10,000 \u6761\uff0c\u8d85\u51fa\u65f6\u63d0\u793a\u7f29\u5c0f\u8303\u56f4\u6216\u8f6c\u5f02\u6b65\u5bfc\u51fa\u5e76\u7ad9\u5185\u901a\u77e5\u4e0b\u8f7d\u3002 |\n\n### FR-6 \u5386\u53f2\u6570\u636e\u517c\u5bb9\n| \u9879 | \u63cf\u8ff0 |\n| --- | --- |\n| \u4f18\u5148\u7ea7 | P0 |\n| \u63cf\u8ff0 | \u6539\u9020\u4e0a\u7ebf\u540e\uff0c\u5386\u53f2\u5355\u636e\u7ee7\u7eed\u53ef\u67e5\u3001\u4e0d\u53d7\u5f71\u54cd\u3002 |\n| \u89c4\u5219 | 1. \u5386\u53f2\u5355\u636e\u7684\u5355\u6761\u8d39\u7528\u81ea\u52a8\u8fc1\u79fb/\u6620\u5c04\u4e3a\u300c1 \u6761\u660e\u7ec6\u884c\u300d\u7684\u5f62\u6001\uff0c\u8d39\u7528\u7c7b\u578b\u6cbf\u7528\u539f\u503c\u3002<br>2. \u5386\u53f2\u5355\u636e\u5728\u8be6\u60c5\u9875\u660e\u786e\u6807\u8bc6\u300c\u5386\u53f2\u5355\u636e\uff08\u65e7\u7248\uff09\u300d\uff0c\u4e0d\u63d0\u4f9b\u7f16\u8f91\u5165\u53e3\uff0c\u4e0d\u5141\u8bb8\u5728\u65b0\u6d41\u7a0b\u4e2d\u88ab\u91cd\u65b0\u63d0\u4ea4\u3002<br>3. \u5386\u53f2\u5355\u636e\u82e5\u539f\u672c\u65e0\u9644\u4ef6\uff0c\u5219\u9644\u4ef6\u533a\u663e\u793a\u300c\u65e0\u300d\uff0c\u4e0d\u62a5\u9519\u3001\u4e0d\u963b\u65ad\u5ba1\u6279\u8bb0\u5f55\u5c55\u793a\u3002<br>4. \u5386\u53f2\u5355\u636e\u53c2\u4e0e\u8d22\u52a1\u5bfc\u51fa\uff0c\u7f3a\u5931\u5b57\u6bb5\u4ee5\u7a7a\u503c/\u9ed8\u8ba4\u503c\u5bfc\u51fa\uff0c\u4e0d\u963b\u65ad\u5bfc\u51fa\u4efb\u52a1\u3002<br>5. \u7edf\u8ba1\u4e0e\u5408\u8ba1\u53e3\u5f84\u6539\u9020\u524d\u540e\u4fdd\u6301\u4e00\u81f4\uff0c\u907f\u514d\u5386\u53f2\u62a5\u8868\u91d1\u989d\u53d8\u5316\u3002 |\n\n### FR-7 \u8d39\u7528\u7c7b\u578b\u5b57\u5178\u7ef4\u62a4\uff08\u540e\u53f0\uff09\n| \u9879 | \u63cf\u8ff0 |\n| --- | --- |\n| \u4f18\u5148\u7ea7 | P1 |\n| \u63cf\u8ff0 | \u7ba1\u7406\u5458\u53ef\u7ef4\u62a4\u8d39\u7528\u7c7b\u578b\uff1a\u540d\u79f0\u3001\u7f16\u7801\u3001\u6392\u5e8f\u3001\u542f\u7528\u72b6\u6001\u3002 |\n| \u89c4\u5219 | \u505c\u7528\u7684\u7c7b\u578b\u4e0d\u518d\u51fa\u73b0\u5728\u65b0\u5efa\u4e0b\u62c9\u4e2d\uff0c\u4f46\u5386\u53f2\u5355\u636e\u4ecd\u6b63\u5e38\u663e\u793a\u539f\u7c7b\u578b\u540d\u79f0\u3002 |\n\n## 7. \u5355\u636e\u72b6\u6001\u673a\n\n```\n\u8349\u7a3f \u2192 \u5ba1\u6279\u4e2d \u2192 \u5df2\u901a\u8fc7 \u2192 \u5df2\u5bfc\u51fa/\u5f52\u6863\n         \u2193\n       \u5df2\u9a73\u56de \u2192 (\u5458\u5de5\u4fee\u6539\u540e\u91cd\u65b0\u63d0\u4ea4) \u2192 \u5ba1\u6279\u4e2d\n```\n\n| \u72b6\u6001 | \u53ef\u6267\u884c\u64cd\u4f5c | \u64cd\u4f5c\u89d2\u8272 |\n| --- | --- | --- |\n| \u8349\u7a3f | \u7f16\u8f91\u3001\u5220\u9664\u3001\u63d0\u4ea4 | \u5458\u5de5 |\n| \u5ba1\u6279\u4e2d | \u67e5\u770b\u3001\u901a\u8fc7\u3001\u9a73\u56de | \u90e8\u95e8\u4e3b\u7ba1 |\n| \u5df2\u9a73\u56de | \u7f16\u8f91\u3001\u91cd\u65b0\u63d0\u4ea4\u3001\u4f5c\u5e9f | \u5458\u5de5 |\n| \u5df2\u901a\u8fc7 | \u67e5\u770b\u3001\u5bfc\u51fa | \u8d22\u52a1 |\n\n## 8. \u975e\u529f\u80fd\u9700\u6c42\n\n| \u7c7b\u522b | \u8981\u6c42 |\n| --- | --- |\n| \u6027\u80fd | \u5355\u636e\u8be6\u60c5\u9875\uff08\u542b 20 \u5f20\u9644\u4ef6\u7f29\u7565\u56fe\uff09\u9996\u5c4f\u52a0\u8f7d \u22642s\uff1b\u53d1\u7968\u5927\u56fe\u52a0\u8f7d \u22643s\uff1b10,000 \u6761\u5bfc\u51fa \u226460s \u6216\u8d70\u5f02\u6b65\u3002 |\n| \u5bb9\u91cf | \u9644\u4ef6\u6309 10 MB/\u5f20\u3001\u5355\u636e\u91cf\u5e74\u589e 50 \u4e07\u6761\u4f30\u7b97\u5b58\u50a8\uff0c\u9700\u652f\u6301\u5bf9\u8c61\u5b58\u50a8\u6269\u5c55\u3002 |\n| \u5b89\u5168 | \u9644\u4ef6\u8bbf\u95ee\u8d70\u9274\u6743 + \u5e26\u8fc7\u671f\u65f6\u95f4\u7684\u7b7e\u540d URL\uff0c\u7981\u6b62\u672a\u767b\u5f55\u76f4\u63a5\u8bbf\u95ee\uff1b\u8d22\u52a1\u5bfc\u51fa\u9700\u72ec\u7acb\u6743\u9650\u70b9\u5e76\u8bb0\u5f55\u5bfc\u51fa\u65e5\u5fd7\uff08\u64cd\u4f5c\u4eba\u3001\u65f6\u95f4\u3001\u6761\u4ef6\u3001\u884c\u6570\uff09\u3002 |\n| \u5408\u89c4 | \u53d1\u7968\u4e0e\u5ba1\u6279\u610f\u89c1\u4fdd\u7559\u671f \u22655 \u5e74\uff0c\u5220\u9664\u8d70\u903b\u8f91\u5220\u9664\u3002 |\n| \u517c\u5bb9\u6027 | PC Chrome/Edge \u6700\u65b0\u4e24\u4e2a\u7248\u672c\uff1b\u79fb\u52a8\u7aef H5/\u4f01\u4e1a\u5fae\u4fe1\u5165\u53e3\u3002 |\n| \u53ef\u7528\u6027 | \u4e0a\u4f20\u4e2d\u65ad\u53ef\u65ad\u70b9\u7eed\u4f20\u6216\u91cd\u65b0\u4e0a\u4f20\uff0c\u4e0d\u4ea7\u751f\u810f\u6570\u636e\uff1b\u670d\u52a1\u53ef\u7528\u6027 \u226599.9%\u3002 |\n| \u5ba1\u8ba1 | \u660e\u7ec6\u4e0e\u9644\u4ef6\u7684\u65b0\u589e/\u4fee\u6539/\u5220\u9664\u9700\u7559\u64cd\u4f5c\u65e5\u5fd7\u3002 |\n\n## 9. \u8fb9\u754c\u4e0e\u5f02\u5e38\u573a\u666f\n\n1. \u660e\u7ec6\u5168\u90e8\u5220\u9664\u540e\u63d0\u4ea4 \u2192 \u963b\u6b62\u63d0\u4ea4\u5e76\u63d0\u793a\u300c\u81f3\u5c11\u4fdd\u7559\u4e00\u6761\u8d39\u7528\u660e\u7ec6\u300d\u3002\n2. \u5355\u6761\u91d1\u989d\u4e3a 0\u3001\u8d1f\u6570\u6216\u8d85\u8fc7 3 \u4f4d\u5c0f\u6570 \u2192 \u63d0\u4ea4\u6821\u9a8c\u62e6\u622a\u3002\n3. \u4e0a\u4f20\u8d85\u9650\uff08>10 MB\u3001>20 \u4e2a\u3001\u683c\u5f0f\u4e0d\u652f\u6301\uff09\u2192 \u524d\u7aef\u62e6\u622a\u5e76\u7ed9\u51fa\u660e\u786e\u63d0\u793a\u3002\n4. \u5ba1\u6279\u4eba\u67e5\u770b\u65f6\u9644\u4ef6\u5df2\u635f\u574f/\u5b58\u50a8\u4e0d\u53ef\u8fbe \u2192 \u663e\u793a\u5360\u4f4d\u56fe\u4e0e\u300c\u6587\u4ef6\u52a0\u8f7d\u5931\u8d25\uff0c\u8bf7\u91cd\u8bd5\u300d\uff0c\u4e0d\u5f71\u54cd\u5176\u4f59\u5185\u5bb9\u5c55\u793a\u3002\n5. \u5e76\u53d1\u7f16\u8f91\uff08\u5458\u5de5\u4e0e\u5ba1\u6279\u4eba\u540c\u65f6\u64cd\u4f5c\uff09\u2192 \u63d0\u4ea4\u540e\u5355\u636e\u9501\u5b9a\uff0c\u5ba1\u6279\u4eba\u64cd\u4f5c\u57fa\u4e8e\u7248\u672c\u53f7\uff0c\u51b2\u7a81\u65f6\u63d0\u793a\u5237\u65b0\u3002\n6. \u9a73\u56de\u540e\u5458\u5de5\u65b0\u589e/\u5220\u9664\u660e\u7ec6\u884c \u2192 \u5ba1\u6279\u4eba\u91cd\u65b0\u6253\u5f00\u65f6\u5c55\u793a\u6700\u65b0\u7248\u672c\u5e76\u6807\u8bb0\u300c\u5df2\u4fee\u6539\u300d\u3002\n7. \u5bfc\u51fa\u8fc7\u7a0b\u4e2d\u65e0\u6570\u636e \u2192 \u5bfc\u51fa\u7a7a\u8868\u5e76\u63d0\u793a\u300c\u5f53\u524d\u7b5b\u9009\u6761\u4ef6\u4e0b\u65e0\u6570\u636e\u300d\u3002\n8. \u5386\u53f2\u5355\u636e\u8d39\u7528\u7c7b\u578b\u5728\u65b0\u5b57\u5178\u4e2d\u5df2\u88ab\u5220\u9664 \u2192 \u4ecd\u6309\u539f\u540d\u79f0\u6587\u672c\u5c55\u793a\u3002\n9. \u540c\u4e00\u5458\u5de5\u540c\u62a5\u9500\u671f\u95f4\u91cd\u590d\u63d0\u4ea4 \u2192 \u4ec5\u63d0\u793a\uff08\u4e0d\u5f3a\u5236\u62e6\u622a\uff0c\u5f85\u4e1a\u52a1\u786e\u8ba4\uff0c\u89c1 Q1\uff09\u3002\n\n## 10. \u9a8c\u6536\u6807\u51c6\n\n| \u7f16\u53f7 | \u9a8c\u6536\u70b9 | \u9884\u671f\u7ed3\u679c |\n| --- | --- | --- |\n| AC-1 | \u65b0\u5efa\u5355\u636e\u6dfb\u52a0\u6253\u8f66\u8d39\u3001\u9910\u8d39\u3001\u4f4f\u5bbf\u8d39 3 \u6761\u660e\u7ec6 | \u4fdd\u5b58\u6210\u529f\uff0c\u5408\u8ba1 = \u4e09\u8005\u4e4b\u548c |\n| AC-2 | \u660e\u7ec6\u884c\u4e3a\u7a7a\u6216\u91d1\u989d\u975e\u6cd5\u65f6\u63d0\u4ea4 | \u963b\u6b62\u63d0\u4ea4\u5e76\u5b9a\u4f4d\u9519\u8bef\u884c |\n| AC-3 | \u6bcf\u6761\u660e\u7ec6\u4e0a\u4f20 1 \u5f20\u53d1\u7968 | \u63d0\u4ea4\u6210\u529f\uff0c\u9644\u4ef6\u4e0e\u660e\u7ec6\u884c\u7ed1\u5b9a\u6b63\u786e |\n| AC-4 | \u4e3b\u7ba1\u6253\u5f00\u5f85\u529e\u5355\u636e | \u53ef\u89c1\u5168\u90e8\u660e\u7ec6\u884c\u53ca\u5bf9\u5e94\u53d1\u7968\u7f29\u7565\u56fe |\n| AC-5 | \u4e3b\u7ba1\u70b9\u51fb\u53d1\u7968 | \u53ef\u653e\u5927\u3001\u5207\u6362\u3001\u65cb\u8f6c\u3001\u4e0b\u8f7d\u539f\u56fe/PDF |\n| AC-6 | \u4e3b\u7ba1\u9a73\u56de\u5e76\u586b\u5199\u610f\u89c1 | \u5355\u636e\u8f6c\u300c\u5df2\u9a73\u56de\u300d\uff0c\u5458\u5de5\u53ef\u4fee\u6539\u540e\u91cd\u65b0\u63d0\u4ea4\uff0c\u5ba1\u6279\u8bb0\u5f55\u4fdd\u7559 |\n| AC-7 | \u8d22\u52a1\u6309\u90e8\u95e8 + \u65e5\u671f\u533a\u95f4\u5bfc\u51fa\u660e\u7ec6\u7c92\u5ea6 | \u5f97\u5230 xlsx\uff0c\u884c\u6570\u3001\u91d1\u989d\u4e0e\u7cfb\u7edf\u4e00\u81f4\uff0c\u542b\u53d1\u7968\u6587\u4ef6\u540d\u5217 |\n| AC-8 | \u8d22\u52a1\u5bfc\u51fa\u64cd\u4f5c | \u5bfc\u51fa\u65e5\u5fd7\u8bb0\u5f55\u64cd\u4f5c\u4eba\u3001\u65f6\u95f4\u3001\u6761\u4ef6\u3001\u884c\u6570 |\n| AC-9 | \u6253\u5f00\u4e00\u5f20\u6539\u9020\u524d\u7684\u5386\u53f2\u5355\u636e | \u6b63\u5e38\u663e\u793a\u4e3a\u5355\u6761\u660e\u7ec6\uff0c\u6807\u8bc6\u65e7\u7248\uff0c\u65e0\u62a5\u9519\uff0c\u4e0d\u53ef\u7f16\u8f91 |\n| AC-10 | \u5386\u53f2 + \u65b0\u5355\u636e\u6df7\u5408\u5bfc\u51fa | \u5168\u90e8\u5bfc\u51fa\u6210\u529f\uff0c\u5386\u53f2\u5355\u636e\u7a7a\u5b57\u6bb5\u4e0d\u963b\u65ad |\n| AC-11 | \u505c\u7528\u67d0\u8d39\u7528\u7c7b\u578b | \u65b0\u5efa\u4e0b\u62c9\u4e0d\u542b\u8be5\u9879\uff0c\