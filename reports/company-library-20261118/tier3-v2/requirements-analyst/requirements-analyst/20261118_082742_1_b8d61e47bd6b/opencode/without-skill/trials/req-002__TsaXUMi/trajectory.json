a1\u3001\u8d22\u52a1 |\n\n---\n\n## 1. \u80cc\u666f\u4e0e\u76ee\u6807\n\n### 1.1 \u73b0\u72b6\u95ee\u9898\n1. \u4e00\u5f20\u62a5\u9500\u5355\u4ec5\u652f\u6301\u586b\u5199**\u4e00\u79cd**\u8d39\u7528\u7c7b\u578b\uff0c\u5458\u5de5\u4e00\u6b21\u51fa\u5dee\u7684\u591a\u9879\u8d39\u7528\u9700\u62c6\u6210\u591a\u5f20\u5355\u63d0\u4ea4\uff0c\u586b\u5199\u4e0e\u5ba1\u6279\u5de5\u4f5c\u91cf\u5927\u3002\n2. \u5ba1\u6279\u73af\u8282**\u65e0\u6cd5\u67e5\u770b\u53d1\u7968\u7167\u7247**\uff0c\u4e3b\u7ba1\u53ea\u80fd\u4f9d\u636e\u91d1\u989d\u4e0e\u6587\u5b57\u63cf\u8ff0\u5224\u65ad\uff0c\u5ba1\u6279\u8d28\u91cf\u4e0e\u6548\u7387\u4f4e\uff0c\u9000\u5355\u7387\u9ad8\u3002\n3. \u8d22\u52a1\u7f3a\u5c11**\u5bfc\u51fa**\u80fd\u529b\uff0c\u6708\u672b\u6c47\u603b\u3001\u5165\u8d26\u3001\u5bf9\u8d26\u9700\u4eba\u5de5\u6284\u5f55\uff0c\u6613\u51fa\u9519\u3002\n\n### 1.2 \u6539\u9020\u76ee\u6807\n1. \u652f\u6301\u4e00\u5f20\u62a5\u9500\u5355\u5185**\u591a\u8d39\u7528\u7c7b\u578b\u660e\u7ec6\u5206\u5217**\uff08\u5982\u6253\u8f66\u8d39\u3001\u9910\u8d39\u3001\u4f4f\u5bbf\u8d39\uff09\u3002\n2. \u5ba1\u6279\u4eba\u53ef\u5728\u5ba1\u6279\u9875\u9762\u67e5\u770b\u62a5\u9500\u5355\u5173\u8054\u7684**\u53d1\u7968\u7167\u7247**\u3002\n3. \u8d22\u52a1\u652f\u6301\u6309\u6761\u4ef6\u67e5\u8be2\u5e76**\u5bfc\u51fa**\u62a5\u9500\u6570\u636e\u3002\n4. **\u5386\u53f2\u6570\u636e\u517c\u5bb9**\uff1a\u5df2\u6709\u62a5\u9500\u5355\u53ef\u7ee7\u7eed\u6b63\u5e38\u67e5\u770b\uff0c\u4e0d\u53d7\u672c\u6b21\u6539\u9020\u5f71\u54cd\u3002\n\n### 1.3 \u6210\u529f\u5224\u5b9a\u6807\u51c6\n- \u5458\u5de5\u53ef\u5728\u4e00\u5f20\u5355\u5185\u63d0\u4ea4 \u22652 \u79cd\u8d39\u7528\u7c7b\u578b\u5e76\u5b8c\u6210\u5168\u6d41\u7a0b\u5ba1\u6279\u3002\n- \u4e3b\u7ba1\u5728\u5ba1\u6279\u9875\u53ef\u76f4\u63a5\u67e5\u770b\u5e76\u653e\u5927\u53d1\u7968\u7167\u7247\u3002\n- \u8d22\u52a1\u53ef\u5bfc\u51fa\u7b26\u5408\u7b5b\u9009\u6761\u4ef6\u7684\u5168\u90e8\u7ed3\u679c\uff0c\u5bfc\u51fa\u5b57\u6bb5\u4e0e\u5217\u8868\u4e00\u81f4\u3002\n- \u5386\u53f2\u62a5\u9500\u5355\u5728\u65b0\u7248\u672c\u4e2d\u53ef\u6b63\u5e38\u6253\u5f00\u3001\u67e5\u770b\u3001\u5ba1\u6279\u3001\u5f52\u6863\u3002\n\n---\n\n## 2. \u672f\u8bed\u5b9a\u4e49\n\n| \u672f\u8bed | \u8bf4\u660e |\n| --- | --- |\n| \u62a5\u9500\u5355 | \u5458\u5de5\u63d0\u4ea4\u7684\u4e00\u6b21\u62a5\u9500\u7533\u8bf7\u4e3b\u4f53\uff0c\u542b\u7533\u8bf7\u4eba\u3001\u90e8\u95e8\u3001\u4e8b\u7531\u3001\u603b\u91d1\u989d\u3001\u72b6\u6001\u7b49 |\n| \u8d39\u7528\u660e\u7ec6\u884c | \u62a5\u9500\u5355\u4e0b\u7684\u4e00\u6761\u8d39\u7528\u8bb0\u5f55\uff0c\u542b\u8d39\u7528\u7c7b\u578b\u3001\u91d1\u989d\u3001\u53d1\u751f\u65e5\u671f\u3001\u8bf4\u660e\u3001\u53d1\u7968\u9644\u4ef6 |\n| \u8d39\u7528\u7c7b\u578b | \u6253\u8f66\u8d39\u3001\u9910\u8d39\u3001\u4f4f\u5bbf\u8d39\u3001\u4ea4\u901a\u8d39\u3001\u529e\u516c\u8d39\u3001\u5176\u4ed6\u7b49\uff08\u53ef\u914d\u7f6e\uff09 |\n| \u53d1\u7968\u9644\u4ef6 | \u6302\u5728\u660e\u7ec6\u884c\u4e0a\u7684\u53d1\u7968\u7167\u7247/\u6587\u4ef6 |\n| \u5386\u53f2\u62a5\u9500\u5355 | \u672c\u6b21\u6539\u9020\u4e0a\u7ebf\u524d\u5df2\u5b58\u5728\u7684\u3001\u4ec5\u6709\u5355\u8d39\u7528\u7c7b\u578b\u7ed3\u6784\u7684\u62a5\u9500\u5355 |\n\n---\n\n## 3. \u89d2\u8272\u4e0e\u6743\u9650\n\n| \u89d2\u8272 | \u6743\u9650 |\n| --- | --- |\n| \u5458\u5de5 | \u65b0\u5efa\u3001\u7f16\u8f91\u3001\u63d0\u4ea4\u3001\u64a4\u56de\u3001\u5220\u9664\u672c\u4eba\u8349\u7a3f\uff1b\u67e5\u770b\u672c\u4eba\u62a5\u9500\u5355\u53ca\u5ba1\u6279\u8fdb\u5ea6\uff1b\u4e0a\u4f20/\u66f4\u6362\u53d1\u7968\u7167\u7247 |\n| \u90e8\u95e8\u4e3b\u7ba1 | \u67e5\u770b\u5f85\u529e\u4e0e\u5df2\u529e\uff1b\u5728\u5ba1\u6279\u9875\u67e5\u770b\u5355\u636e\u4fe1\u606f\u4e0e\u5168\u90e8\u660e\u7ec6\u3001\u53d1\u7968\u7167\u7247\uff1b\u901a\u8fc7/\u9a73\u56de\u5e76\u586b\u5199\u610f\u89c1 |\n| \u8d22\u52a1 | \u67e5\u770b\u5168\u91cf\u62a5\u9500\u5355\uff1b\u6309\u6761\u4ef6\u7b5b\u9009\u3001\u5bfc\u51fa\uff1b\u67e5\u770b\u53d1\u7968\u7167\u7247\uff1b\u6807\u8bb0\u4ed8\u6b3e/\u5f52\u6863\u72b6\u6001\uff08\u6309\u73b0\u6709\u6d41\u7a0b\uff09 |\n| \u7cfb\u7edf\u7ba1\u7406\u5458 | \u7ef4\u62a4\u8d39\u7528\u7c7b\u578b\u5b57\u5178\u3001\u5355\u6761\u91d1\u989d\u4e0a\u9650\u3001\u9644\u4ef6\u5927\u5c0f\u4e0e\u683c\u5f0f\u9650\u5236 |\n\n---\n\n## 4. \u529f\u80fd\u9700\u6c42\n\n### 4.1 \u591a\u8d39\u7528\u7c7b\u578b\u660e\u7ec6\uff08FR-01\uff09\n\n**FR-01-1 \u660e\u7ec6\u884c\u7f16\u8f91**\n- \u62a5\u9500\u5355\u8868\u5355\u65b0\u589e\u201c\u8d39\u7528\u660e\u7ec6\u201d\u533a\u57df\uff0c\u652f\u6301\u201c\u6dfb\u52a0\u4e00\u884c / \u5220\u9664\u4e00\u884c\u201d\u3002\n- \u6bcf\u884c\u5fc5\u586b\uff1a\u8d39\u7528\u7c7b\u578b\u3001\u91d1\u989d\uff08\u5143\uff09\u3001\u53d1\u751f\u65e5\u671f\uff1b\u9009\u586b\uff1a\u8d39\u7528\u8bf4\u660e\u3001\u53d1\u7968\u9644\u4ef6\u3002\n- \u4e00\u5f20\u5355\u81f3\u5c11 1 \u884c\uff0c\u6700\u591a 20 \u884c\uff08\u4e0a\u9650\u53ef\u914d\u7f6e\uff09\u3002\n- \u660e\u7ec6\u884c\u652f\u6301\u4e0a\u4e0b\u79fb\u52a8\u6392\u5e8f\u3001\u590d\u5236\u5df2\u6709\u884c\u3002\n\n**FR-01-2 \u91d1\u989d\u6c47\u603b**\n- \u62a5\u9500\u5355\u603b\u91d1\u989d = \u5404\u660e\u7ec6\u884c\u91d1\u989d\u4e4b\u548c\uff0c\u7cfb\u7edf\u81ea\u52a8\u8ba1\u7b97\uff0c\u4e0d\u5141\u8bb8\u624b\u5de5\u4fee\u6539\u603b\u989d\u3002\n- \u5b9e\u65f6\u5c55\u793a\uff1a\u660e\u7ec6\u884c\u6570\u3001\u603b\u91d1\u989d\u3001\u6309\u8d39\u7528\u7c7b\u578b\u7684\u5c0f\u8ba1\u3002\n- \u91d1\u989d\u7cbe\u5ea6\uff1a\u5c0f\u6570 2 \u4f4d\uff0c\u56db\u820d\u4e94\u5165\uff1b\u5355\u884c\u91d1\u989d\u5fc5\u987b > 0\u3002\n\n**FR-01-3 \u6821\u9a8c\u89c4\u5219**\n- \u63d0\u4ea4\u524d\u6821\u9a8c\uff1a\u660e\u7ec6\u4e0d\u80fd\u4e3a\u7a7a\uff1b\u540c\u4e00\u5355\u636e\u5185\u201c\u76f8\u540c\u8d39\u7528\u7c7b\u578b + \u76f8\u540c\u53d1\u751f\u65e5\u671f + \u76f8\u540c\u91d1\u989d\u201d\u7684\u91cd\u590d\u884c\u9700\u7ed9\u51fa\u63d0\u793a\uff08\u5141\u8bb8\u786e\u8ba4\u540e\u63d0\u4ea4\uff09\u3002\n- \u82e5\u516c\u53f8\u653f\u7b56\u5bf9\u67d0\u7c7b\u8d39\u7528\u6709\u6807\u51c6\u9650\u989d\uff08\u5982\u9910\u8d39 \u2264150 \u5143/\u4eba/\u5929\uff09\uff0c\u8d85\u9650\u7ed9\u51fa\u63d0\u793a\u5e76\u8981\u6c42\u586b\u5199\u8d85\u6807\u8bf4\u660e\u3002\n- \u9644\u4ef6\u5fc5\u4f20\u89c4\u5219\uff1a\u91d1\u989d \u2265 \u914d\u7f6e\u9608\u503c\u7684\u660e\u7ec6\u884c\uff0c\u5fc5\u987b\u81f3\u5c11\u4e0a\u4f20 1 \u5f20\u53d1\u7968\u7167\u7247\u3002\n\n**FR-01-4 \u5217\u8868\u4e0e\u8be6\u60c5\u5c55\u793a**\n- \u62a5\u9500\u5355\u5217\u8868\u589e\u52a0\u201c\u8d39\u7528\u7c7b\u578b\u6570\u201d\u201c\u603b\u91d1\u989d\u201d\u5217\u3002\n- \u8be6\u60c5\u9875\u4ee5\u8868\u683c\u5c55\u793a\u5168\u90e8\u660e\u7ec6\u884c\uff0c\u6bcf\u884c\u53ef\u5c55\u5f00\u67e5\u770b\u5176\u53d1\u7968\u9644\u4ef6\u3002\n\n### 4.2 \u53d1\u7968\u7167\u7247\u67e5\u770b\uff08FR-02\uff09\n\n**FR-02-1 \u4e0a\u4f20**\n- \u652f\u6301\u683c\u5f0f\uff1ajpg\u3001jpeg\u3001png\u3001pdf\uff1b\u5355\u6587\u4ef6 \u226410MB\uff1b\u5355\u884c\u9644\u4ef6 \u22645 \u4e2a\u3002\n- \u652f\u6301\u62cd\u7167\u4e0a\u4f20\uff08\u79fb\u52a8\u7aef\uff09\u4e0e\u672c\u5730\u6587\u4ef6\u4e0a\u4f20\uff1b\u4e0a\u4f20\u540e\u5c55\u793a\u7f29\u7565\u56fe\uff0c\u652f\u6301\u5220\u9664\u4e0e\u66ff\u6362\u3002\n- \u4ec5\u8349\u7a3f\u4e0e\u88ab\u9a73\u56de\u72b6\u6001\u5141\u8bb8\u4fee\u6539\u9644\u4ef6\u3002\n\n**FR-02-2 \u5ba1\u6279\u9875\u67e5\u770b**\n- \u5ba1\u6279\u9875\u9762\u6309\u660e\u7ec6\u884c\u5c55\u793a\u5bf9\u5e94\u53d1\u7968\u7f29\u7565\u56fe\uff0c\u70b9\u51fb\u53ef\u653e\u5927\u9884\u89c8\u3002\n- \u9884\u89c8\u652f\u6301\uff1a\u653e\u5927/\u7f29\u5c0f\u3001\u5de6\u53f3\u5207\u6362\u67e5\u770b\u540c\u4e00\u5355\u636e\u5185\u5176\u4ed6\u53d1\u7968\u3001\u65cb\u8f6c\u3001\u4e0b\u8f7d\u539f\u56fe\u3002\n- \u652f\u6301\u5728\u660e\u7ec6\u8868\u683c\u5185\u76f4\u63a5\u8df3\u8f6c\u81f3\u5bf9\u5e94\u53d1\u7968\uff0c\u4fbf\u4e8e\u9010\u6761\u6838\u5bf9\u3002\n- \u9a73\u56de\u65f6\u5fc5\u987b\u53ef\u586b\u5199\u610f\u89c1\uff0c\u5e76\u53ef\u52fe\u9009\u5173\u8054\u5230\u5177\u4f53\u660e\u7ec6\u884c\u3002\n\n**FR-02-3 \u5b89\u5168**\n- \u9644\u4ef6\u8bbf\u95ee\u9700\u9274\u6743\uff0c\u4ec5\u7533\u8bf7\u4eba\u3001\u5ba1\u6279\u94fe\u4e0a\u7684\u5ba1\u6279\u4eba\u3001\u8d22\u52a1\u3001\u7ba1\u7406\u5458\u53ef\u8bbf\u95ee\u3002\n- \u9644\u4ef6 URL \u4e0d\u53ef\u88ab\u65e0\u6743\u9650\u7528\u6237\u76f4\u63a5\u8bbf\u95ee\uff1b\u67e5\u770b\u4e0e\u4e0b\u8f7d\u64cd\u4f5c\u8bb0\u5f55\u5ba1\u8ba1\u65e5\u5fd7\u3002\n\n### 4.3 \u8d22\u52a1\u5bfc\u51fa\uff08FR-03\uff09\n\n**FR-03-1 \u7b5b\u9009\u6761\u4ef6**\n- \u652f\u6301\u6309\uff1a\u63d0\u4ea4\u65f6\u95f4\u8303\u56f4\u3001\u53d1\u751f\u65e5\u671f\u8303\u56f4\u3001\u7533\u8bf7\u4eba\u3001\u90e8\u95e8\u3001\u8d39\u7528\u7c7b\u578b\u3001\u62a5\u9500\u72b6\u6001\u3001\u91d1\u989d\u533a\u95f4\u7ec4\u5408\u7b5b\u9009\u3002\n\n**FR-03-2 \u5bfc\u51fa\u683c\u5f0f\u4e0e\u5b57\u6bb5**\n- \u652f\u6301\u5bfc\u51fa Excel\uff08.xlsx\uff09\uff0c\u540e\u7eed\u53ef\u6269\u5c55 CSV\u3002\n- \u5b57\u6bb5\u81f3\u5c11\u5305\u542b\uff1a\u62a5\u9500\u5355\u53f7\u3001\u7533\u8bf7\u4eba\u3001\u90e8\u95e8\u3001\u63d0\u4ea4\u65f6\u95f4\u3001\u72b6\u6001\u3001\u8d39\u7528\u7c7b\u578b\u3001\u8d39\u7528\u8bf4\u660e\u3001\u53d1\u751f\u65e5\u671f\u3001\u91d1\u989d\u3001\u53d1\u7968\u6570\u91cf\u3001\u5ba1\u6279\u4eba\u3001\u5ba1\u6279\u65f6\u95f4\u3001\u5ba1\u6279\u610f\u89c1\u3002\n- \u5bfc\u51fa\u7c92\u5ea6\u63d0\u4f9b\u4e24\u79cd\u6a21\u5f0f\uff1a\n  - \u660e\u7ec6\u6a21\u5f0f\uff1a\u4e00\u884c = \u4e00\u6761\u8d39\u7528\u660e\u7ec6\uff08\u63a8\u8350\uff0c\u9ed8\u8ba4\uff09\u3002\n  - \u5355\u636e\u6a21\u5f0f\uff1a\u4e00\u884c = \u4e00\u5f20\u62a5\u9500\u5355\uff0c\u591a\u7c7b\u578b\u4ee5\u5206\u5217\u6216\u5408\u5e76\u5355\u5143\u683c\u5c55\u793a\u3002\n- \u5355\u636e\u6a21\u5f0f\u9700\u4fdd\u8bc1\u540c\u4e00\u5355\u7684\u591a\u660e\u7ec6\u53ef\u88ab\u6b63\u786e\u5f52\u5e76\uff0c\u4e0d\u4e22\u6570\u636e\u3002\n\n**FR-03-3 \u5bfc\u51fa\u6267\u884c**\n- \u6570\u636e\u91cf \u22645000 \u6761\u540c\u6b65\u4e0b\u8f7d\uff1b\u8d85\u8fc7\u5219\u8f6c\u5f02\u6b65\u4efb\u52a1\uff0c\u5b8c\u6210\u540e\u5728\u4e0b\u8f7d\u4e2d\u5fc3\u63d0\u4f9b\u6587\u4ef6\uff08\u4fdd\u7559 7 \u5929\uff09\u5e76\u901a\u77e5\u3002\n- \u5bfc\u51fa\u9700\u8bb0\u5f55\u64cd\u4f5c\u65e5\u5fd7\uff08\u64cd\u4f5c\u4eba\u3001\u65f6\u95f4\u3001\u7b5b\u9009\u6761\u4ef6\u3001\u5bfc\u51fa\u6761\u6570\uff09\u3002\n- \u5bfc\u51fa\u5185\u5bb9\u4e0e\u9875\u9762\u67e5\u8be2\u7ed3\u679c\u4e25\u683c\u4e00\u81f4\uff08\u542b\u5206\u9875\u5916\u7684\u5168\u90e8\u6570\u636e\uff09\u3002\n\n### 4.4 \u5386\u53f2\u6570\u636e\u517c\u5bb9\uff08FR-04\uff09\n\n- \u5386\u53f2\u5355\u91c7\u7528\u201c\u517c\u5bb9\u8bfb\u53d6\u201d\u7b56\u7565\uff1a\u65e7\u6570\u636e\u7ed3\u6784\u5728\u8be6\u60c5\u9875\u7b49\u4ef7\u6e32\u67d3\u4e3a 1 \u6761\u8d39\u7528\u660e\u7ec6\u884c\uff0c\u91d1\u989d\u3001\u7c7b\u578b\u3001\u53d1\u7968\uff08\u82e5\u6709\uff09\u4fdd\u6301\u539f\u503c\u5c55\u793a\u3002\n- \u5386\u53f2\u5355\u5728\u5217\u8868\u3001\u67e5\u8be2\u3001\u5ba1\u6279\u3001\u5bfc\u51fa\u4e2d\u7684\u8868\u73b0\u4e0e\u65b0\u5355\u4e00\u81f4\uff1b\u5bfc\u51fa\u65f6\u5176\u8d39\u7528\u7c7b\u578b\u3001\u91d1\u989d\u6b63\u5e38\u51fa\u73b0\u5728\u660e\u7ec6\u884c\u4e2d\u3002\n- \u5386\u53f2\u5355\u4e3a**\u53ea\u8bfb**\uff1a\u4e0d\u5141\u8bb8\u65b0\u589e/\u7f16\u8f91\u660e\u7ec6\u884c\u3001\u4e0d\u5141\u8bb8\u8865\u4f20\u53d1\u7968\uff1b\u5982\u9700\u66f4\u6b63\uff0c\u8d70\u201c\u4f5c\u5e9f + \u91cd\u65b0\u63d0\u4ea4\u65b0\u5355\u201d\u6d41\u7a0b\u3002\n- \u4e0d\u505a\u5f3a\u5236\u6570\u636e\u8fc1\u79fb\uff1b\u82e5\u540e\u7eed\u7edf\u4e00\u8fc1\u79fb\uff0c\u9700\u5728\u8fc1\u79fb\u524d\u540e\u8fdb\u884c\u6570\u636e\u6761\u6570\u4e0e\u91d1\u989d\u603b\u989d\u7684\u4e00\u81f4\u6027\u6821\u9a8c\uff0c\u5e76\u63d0\u4f9b\u56de\u6eda\u65b9\u6848\u3002\n- \u65b0\u65e7\u6570\u636e\u6df7\u5b58\u671f\u95f4\uff0c\u6240\u6709\u67e5\u8be2\u4e0e\u5bfc\u51fa\u7edf\u8ba1\u9700\u540c\u65f6\u8986\u76d6\u4e24\u79cd\u7ed3\u6784\uff0c\u907f\u514d\u6f0f\u5355\u3002\n\n---\n\n## 5. \u4e1a\u52a1\u6d41\u7a0b\n\n```\n\u5458\u5de5\u65b0\u5efa\u62a5\u9500\u5355\n  \u2192 \u586b\u5199\u62ac\u5934\u4fe1\u606f\n  \u2192 \u6dfb\u52a0\u591a\u6761\u8d39\u7528\u660e\u7ec6\uff08\u542b\u53d1\u7968\uff09\n  \u2192 \u63d0\u4ea4\n  \u2192 \u90e8\u95e8\u4e3b\u7ba1\u5ba1\u6279\uff08\u67e5\u770b\u660e\u7ec6 + \u53d1\u7968\u7167\u7247\uff09\n      \u251c\u2500 \u901a\u8fc7 \u2192 \u8fdb\u5165\u8d22\u52a1\u73af\u8282\n      \u2514\u2500 \u9a73\u56de \u2192 \u9000\u56de\u5458\u5de5\uff0c\u53ef\u7f16\u8f91\u540e\u91cd\u65b0\u63d0\u4ea4\n  \u2192 \u8d22\u52a1\u6838\u5bf9\u3001\u5bfc\u51fa\u3001\u5f52\u6863\n```\n\n\u72b6\u6001\u673a\uff1a\u8349\u7a3f \u2192 \u5f85\u5ba1\u6279 \u2192 \u5ba1\u6279\u4e2d \u2192 \u5df2\u901a\u8fc7 / \u5df2\u9a73\u56de \u2192 \u5df2\u5f52\u6863\u3002\u64a4\u56de\u540e\u56de\u5230\u8349\u7a3f\u3002\n\n---\n\n## 6. \u975e\u529f\u80fd\u9700\u6c42\n\n| \u7c7b\u522b | \u8981\u6c42 |\n| --- | --- |\n| \u6027\u80fd | \u660e\u7ec6\u884c\u6570 \u226420 \u65f6\u8868\u5355\u52a0\u8f7d <2s\uff1b\u5ba1\u6279\u9875\u53d1\u7968\u7f29\u7565\u56fe\u9996\u5c4f <2s\uff1b\u5355\u9875 5000 \u6761\u5185\u67e5\u8be2 <3s |\n| \u5e76\u53d1 | \u652f\u6301\u6708\u672b\u8d22\u52a1\u96c6\u4e2d\u5bfc\u51fa\uff0c\u5f02\u6b65\u4efb\u52a1\u4e0d\u963b\u585e\u5728\u7ebf\u67e5\u8be2 |\n| \u5bb9\u91cf | \u660e\u7ec6\u884c\u8868\u652f\u6301\u767e\u4e07\u7ea7\u6570\u636e\uff0c\u6309\u62a5\u9500\u5355\u53f7\u5efa\u7acb\u7d22\u5f15 |\n| \u53ef\u7528\u6027 | \u9644\u4ef6\u5b58\u50a8\u4e0d\u53ef\u7528\u65f6\uff0c\u5355\u636e\u6587\u672c\u4fe1\u606f\u4ecd\u53ef\u6b63\u5e38\u67e5\u770b\u4e0e\u5ba1\u6279 |\n| \u517c\u5bb9\u6027 | \u4e3b\u6d41\u6d4f\u89c8\u5668\uff08Chrome/Edge/Safari\uff09\u53ca\u79fb\u52a8\u7aef H5\uff1b\u79fb\u52a8\u7aef\u9700\u652f\u6301\u62cd\u7167\u4e0a\u4f20 |\n| \u5b89\u5168 | \u9644\u4ef6\u9274\u6743\u3001\u4e0b\u8f7d\u6c34\u5370\uff08\u53ef\u9009\uff09\u3001\u64cd\u4f5c\u5ba1\u8ba1\u65e5\u5fd7\u7559\u5b58 \u22651 \u5e74 |\n| \u6570\u636e\u4e00\u81f4\u6027 | \u603b\u91d1\u989d\u4e0e\u660e\u7ec6\u6c42\u548c\u5728\u63d0\u4ea4\u3001\u5ba1\u6279\u3001\u5bfc\u51fa\u5404\u73af\u8282\u4e00\u81f4\uff0c\u8bef\u5dee\u4e3a 0 |\n\n---\n\n## 7. \u754c\u9762\u6539\u52a8\u6e05\u5355\n\n1. \u62a5\u9500\u5355\u586b\u5199\u9875\uff1a\u65b0\u589e\u201c\u8d39\u7528\u660e\u7ec6\u201d\u8868\u683c\u7ec4\u4ef6\uff08\u589e\u5220\u884c\u3001\u7c7b\u578b\u4e0b\u62c9\u3001\u91d1\u989d\u3001\u65e5\u671f\u3001\u9644\u4ef6\u3001\u5c0f\u8ba1\uff09\u3002\n2. \u62a5\u9500\u5355\u8be6\u60c5\u9875\uff1a\u660e\u7ec6\u8868\u683c + \u6bcf\u884c\u9644\u4ef6\u533a\u3002\n3. \u5ba1\u6279\u9875\uff1a\u660e\u7ec6\u53ea\u8bfb\u8868\u683c + \u53d1\u7968\u7f29\u7565\u56fe\u5217\u8868 + \u56fe\u7247\u9884\u89c8\u6d6e\u5c42 + \u9a73\u56de\u610f\u89c1\uff08\u53ef\u9009\u5173\u8054\u660e\u7ec6\u884c\uff09\u3002\n4. \u8d22\u52a1\u67e5\u8be2\u9875\uff1a\u65b0\u589e\u7b5b\u9009\u6761\u4ef6\u533a\u4e0e\u201c\u5bfc\u51fa\u201d\u6309\u94ae\u3001\u5bfc\u51fa\u6a21\u5f0f\u9009\u62e9\u3001\u4e0b\u8f7d\u4e2d\u5fc3\u5165\u53e3\u3002\n5. \u7ba1\u7406\u7aef\uff1a\u8d39\u7528\u7c7b\u578b\u5b57\u5178\u4e0e\u9650\u989d\u3001\u9644\u4ef6\u5fc5\u4f20\u9608\u503c\u914d\u7f6e\u3002\n\n---\n\n## 8. \u6570\u636e\u53d8\u66f4\u6982\u8981\n\n- \u65b0\u589e `expense_item`\uff08\u62a5\u9500\u660e\u7ec6\uff09\u8868\uff1a`id, reimbursement_id, expense_type, amount, occur_date, remark, sort_no, created_at`\u3002\n- \u65b0\u589e `expense_attachment`\uff08\u53d1\u7968\u9644\u4ef6\uff09\u8868\uff1a`id, expense_item_id, file_name, file_key, file_size, file_type, uploaded_by, created_at`\uff1b\u5386\u53f2\u5355\u9644\u4ef6\u9700\u53ef\u5173\u8054\u81f3\u5176\u7b49\u4ef7\u660e\u7ec6\u884c\u3002\n- `reimbursement` \u8868\uff1a`expense_type`\u3001`amount` \u6807\u8bb0\u4e3a\u5e9f\u5f03\u5b57\u6bb5\uff0c\u4fdd\u7559\u7528\u4e8e\u5386\u53f2\u5355\u53ea\u8bfb\uff1b\u65b0\u589e `total_amount`\uff08\u7531\u660e\u7ec6\u6c47\u603b\u6216\u7f13\u5b58\u5b57\u6bb5\uff09\u3002\n\n---\n\n## 9. \u9a8c\u6536\u7528\u4f8b\n\n| \u7f16\u53f7 | \u573a\u666f | \u9884\u671f\u7ed3\u679c |\n| --- | --- | --- |\n| TC-01 | \u65b0\u5efa\u5355\u636e\u6dfb\u52a0\u6253\u8f66\u8d39\u3001\u9910\u8d39\u3001\u4f4f\u5bbf\u8d39 3 \u884c\u5e76\u63d0\u4ea4 | \u4fdd\u5b58\u6210\u529f\uff0c\u603b\u91d1\u989d = \u4e09\u884c\u4e4b\u548c\uff0c\u5ba1\u6279\u9875\u53ef\u89c1 3 \u884c |\n| TC-02 | \u660e\u7ec6\u4e3a\u7a7a\u6216\u67d0\u884c\u91d1\u989d\u4e3a 0 | \u63d0\u4ea4\u88ab\u963b\u6b62\u5e76\u7ed9\u51fa\u660e\u786e\u63d0\u793a |\n| TC-03 | \u4e0a\u4f20 3 \u5f20\u53d1\u7968\uff0c\u4e3b\u7ba1\u5728\u5ba1\u6279\u9875\u70b9\u51fb\u653e\u5927\u5e76\u5de6\u53f3\u5207\u6362 | \u6b63\u5e38\u9884\u89c8\uff0c\u53ef\u4e0b\u8f7d\u539f\u56fe\uff0c\u4e0e\u660e\u7ec6\u884c\u4e00\u4e00\u5bf9\u5e94 |\n| TC-04 | \u4e3b\u7ba1\u9a73\u56de\u5e76\u5173\u8054\u67d0\u660e\u7ec6\u884c | \u5458\u5de5\u6536\u5230\u901a\u77e5\uff0c\u5355\u636e\u56de\u5230\u8349\u7a3f/\u53ef\u7f16\u8f91\uff0c\u8be5\u884c\u9ad8\u4eae\u63d0\u793a |\n| TC-05 | \u8d22\u52a1\u6309\u201c\u4e0a\u6708 + \u90e8\u95e8 + \u5df2\u901a\u8fc7\u201d\u5bfc\u51fa\u660e\u7ec6\u6a21\u5f0f | xlsx \u884c\u6570\u4e0e\u67e5\u8be2\u7ed3\u679c\u660e\u7ec6\u6761\u6570\u4e00\u81f4\uff0c\u91d1\u989d\u5408\u8ba1\u4e00\u81f4 |\n| TC-06 | \u5bfc\u51fa\u6570\u636e >5000 \u6761 | \u8f6c\u5f02\u6b65\u4efb\u52a1\uff0c\u5b8c\u6210\u540e\u5728\u4e0b\u8f7d\u4e2d\u5fc3\u53ef\u4e0b\u8f7d |\n| TC-07 | \u6253\u5f00\u6539\u9020\u524d\u7684\u5386\u53f2\u62a5\u9500\u5355 | \u53ef\u6b63\u5e38\u67e5\u770b\u8be6\u60c5\u3001\u5ba1\u6279\u8bb0\u5f55\uff0c\u5c55\u793a\u4e3a 1 \u6761\u660e\u7ec6\uff0c\u65e0\u62a5\u9519 |\n| TC-08 | \u5c1d\u8bd5\u7f16\u8f91\u5386\u53f2\u62a5\u9500\u5355 | \u7981\u6b62\u7f16\u8f91\uff0c\u63d0\u793a\u8d70\u201c\u4f5c\u5e9f + \u91cd\u65b0\u63d0\u4ea4\u201d |\n| TC-09 | \u65e0\u6743\u9650\u7528\u6237\u76f4\u63a5\u8bbf\u95ee\u9644\u4ef6\u94fe\u63a5 | \u8fd4\u56de\u65e0\u6743\u9650\uff0c\u4e0d\u6cc4\u9732\u6587\u4ef6\u5185\u5bb9 |\n| TC-10 | \u65b0\u65e7\u6570\u636e\u6df7\u5408\u671f\u95f4