b\n  - \u660e\u7ec6\u884c\uff1a\u8d39\u7528\u7c7b\u578b\u3001\u53d1\u751f\u65e5\u671f\u3001\u91d1\u989d\u3001\u8bf4\u660e\u3001\u53d1\u7968\u7167\u7247\uff08\u53ef\u591a\u5f20\uff09\u3002\n- \u8d39\u7528\u7c7b\u578b\uff1a\u6253\u8f66\u8d39\u3001\u9910\u8d39\u3001\u4f4f\u5bbf\u8d39\u3001\u4ea4\u901a\u8d39\u3001\u529e\u516c\u7528\u54c1\u3001\u5176\u4ed6\uff08\u652f\u6301\u540e\u53f0\u914d\u7f6e\u5b57\u5178\u9879\uff09\u3002\n- \u652f\u6301\u660e\u7ec6\u884c\u7684\u65b0\u589e\u3001\u5220\u9664\u3001\u7f16\u8f91\uff1b\u5355\u5f20\u62a5\u9500\u5355\u660e\u7ec6\u884c\u6570\u4e0a\u9650 50 \u884c\u3002\n- \u660e\u7ec6\u91d1\u989d\u5408\u8ba1\u81ea\u52a8\u8ba1\u7b97\u5e76\u5c55\u793a\u4e8e\u5355\u5934\u3002\n- \u63d0\u4ea4\u6821\u9a8c\uff1a\u81f3\u5c11 1 \u6761\u660e\u7ec6\uff1b\u91d1\u989d > 0\uff1b\u5fc5\u586b\u9879\u5b8c\u6574\u3002\n- \u62a5\u9500\u5355\u5728\u300c\u8349\u7a3f\u300d\u300c\u5df2\u9a73\u56de\u300d\u72b6\u6001\u4e0b\u53ef\u7f16\u8f91\u660e\u7ec6\uff0c\u300c\u5ba1\u6279\u4e2d\u300d\u300c\u5df2\u901a\u8fc7\u300d\u72b6\u6001\u4e0b\u53ea\u8bfb\u3002\n\n### 4.2 \u53d1\u7968\u7167\u7247\u4e0a\u4f20\u4e0e\u67e5\u770b\n\n- \u6bcf\u6761\u660e\u7ec6\u652f\u6301\u4e0a\u4f20 0\u2013N \u5f20\u53d1\u7968\u7167\u7247\uff08N \u9ed8\u8ba4 9\uff0c\u53ef\u914d\u7f6e\uff09\uff1b\n- \u652f\u6301\u683c\u5f0f\uff1ajpg / jpeg / png / pdf\uff1b\u5355\u5f20\u5927\u5c0f \u2264 10MB\uff1b\n- \u5458\u5de5\u63d0\u4ea4\u65f6\u53ef\u8bbe\u7f6e\u300c\u65e0\u53d1\u7968\u300d\u6807\u8bb0\uff08\u9700\u586b\u5199\u539f\u56e0\uff0c\u7528\u4e8e\u5c0f\u989d\u514d\u7968\u573a\u666f\uff0c\u89c4\u5219\u7531\u8d22\u52a1\u914d\u7f6e\uff09\uff1b\n- \u90e8\u95e8\u4e3b\u7ba1\u5ba1\u6279\u754c\u9762\u3001\u8d22\u52a1\u67e5\u8be2\u754c\u9762\u53ef\u67e5\u770b\u660e\u7ec6\u5217\u8868\uff0c\u5e76\u70b9\u51fb\u67e5\u770b/\u653e\u5927\u53d1\u7968\u7167\u7247\u539f\u56fe\uff1b\n- \u7167\u7247\u652f\u6301\u5728\u7ebf\u9884\u89c8\u3001\u4e0b\u8f7d\u3002\n\n### 4.3 \u5ba1\u6279\u6d41\u7a0b\n\n- \u63d0\u4ea4\u540e\u8fdb\u5165\u90e8\u95e8\u4e3b\u7ba1\u5ba1\u6279\uff1b\n- \u5ba1\u6279\u754c\u9762\u5c55\u793a\uff1a\u5355\u5934\u4fe1\u606f\u3001\u5168\u90e8\u660e\u7ec6\u884c\u3001\u53d1\u7968\u7167\u7247\u5165\u53e3\u3001\u603b\u989d\uff1b\n- \u5ba1\u6279\u64cd\u4f5c\uff1a\u901a\u8fc7 / \u9a73\u56de\uff08\u9a73\u56de\u5fc5\u586b\u610f\u89c1\uff09\uff0c\u9a73\u56de\u540e\u9000\u56de\u5458\u5de5\u53ef\u4fee\u6539\u540e\u91cd\u65b0\u63d0\u4ea4\uff1b\n- \u5ba1\u6279\u8bb0\u5f55\u7559\u75d5\uff1a\u64cd\u4f5c\u4eba\u3001\u65f6\u95f4\u3001\u610f\u89c1\u3002\n\n### 4.4 \u8d22\u52a1\u5bfc\u51fa\n\n- \u8d22\u52a1\u53ef\u6309\u6761\u4ef6\u7b5b\u9009\uff08\u65f6\u95f4\u8303\u56f4\u3001\u90e8\u95e8\u3001\u5458\u5de5\u3001\u8d39\u7528\u7c7b\u578b\u3001\u72b6\u6001\uff09\u540e\u5bfc\u51fa Excel\uff1b\n- \u5bfc\u51fa\u7c92\u5ea6\uff1a\u4e00\u884c\u4e00\u6761\u8d39\u7528\u660e\u7ec6\uff0c\u540c\u65f6\u643a\u5e26\u5355\u5934\u5b57\u6bb5\uff08\u62a5\u9500\u5355\u53f7\u3001\u7533\u8bf7\u4eba\u3001\u90e8\u95e8\u3001\u72b6\u6001\u3001\u5ba1\u6279\u4eba\u3001\u5ba1\u6279\u65f6\u95f4\u7b49\uff09\uff1b\n- \u5bfc\u51fa\u5b57\u6bb5\u5305\u542b\uff1a\u8d39\u7528\u7c7b\u578b\u3001\u53d1\u751f\u65e5\u671f\u3001\u91d1\u989d\u3001\u8bf4\u660e\u3001\u53d1\u7968\u6587\u4ef6\u540d/\u5f20\u6570\uff1b\n- \u652f\u6301\u5bfc\u51fa\u53d1\u7968\u7167\u7247\u6253\u5305\u4e3a zip\uff08\u6309\u62a5\u9500\u5355\u53f7/\u660e\u7ec6\u7ec4\u7ec7\u76ee\u5f55\uff09\uff1b\n- \u5355\u6b21\u5bfc\u51fa\u8d85\u8fc7 1 \u4e07\u884c\u65f6\u91c7\u7528\u5f02\u6b65\u5bfc\u51fa\uff0c\u5b8c\u6210\u540e\u7ad9\u5185\u901a\u77e5\u4e0b\u8f7d\u3002\n\n### 4.5 \u5386\u53f2\u6570\u636e\u517c\u5bb9\n\n- \u5386\u53f2\u62a5\u9500\u5355\uff08\u65e7\u5355\u8d39\u7528\u7c7b\u578b\u7ed3\u6784\uff09\u5728\u6570\u636e\u8fc1\u79fb\u540e\u6620\u5c04\u4e3a 1 \u6761\u660e\u7ec6\u884c\uff0c\u524d\u7aef\u5c55\u793a\u4e0e\u67e5\u8be2\u903b\u8f91\u7edf\u4e00\uff1b\n- \u5386\u53f2\u5355\u636e\u4fdd\u6301\u539f\u72b6\u6001\u4e0e\u539f\u5b57\u6bb5\uff0c\u53ea\u8bfb\u67