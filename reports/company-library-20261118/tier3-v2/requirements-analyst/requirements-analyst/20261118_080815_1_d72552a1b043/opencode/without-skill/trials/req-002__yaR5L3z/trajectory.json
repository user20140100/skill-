00\u4e8b\u7531\u3001\u8d39\u7528\u6240\u5c5e\u671f\u95f4\u3001\u62a5\u9500\u603b\u91d1\u989d\uff08\u660e\u7ec6\u6c47\u603b\uff0c\u53ea\u8bfb\uff09\u3001\u660e\u7ec6\u7b14\u6570\uff08\u53ea\u8bfb\uff09\u3002\n\n**\u660e\u7ec6\u884c\u5b57\u6bb5**\uff1a\n\n| \u5b57\u6bb5 | \u5fc5\u586b | \u8bf4\u660e |\n|---|---|---|\n| \u8d39\u7528\u7c7b\u578b | \u662f | \u4e0b\u62c9\u9009\u62e9\uff1a\u6253\u8f66\u8d39\u3001\u9910\u8d39\u3001\u4f4f\u5bbf\u8d39\u3001\u4ea4\u901a\u8d39\u3001\u57f9\u8bad\u8d39\u3001\u529e\u516c\u7528\u54c1\u3001\u5176\u4ed6 |\n| \u53d1\u751f\u65e5\u671f | \u662f | \u4e0d\u5f97\u665a\u4e8e\u63d0\u4ea4\u65e5\u671f\uff0c\u4e0d\u5f97\u65e9\u4e8e\u8d39\u7528\u671f\u95f4\u8d77\u59cb\u65e5 |\n| \u91d1\u989d | \u662f | \u5927\u4e8e 0\uff0c\u6700\u591a 2 \u4f4d\u5c0f\u6570\uff0c\u5e01\u79cd\u9ed8\u8ba4\u4eba\u6c11\u5e01 |\n| \u8d39\u7528\u8bf4\u660e | \u5426 | 200 \u5b57\u4ee5\u5185 |\n| \u53d1\u7968 | \u5426 | \u5173\u8054\u672c\u884c\u53d1\u7968\uff0c\u89c1 FR-2 |\n\n**\u4e1a\u52a1\u89c4\u5219**\uff1a\n1. \u660e\u7ec6\u81f3\u5c11 1 \u6761\uff0c\u6700\u591a 50 \u6761\uff1b\u652f\u6301\u65b0\u589e\u3001\u5220\u9664\u3001\u884c\u5185\u7f16\u8f91\u3002\n2. \u62a5\u9500\u603b\u91d1\u989d = \u6240\u6709\u660e\u7ec6\u91d1\u989d\u4e4b\u548c\uff0c\u5b9e\u65f6\u8ba1\u7b97\uff0c\u4e0d\u5141\u8bb8\u624b\u5de5\u4fee\u6539\u3002\n3. \u540c\u4e00\u5355\u636e\u5185\u5141\u8bb8\u51fa\u73b0\u91cd\u590d\u8d39\u7528\u7c7b\u578b\uff08\u4e0d\u540c\u65e5\u671f/\u4e0d\u540c\u91d1\u989d\uff09\u3002\n4. \u5355\u636e\u72b6\u6001\u4e3a\u300c\u8349\u7a3f\u300d\u300c\u5df2\u9a73\u56de\u300d\u65f6\u53ef\u7f16\u8f91\u660e\u7ec6\uff1b\u300c\u5ba1\u6279\u4e2d\u300d\u300c\u5df2\u901a\u8fc7\u300d\u4e0d\u53ef\u7f16\u8f91\u3002\n5. \u63d0\u4ea4\u65f6\u6821\u9a8c\uff1a\u660e\u7ec6\u975e\u7a7a\u3001\u5fc5\u586b\u9879\u5b8c\u6574\u3001\u91d1\u989d\u5408\u6cd5\u3001\u5355\u6761\u660e\u7ec6\u81f3\u5c11\u5173\u8054\u4e00\u5f20\u53d1\u7968\uff08\u53ef\u6309\u8d39\u7528\u7c7b\u578b\u914d\u7f6e\u662f\u5426\u5f3a\u5236\u53d1\u7968\uff0c\u9ed8\u8ba4\u5f3a\u5236\uff1b\u65e0\u53d1\u7968\u573a\u666f\u9700\u586b\u5199\u300c\u65e0\u53d1\u7968\u539f\u56e0\u300d\uff09\u3002\n\n**\u9a8c\u6536\u6807\u51c6**\uff1a\n- \u4e00\u5f20\u5355\u5185\u6df7\u5408\u5f55\u5165\u6253\u8f66\u8d39\u3001\u9910\u8d39\u3001\u4f4f\u5bbf\u8d39\u5171 3 \u6761\u660e\u7ec6\u53ef\u6210\u529f\u63d0\u4ea4\uff0c\u603b\u91d1\u989d\u6b63\u786e\u3002\n- \u660e\u7ec6\u4e3a\u7a7a\u6216\u91d1\u989d\u975e\u6cd5\u65f6\u63d0\u4ea4\u88ab\u62e6\u622a\u5e76\u7ed9\u51fa\u660e\u786e\u63d0\u793a\u3002\n\n### FR-2 \u53d1\u7968\u4e0a\u4f20\u4e0e\u67e5\u770b\n\n**\u63cf\u8ff0**\uff1a\u6bcf\u6761\u8d39\u7528\u660e\u7ec6\u652f\u6301\u5173\u8054\u4e0a\u4f20\u53d1\u7968\u7167\u7247\uff0c\u5ba1\u6279\u4eba\u53ef\u5728\u5355\u636e\u8be6\u60c5\u9875\u67e5\u770b\u3002\n\n**\u4e0a\u4f20\u8981\u6c42**\uff1a\n1. \u683c\u5f0f\uff1aJPG / JPEG / PNG / PDF\uff1b\u5355\u6587\u4ef6\u5927\u5c0f \u2264 10MB\u3002\n2. \u5355\u6761\u660e\u7ec6\u652f\u6301\u591a\u5f20\u53d1\u7968\uff1b\u4e00\u5f20\u5355\u5408\u8ba1\u6700\u591a 100 \u5f20\u3002\n3. \u652f\u6301\u62cd\u7167\u4e0a\u4f20\u4e0e\u672c\u5730\u6587\u4ef6\u4e0a\u4f20\uff1b\u4e0a\u4f20\u5931\u8d25\u7ed9\u51fa\u53ef\u91cd\u8bd5\u63d0\u793a\u3002\n4. \u652f\u6301\u5220\u9664\u5df2\u4e0a\u4f20\u53d1\u7968\uff08\u4ec5\u300c\u8349\u7a3f\u300d\u300c\u5df2\u9a73\u56de\u300d\u72b6\u6001\u53ef\u5220\u6539\uff09\u3002\n\n**\u67e5\u770b\u8981\u6c42**\uff1a\n1. \u5355\u636e\u8be6\u60c5\u9875\u6309\u300c\u660e\u7ec6\u884c \u2192 \u8be5\u53d1\u7968\u7f29\u7565\u56fe\u300d\u7684\u7ed3\u6784\u5c55\u793a\uff0c\u660e\u7ec6\u4e0e\u53d1\u7968\u4e00\u4e00\u5bf9\u5e94\u3002\n2. \u70b9\u51fb\u7f29\u7565\u56fe\u8fdb\u5165\u5927\u56fe\u9884\u89c8\uff0c\u652f\u6301\u653e\u5927/\u7f29\u5c0f\u3001\u4e0a\u4e00\u5f20/\u4e0b\u4e00\u5f20\u5207\u6362\u3002\n3. \u56fe\u7247\u52a0\u8f7d\u5931\u8d25\u65f6\u5c55\u793a\u5360\u4f4d\u4e0e\u91cd\u8bd5\u5165\u53e3\uff0c\u4e0d\u963b\u65ad\u5355\u636e\u5176\u4ed6\u4fe1\u606f\u67e5\u770b\u3002\n4. \u5ba1\u6279\u9875\u4e0e\u8d22\u52a1\u67e5\u8be2\u9875\u5747\u53ef\u67e5\u770b\u53d1\u7968\uff0c\u67e5\u770b\u884c\u4e3a\u9700\u8bb0\u5f55\u8bbf\u95ee\u65e5\u5fd7\u3002\n\n**\u9a8c\u6536\u6807\u51c6**\uff1a\n- \u4e3b\u7ba1\u5728\u5ba1\u6279\u9875\u9762\u53ef\u89c1\u6bcf\u6761\u660e\u7ec6\u5bf9\u5e94\u7684\u53d1\u7968\u5e76\u53ef\u653e\u5927\u67e5\u770b\uff0c\u65e0\u9700\u4e0b\u8f7d\u3002\n- \u4e0a\u4f20 11MB \u6587\u4ef6\u6216\u975e\u652f\u6301\u683c\u5f0f\u65f6\u88ab\u62e6\u622a\u5e76\u63d0\u793a\u539f\u56e0\u3002\n\n### FR-3 \u5ba1\u6279\u73af\u8282\u589e\u5f3a\n\n**\u63cf\u8ff0**\uff1a\u5728\u73b0\u6709\u5ba1\u6279\u6d41\u7a0b\u57fa\u7840\u4e0a\uff0c\u6269\u5c55\u5ba1\u6279\u4eba\u53ef\u89c1\u4fe1\u606f\u3002\n\n1. \u5ba1\u6279\u9875\u9762\u5b8c\u6574\u5c55\u793a\uff1a\u5355\u5934\u4fe1\u606f\u3001\u8d39\u7528\u660e\u7ec6\u5217\u8868\uff08\u542b\u5206\u7c7b\u578b\u5c0f\u8ba1\uff09\u3001\u62a5\u9500\u603b\u91d1\u989d\u3001\u5168\u90e8\u53d1\u7968\u7167\u7247\u3002\n2. \u5ba1\u6279\u64cd\u4f5c\u4fdd\u6301\u73b0\u6709\u8bed\u4e49\uff1a\u901a\u8fc7\u3001\u9a73\u56de\uff08\u5fc5\u586b\u610f\u89c1\uff09\u3001\u9000\u56de\u4fee\u6539\uff08\u5fc5\u586b\u610f\u89c1\uff09\u3002\n3. \u9a73\u56de/\u9000\u56de\u540e\u5355\u636e\u56de\u5230\u5458\u5de5\u300c\u5df2\u9a73\u56de\u300d\u72b6\u6001\uff0c\u5458\u5de5\u53ef\u4fee\u6539\u660e\u7ec6\u4e0e\u53d1\u7968\u540e\u91cd\u65b0\u63d0\u4ea4\uff0c\u91cd\u65b0\u63d0\u4ea4\u9700\u4fdd\u7559\u5386\u53f2\u5ba1\u6279\u8bb0\u5f55\u3002\n4. \u5217\u8868\u9875\u589e\u52a0\u300c\u660e\u7ec6\u7b14\u6570\u300d\u300c\u62a5\u9500\u603b\u91d1\u989d\u300d\u5c55\u793a\uff0c\u4fbf\u4e8e\u6279\u91cf\u5904\u7406\u3002\n\n**\u9a8c\u6536\u6807\u51c6**\uff1a\u5ba1\u6279\u4eba\u4f9d\u636e\u9875\u9762\u4fe1\u606f\u5373\u53ef\u5b8c\u6210\u53d1\u7968\u4e0e\u91d1\u989d\u6838\u5bf9\uff0c\u5168\u6d41\u7a0b\u65e0\u9700\u7ebf\u4e0b\u8865\u5145\u6750\u6599\u3002\n\n### FR-4 \u8d22\u52a1\u67e5\u8be2\u4e0e\u5bfc\u51fa\n\n**\u63cf\u8ff0**\uff1a\u8d22\u52a1\u6309\u6761\u4ef6\u67e5\u8be2\u62a5\u9500\u6570\u636e\u5e76\u5bfc\u51fa\u6587\u4ef6\u3002\n\n**\u67e5\u8be2\u6761\u4ef6**\uff1a\u62a5\u9500\u4eba\u3001\u90e8\u95e8\u3001\u5355\u636e\u72b6\u6001\u3001\u63d0\u4ea4\u65f6\u95f4\u533a\u95f4\u3001\u8d39\u7528\u53d1\u751f\u65e5\u671f\u533a\u95f4\u3001\u8d39\u7528\u7c7b\u578b\u3001\u91d1\u989d\u533a\u95f4\u3002\n\n**\u5bfc\u51fa\u89c4\u5219**\uff1a\n1. \u652f\u6301\u300c\u6309\u5355\u636e\u300d\u548c\u300c\u6309\u8d39\u7528\u660e\u7ec6\u300d\u4e24\u79cd\u5bfc\u51fa\u7c92\u5ea6\uff1b\u9ed8\u8ba4\u6309\u660e\u7ec6\u5bfc\u51fa\u3002\n2. \u6587\u4ef6\u683c\u5f0f\uff1a`.xlsx`\uff08\u517c\u5bb9 `.csv`\uff09\u3002\n3. \u5355\u6b21\u5bfc\u51fa\u4e0a\u9650 10 \u4e07\u884c\uff1b\u8d85\u4e0a\u9650\u65f6\u63d0\u793a\u7f29\u5c0f\u67e5\u8be2\u8303\u56f4\u3002\n4. \u5bfc\u51fa\u5b57\u6bb5\uff08\u6309\u660e\u7ec6\u7c92\u5ea6\uff09\uff1a\u5355\u636e\u7f16\u53f7\u3001\u62a5\u9500\u4eba\u3001\u90e8\u95e8\u3001\u5355\u636e\u72b6\u6001\u3001\u63d0\u4ea4\u65f6\u95f4\u3001\u5ba1\u6279\u5b8c\u6210\u65f6\u95f4\u3001\u5ba1\u6279\u4eba\u3001\u8d39\u7528\u7c7b\u578b\u3001\u53d1\u751f\u65e5\u671f\u3001\u91d1\u989d\u3001\u8d39\u7528\u8bf4\u660e\u3001\u62a5\u9500\u4e8b\u7531\u3001\u5355\u636e\u603b\u91d1\u989d\u3001\u53d1\u7968\u5f20\u6570\u3002\n5. \u5bfc\u51fa\u4e3a\u5f02\u6b65\u4efb\u52a1\uff0c\u5b8c\u6210\u540e\u5728\u4e0b\u8f7d\u4e2d\u5fc3\u63d0\u4f9b\u6587\u4ef6\u4e0b\u8f7d\uff0c\u94fe\u63a5\u6709\u6548\u671f 7 \u5929\u3002\n6. \u5bfc\u51fa\u64cd\u4f5c\u8bb0\u5f55\u64cd\u4f5c\u4eba\u3001\u65f6\u95f4\u3001\u67e5\u8be2\u6761\u4ef6\u3001\u5bfc\u51fa\u884c\u6570\u3002\n7. \u53d1\u7968\u7167\u7247\u4e0d\u5185\u5d4c\u4e8e\u8868\u683c\u6587\u4ef6\uff1b\u5982\u9700\u5f71\u50cf\u5f52\u6863\uff0c\u63d0\u4f9b\u5355\u636e\u7f16\u53f7\u4e0e\u53d1\u7968\u6587\u4ef6\u7684\u5bf9\u5e94\u5173\u7cfb\u6e05\u5355\u3002\n\n**\u9a8c\u6536\u6807\u51c6**\uff1a\u8d22\u52a1\u9009\u62e9\u67d0\u6708\u533a\u95f4\u5bfc\u51fa\uff0c\u6240\u5f97\u660e\u7ec6\u884c\u91d1\u989d\u4e4b\u548c\u4e0e\u8be5\u6708\u5df2\u5ba1\u6279\u901a\u8fc7\u5355\u636e\u603b\u91d1\u989d\u4e00\u81f4\u3002\n\n### FR-5 \u5386\u53f2\u6570\u636e\u517c\u5bb9\n\n**\u63cf\u8ff0**\uff1a\u4fdd\u969c\u6539\u9020\u524d\u5b58\u91cf\u62a5\u9500\u5355\u53ef\u7528\u3001\u53ef\u8bfb\u3001\u4e0d\u62a5\u9519\u3002\n\n1. \u5386\u53f2\u5355\u4e3a\u300c\u5355\u8d39\u7528\u7c7b\u578b\u300d\u7ed3\u6784\uff0c\u65b0\u7cfb\u7edf\u7edf\u4e00\u6309\u300c1 \u6761\u660e\u7ec6 + \u5355\u636e\u8d39\u7528\u7c7b\u578b/\u91d1\u989d\u300d\u6620\u5c04\u5c55\u793a\u3002\n2. \u5386\u53f2\u5355\u82e5\u539f\u65e0\u53d1\u7968\u9644\u4ef6\uff0c\u53d1\u7968\u533a\u57df\u5c55\u793a\u300c\u5386\u53f2\u5355\u636e\u672a\u4e0a\u4f20\u53d1\u7968\u300d\u63d0\u793a\uff0c\u4e0d\u5f97\u62a5\u9519\u6216\u7a7a\u767d\u5f02\u5e38\u3002\n3. \u5386\u53f2\u5355\u4ec5\u5141\u8bb8\u67e5\u770b\uff0c**\u4e0d\u5141\u8bb8\u7f16\u8f91\u3001\u4e0d\u5141\u8bb8\u91cd\u65b0\u63d0\u4ea4\u3001\u4e0d\u5141\u8bb8\u64a4\u56de**\u3002\n4. \u5386\u53f2\u5355\u7eb3\u5165\u8d22\u52a1\u67e5\u8be2\u4e0e\u5bfc\u51fa\uff0c\u8d39\u7528\u7c7b\u578b\u53d6\u539f\u5355\u636e\u7c7b\u578b\uff0c\u660e\u7ec6\u7b14\u6570\u8bb0\u4e3a 1\u3002\n5. \u65b0\u65e7\u6570\u636e\u5728\u5217\u8868\u4e2d\u7edf\u4e00\u6392\u5e8f\u3001\u7edf\u4e00\u7b5b\u9009\uff0c\u7528\u6237\u65e0\u9700\u611f\u77e5\u6570\u636e\u7ed3\u6784\u5dee\u5f02\u3002\n6. \u4e0a\u7ebf\u524d\u5b8c\u6210\u5386\u53f2\u6570\u636e\u8fc1\u79fb/\u9002\u914d\u6821\u9a8c\uff0c\u6821\u9a8c\u9879\u5305\u542b\uff1a\u5355\u636e\u6570\u91cf\u4e00\u81f4\u3001\u91d1\u989d\u603b\u548c\u4e00\u81f4\u3001\u5b57\u6bb5\u53ef\u6b63\u5e38\u6e32\u67d3\u3002\n\n**\u9a8c\u6536\u6807\u51c6**\uff1a\u968f\u673a\u62bd\u67e5\u6539\u9020\u524d\u5404\u5e74\u5ea6\u7684\u5386\u53f2\u62a5\u9500\u5355\uff0c\u53ef\u6b63\u5e38\u6253\u5f00\u3001\u4fe1\u606f\u5b8c\u6574\u3001\u91d1\u989d\u4e0e\u65e7\u7cfb\u7edf\u4e00\u81f4\u3002\n\n## 6. \u72b6\u6001\u4e0e\u6d41\u7a0b\n\n```\n\u8349\u7a3f \u2192 \u5df2\u63d0\u4ea4(\u5ba1\u6279\u4e2d) \u2192 \u5df2\u901a\u8fc7 \u2192 \u8d22\u52a1\u5df2\u5bfc\u51fa/\u5f52\u6863\n                \u2198 \u5df2\u9a73\u56de(\u53ef\u7f16\u8f91\u540e\u91cd\u65b0\u63d0\u4ea4)\n                \u2198 \u5df2\u9000\u56de\u4fee\u6539(\u53ef\u7f16\u8f91\u540e\u91cd\u65b0\u63d0\u4ea4)\n```\n\n| \u72b6\u6001 | \u5458\u5de5\u53ef\u64cd\u4f5c | \u4e3b\u7ba1\u53ef\u64cd\u4f5c | \u8d22\u52a1\u53ef\u89c1 |\n|---|---|---|---|\n| \u8349\u7a3f | \u7f16\u8f91\u3001\u5220\u9664\u3001\u63d0\u4ea4 | \u2014 | \u5426 |\n| \u5ba1\u6279\u4e2d | \u64a4\u56de | \u901a\u8fc7\u3001\u9a73\u56de\u3001\u9000\u56de\u4fee\u6539 | \u662f\uff08\u53ea\u8bfb\uff09 |\n| \u5df2\u9a73\u56de/\u5df2\u9000\u56de | \u7f16\u8f91\u3001\u91cd\u65b0\u63d0\u4ea4\u3001\u5220\u9664 | \u2014 | \u662f\uff08\u53ea\u8bfb\uff09 |\n| \u5df2\u901a\u8fc7 | \u67e5\u770b | \u67e5\u770b | \u662f\uff08\u53ea\u8bfb+\u5bfc\u51fa\uff09 |\n\n## 7. \u975e\u529f\u80fd\u9700\u6c42\n\n| \u7c7b\u522b | \u8981\u6c42 |\n|---|---|\n| \u6027\u80fd | \u5355\u636e\u8be6\u60c5\u9875\uff08\u542b 100 \u5f20\u53d1\u7968\u7f29\u7565\u56fe\uff09\u9996\u5c4f\u52a0\u8f7d \u2264 3s\uff1b\u53d1\u7968\u5927\u56fe\u52a0\u8f7d \u2264 2s\uff1b\u63d0\u4ea4/\u5ba1\u6279\u64cd\u4f5c\u54cd\u5e94 \u2264 1s\uff1b\u652f\u6301 200 \u5e76\u53d1\u586b\u5199 |\n| \u5bb9\u91cf | \u9644\u4ef6\u603b\u5bb9\u91cf\u6309\u8fd1 3 \u5e74\u5386\u53f2\u6570\u636e + \u672a\u6765 1 \u5e74\u589e\u957f\u9884\u7559\uff1b\u5355\u6587\u4ef6 \u2264 10MB |\n| \u5b89\u5168\u4e0e\u6743\u9650 | \u53d1\u7968\u4e0e\u62a5\u9500\u6570\u636e\u6309\u89d2\u8272\u6700\u5c0f\u53ef\u89c1\u539f\u5219\u6388\u6743\uff1b\u63a5\u53e3\u9274\u6743\u6821\u9a8c\u6570\u636e\u5f52\u5c5e\uff1b\u5bfc\u51fa\u6587\u4ef6\u8bbf\u95ee\u9700\u767b\u5f55\u4e14\u94fe\u63a5\u4e0d\u53ef\u8f6c\u53d1 |\n| \u5ba1\u8ba1 | \u65b0\u5efa\u3001\u63d0\u4ea4\u3001\u64a4\u56de\u3001\u5ba1\u6279\u3001\u7f16\u8f91\u3001\u5bfc\u51fa\u3001\u53d1\u7968\u67e5\u770b\u5747\u8bb0\u5f55\u64cd\u4f5c\u65e5\u5fd7\uff08\u64cd\u4f5c\u4eba\u3001\u65f6\u95f4\u3001\u52a8\u4f5c\u3001\u5bf9\u8c61\uff09\uff0c\u65e5\u5fd7\u4fdd\u7559 \u2265 3 \u5e74 |\n| \u53ef\u7528\u6027 | \u670d\u52a1\u53ef\u7528\u6027 \u2265 99.9%\uff1b\u6587\u4ef6\u5b58\u50a8\u670d\u52a1\u5f02\u5e38\u65f6\u4e0d\u5f71\u54cd\u5355\u636e\u6587\u672c\u4fe1\u606f\u586b\u5199\u4e0e\u67e5\u770b |\n| \u517c\u5bb9\u6027 | \u4e3b\u6d41\u6d4f\u89c8\u5668\uff08Chrome/Edge \u6700\u65b0\u4e24\u4e2a\u7248\u672c\uff09\uff1b\u4e0a\u4f20\u652f\u6301\u79fb\u52a8\u7aef\u62cd\u7167\u4e0e PC \u7aef\u672c\u5730\u6587\u4ef6 |\n\n## 8. \u6570\u636e\u9700\u6c42\n\n- **\u65b0\u589e\u8868 \u62a5\u9500\u5355\u5934 reimburse_header**\uff1a\u6cbf\u7528\u73b0\u6709\u4e3b\u952e\u4e0e\u5b57\u6bb5\uff0c\u65b0\u589e/\u786e\u8ba4 \u603b\u91d1\u989d\u3001\u660e\u7ec6\u7b14\u6570\u3001\u5355\u636e\u7248\u672c\u6807\u8bc6\uff08\u7528\u4e8e\u533a\u5206\u65b0\u65e7\u7ed3\u6784\uff09\u3002\n- **\u65b0\u589e\u8868 \u8d39\u7528\u660e\u7ec6 reimburse_item**\uff1aid\u3001\u5355\u636e\u7f16\u53f7\u3001\u5e8f\u53f7\u3001\u8d39\u7528\u7c7b\u578b\u3001\u53d1\u751f\u65e5\u671f\u3001\u91d1\u989d\u3001\u8bf4\u660e\u3001\u65e0\u53d1\u7968\u539f\u56e0\u3001\u521b\u5efa/\u66f4\u65b0\u65f6\u95f4\u3002\n- **\u65b0\u589e\u8868 \u53d1\u7968\u9644\u4ef6 reimburse_attachment**\uff1aid\u3001\u660e\u7ec6 id\u3001\u5355\u636e\u7f16\u53f7\u3001\u6587\u4ef6\u540d\u3001\u5b58\u50a8\u8def\u5f84\u3001\u6587\u4ef6\u7c7b\u578b\u3001\u6587\u4ef6\u5927\u5c0f\u3001\u4e0a\u4f20\u4eba\u3001\u4e0a\u4f20\u65f6\u95f4\u3002\n- **\u5b57\u5178 \u8d39\u7528\u7c7b\u578b expense_type**\uff1a\u7f16\u7801\u3001\u540d\u79f0\u3001\u662f\u5426\u5f3a\u5236\u53d1\u7968\u3001\u6392\u5e8f\u3001\u542f\u7528\u72b6\u6001\uff1b\u65b0\u589e\u7c7b\u578b\u652f\u6301\u914d\u7f6e\u5316\uff0c\u4e0d\u6539\u4ee3\u7801\u3002\n- \u660e\u7ec6\u4e0e\u53d1\u7968\u4e3a 1:N \u5173\u7cfb\uff0c\u5220\u9664\u660e\u7ec6\u65f6\u7ea7\u8054\u89e3\u7ed1\u5176\u53d1\u7968\u9644\u4ef6\u3002\n\n## 9. \u7ea6\u675f\u4e0e\u5047\u8bbe\n\n1. \u73b0\u6709\u5ba1\u6279\u6d41\u8f6c\u89c4\u5219\uff08\u5ba1\u6279\u5c42\u7ea7\u3001\u5ba1\u6279\u4eba\u5206\u914d\uff09\u4e0d\u5728\u672c\u6b21\u6539\u9020\u8303\u56f4\u5185\u3002\n2. \u8d39\u7528\u7c7b\u578b\u6e05\u5355\u4ee5\u8d22\u52a1\u786e\u8ba4\u7684\u5b57\u5178\u4e3a\u51c6\uff0c\u4e0a\u7ebf\u65f6\u53ef\u914d\u7f6e\u8c03\u6574\u3002\n3. \u5047\u8bbe\u516c\u53f8\u5df2\u6709\u6587\u4ef6\u5b58\u50a8\u670d\u52a1\u4e0e\u7edf\u4e00\u767b\u5f55\u9274\u6743\u80fd\u529b\u53ef\u590d\u7528\u3002\n4. \u5386\u53f2\u5355\u636e\u91d1\u989d\u4e00\u5f8b\u4e0d\u505a\u91cd\u65b0\u8ba1\u7b97\u6216\u6570\u636e\u4fee\u6b63\u3002\n\n## 10. \u4e0a\u7ebf\u4e0e\u56de\u6eda\n\n1. **\u6570\u636e\u8fc1\u79fb**\uff1a\u4e0a\u7ebf\u524d\u5728\u975e\u751f\u4ea7\u73af\u5883\u5168\u91cf\u6f14\u7ec3\u8fc1\u79fb\u4e0e\u5386\u53f2\u6570\u636e\u6e32\u67d3\u6821\u9a8c\u3002\n2. **\u7070\u5ea6**\uff1a\u5148\u5bf9 1 \u4e2a\u90e8\u95e8\u7070\u5ea6 1 \u5468\uff0c\u9a8c\u8bc1\u591a\u660e\u7ec6\u63d0\u4ea4\u3001\u5ba1\u6279\u67e5\u770b\u3001\u5bfc\u51fa\u4e09\u9879\u4e3b\u6d41\u7a0b\u540e\u5168\u91cf\u653e\u5f00\u3002\n3. **\u56de\u6eda**\uff1a\u4fdd\u7559\u65e7\u6570\u636e\u5feb\u7167\u4e0e\u65e7\u7248\u672c\u5165\u53e3\uff1b\u56de\u6eda\u4e0d\u5f71\u54cd\u5df2\u63d0\u4ea4\u65b0\u5355\u7684\u6570\u636e\u5b8c\u6574\u6027\uff0c\u5386\u53f2\u5355\u67e5\u770b\u529f\u80fd\u4e0d\u53d7\u635f\u3002\n\n## 11. \u98ce\u9669\u4e0e\u5e94\u5bf9\n\n| \u98ce\u9669 | \u5f71\u54cd | \u5e94\u5bf9 |\n|---|---|---|\n| \u5386\u53f2\u6570\u636e\u7ed3\u6784\u4e0e\u65b0\u660e\u7ec6\u6a21\u578b\u6620\u5c04\u4e0d\u4e00\u81f4 | \u5386\u53f2\u5355\u91d1\u989d/\u7c7b\u578b\u663e\u793a\u9519\u8bef | \u4ee5\u7248\u672c\u6807\u8bc6\u533a\u5206\u6765\u6e90\uff0c\u8fc1\u79fb\u524d\u540e\u505a\u91d1\u989d\u603b\u548c\u4e0e\u6761\u6570\u53cc\u5411\u6838\u5bf9 |\n| \u53d1\u7968\u9644\u4ef6\u91cf\u5927\u5bfc\u81f4\u5b58\u50a8\u4e0e\u52a0\u8f7d\u538b\u529b | \u5ba1\u6279\u9875\u53d8\u6162\u3001\u5b58\u50a8\u6210\u672c\u4e0a\u5347 | \u7f29\u7565\u56fe + \u539f\u56fe\u61d2\u52