3c\uff0c\u5177\u4f53\u4ee5\u914d\u7f6e\u4e3a\u51c6\uff09 |\n| \u5f00\u59cb\u65f6\u95f4 | \u65f6\u95f4 | \u662f | \u7cbe\u786e\u5230\u5206\u949f\uff1b\u987b\u65e9\u4e8e\u7ed3\u675f\u65f6\u95f4 |\n| \u7ed3\u675f\u65f6\u95f4 | \u65f6\u95f4 | \u662f | \u7cbe\u786e\u5230\u5206\u949f\uff1b\u987b\u665a\u4e8e\u5f00\u59cb\u65f6\u95f4 |\n| \u52a0\u73ed\u4e8b\u7531 | \u6587\u672c | \u5426 | \u9009\u586b\uff0c\u957f\u5ea6\u4e0d\u8d85\u8fc7 200 \u5b57 |\n\n**FR-4.1.2** \u52a0\u73ed\u65f6\u957f\u7531\u7cfb\u7edf\u6839\u636e\u5f00\u59cb\u65f6\u95f4\u4e0e\u7ed3\u675f\u65f6\u95f4\u81ea\u52a8\u8ba1\u7b97\uff0c\u8868\u5355\u4e2d\u53ea\u8bfb\u5c55\u793a\uff0c\u4e0d\u5141\u8bb8\u7528\u6237\u624b\u5de5\u4fee\u6539\u3002\n\n**FR-4.1.3** \u65f6\u957f\u8ba1\u7b97\u89c4\u5219\uff1a\n- \u9ed8\u8ba4\u6309 `\u7ed3\u675f\u65f6\u95f4 - \u5f00\u59cb\u65f6\u95f4` \u8ba1\u7b97\uff0c\u5355\u4f4d\u4e3a\u5c0f\u65f6\uff0c\u4fdd\u7559 1 \u4f4d\u5c0f\u6570\uff1b\n- \u5f53\u7ed3\u675f\u65f6\u95f4\u65e9\u4e8e\u5f00\u59cb\u65f6\u95f4\uff08\u8de8\u5929\u52a0\u73ed\uff09\u65f6\uff0c\u6309 `\u7ed3\u675f\u65f6\u95f4 + 24 \u5c0f\u65f6 - \u5f00\u59cb\u65f6\u95f4` \u8ba1\u7b97\uff1b\n- \u8ba1\u7b97\u7ed3\u679c\u987b\u5728\u63d0\u4ea4\u524d\u5b9e\u65f6\u56de\u663e\u7ed9\u7528\u6237\u786e\u8ba4\u3002\n\n**FR-4.1.4** \u63d0\u4ea4\u6210\u529f\u540e\uff0c\u7533\u8bf7\u5355\u72b6\u6001\u7f6e\u4e3a\u300c\u5f85\u5ba1\u6279\u300d\uff0c\u5e76\u751f\u6210\u552f\u4e00\u7533\u8bf7\u7f16\u53f7\u3002\n\n**FR-4.1.5** \u5458\u5de5\u53ef\u5728\u7533\u8bf7\u88ab\u5ba1\u6279\u524d\u64a4\u56de\u6216\u4fee\u6539\uff1b\u4e00\u65e6\u4ea7\u751f\u5ba1\u6279\u52a8\u4f5c\uff08\u540c\u610f/\u9a73\u56de\uff09\uff0c\u8be5\u7533\u8bf7\u4e0d\u53ef\u518d\u7f16\u8f91\uff0c\u53ea\u80fd\u91cd\u65b0\u53d1\u8d77\u3002\n\n### 4.2 \u5ba1\u6279\u6d41\u7a0b\n\n**FR-4.2.1 \u4e00\u7ea7\u5ba1\u6279\uff08\u90e8\u95e8\u4e3b\u7ba1\uff09**\n- \u5458\u5de5\u63d0\u4ea4\u540e\uff0c\u7533\u8bf7\u81ea\u52a8\u6d41\u8f6c\u81f3\u8be5\u5458\u5de5\u6240\u5c5e\u90e8\u95e8\u4e3b\u7ba1\uff1b\n- \u4e3b\u7ba1\u53ef\u6267\u884c\u300c\u540c\u610f\u300d\u6216\u300c\u9a73\u56de\u300d\uff1b\n- \u9009\u62e9\u300c\u9a73\u56de\u300d\u65f6\u5fc5\u987b\u586b\u5199\u9a73\u56de\u539f\u56e0\uff08\u5fc5\u586b\uff0c\u957f\u5ea6\u5efa\u8bae\u4e0d\u8d85\u8fc7 200 \u5b57\uff09\uff0c\u672a\u586b\u5199\u4e0d\u5141\u8bb8\u63d0\u4ea4\u9a73\u56de\u7ed3\u8bba\u3002\n\n**FR-4.2.2 \u4e8c\u7ea7\u5ba1\u6279\uff08\u90e8\u95e8\u603b\u76d1\uff09**\n- \u5f53\u7cfb\u7edf\u8ba1\u7b97\u7684\u52a0\u73ed\u65f6\u957f **\u5927\u4e8e 4 \u5c0f\u65f6** \u65f6\uff0c\u4e3b\u7ba1\u5ba1\u6279\u901a\u8fc7\u540e\u4e0d\u76f4\u63a5\u7ed3\u675f\uff0c\u9700\u7ee7\u7eed\u6d41\u8f6c\u81f3\u90e8\u95e8\u603b\u76d1\u5ba1\u6279\uff1b\n- \u603b\u76d1\u540c\u6837\u652f\u6301\u300c\u540c\u610f / \u9a73\u56de\u300d\uff0c\u9a73\u56de\u539f\u56e0\u5fc5\u586b\uff1b\n- \u52a0\u73ed\u65f6\u957f **\u5c0f\u4e8e\u7b49\u4e8e 4 \u5c0f\u65f6** \u65f6\uff0c\u4e3b\u7ba1\u901a\u8fc7\u540e\u7533\u8bf7\u72b6\u6001\u76f4\u63a5\u53d8\u66f4\u4e3a\u300c\u5df2\u901a\u8fc7\u300d\u3002\n\n**FR-4.2.3 \u6cd5\u5b9a\u8282\u5047\u65e5\u81ea\u52a8\u6807\u8bb0**\n- \u63d0\u4ea4\u65f6\u7cfb\u7edf\u6839\u636e\u6cd5\u5b9a\u8282\u5047\u65e5\u65e5\u5386\u5224\u65ad\u52a0\u73ed\u65e5\u671f\uff1b\n- \u547d\u4e2d\u6cd5\u5b9a\u8282\u5047\u65e5\u7684\u7533\u8bf7\uff0c\u81ea\u52a8\u6253\u4e0a\u300c\u6cd5\u5b9a\u8282\u5047\u65e5\u300d\u6807\u8bb0\uff0c\u4e14\u5728\u5ba1\u6279\u5217\u8868\u4e2d\u9192\u76ee\u6807\u8bc6\uff1b\n- \u8be5\u6807\u8bb0\u7531\u7cfb\u7edf\u5199\u5165\uff0c\u7528\u6237\u4e0d\u53ef\u624b\u5de5\u4fee\u6539\uff1b\n- \u6cd5\u5b9a\u8282\u5047\u65e5\u7533\u8bf7\u65e0\u8bba\u65f6\u957f\u662f\u5426\u8d85\u8fc7 4 \u5c0f\u65f6\uff0c\u5747\u6309 4.2.2 \u7684\u9608\u503c\u89c4\u5219\u6d41\u8f6c\uff08\u672c\u671f\u4e0d\u989d\u5916\u589e\u52a0\u5ba1\u6279\u5c42\u7ea7\uff09\u3002\n\n**FR-4.2.4 \u72b6\u6001\u6d41\u8f6c\u89c4\u5219**\n\n| \u5f53\u524d\u72b6\u6001 | \u52a8\u4f5c | \u76ee\u6807\u72b6\u6001 |\n| --- | --- | --- |\n| \u5f85\u5ba1\u6279 | \u4e3b\u7ba1\u540c\u610f\uff08\u65f6\u957f \u2264 4h\uff09 | \u5df2\u901a\u8fc7 |\n| \u5f85\u5ba1\u6279 | \u4e3b\u7ba1\u540c\u610f\uff08\u65f6\u957f > 4h\uff09 | \u5f85\u5ba1\u6279\uff08\u6d41\u8f6c\u81f3\u603b\u76d1\uff09 |\n| \u5f85\u5ba1\u6279\uff08\u603b\u76d1\u8282\u70b9\uff09 | \u603b\u76d1\u540c\u610f | \u5df2\u901a\u8fc7 |\n| \u5f85\u5ba1\u6279 | \u4e3b\u7ba1/\u603b\u76d1\u9a73\u56de | \u5df2\u9a73\u56de |\n\n**FR-4.2.5** \u9a73\u56de\u540e\u6d41\u7a0b\u7ec8\u6b62\uff0c\u4e0d\u81ea\u52a8\u91cd\u63d0\uff1b\u5982\u9700\u518d\u6b21\u7533\u8bf7\uff0c\u5458\u5de5\u987b\u65b0\u5efa\u7533\u8bf7\u5355\u3002\n\n**FR-4.2.6** \u6bcf\u6b21\u5ba1\u6279\u52a8\u4f5c\uff08\u5ba1\u6279\u4eba\u3001\u65f6\u95f4\u3001\u7ed3\u8bba\u3001\u610f\u89c1\uff09\u5747\u5199\u5165\u64cd\u4f5c\u65e5\u5fd7\uff0c\u4e0d\u53ef\u7f16\u8f91\u4e0e\u5220\u9664\u3002\n\n### 4.3 \u6743\u9650\u63a7\u5236\n\n| \u529f\u80fd | \u5458\u5de5 | \u90e8\u95e8\u4e3b\u7ba1 | \u90e8\u95e8\u603b\u76d1 | HR |\n| --- | --- | --- | --- | --- |\n| \u65b0\u5efa/\u4fee\u6539\u672c\u4eba\u7533\u8bf7 | \u2705 | \u2705 | \u2705 | \u274c |\n| \u67e5\u770b\u672c\u4eba\u7533\u8bf7 | \u2705 | \u2705 | \u2705 | \u2705 |\n| \u67e5\u770b\u672c\u90e8\u95e8\u7533\u8bf7 | \u274c | \u2705 | \u2705 | \u2705 |\n| \u67e5\u770b\u5168\u516c\u53f8\u7533\u8bf7 | \u274c | \u274c | \u274c | \u2705 |\n| \u5ba1\u6279\uff08\u672c\u90e8\u95e8\uff09 | \u274c | \u2705 | \u2705\uff08\u4ec5\u4e8c\u7ea7\u8282\u70b9\uff09 | \u274c |\n| \u4fee\u6539\u4ed6\u4eba\u7533\u8bf7 | \u274c | \u274c | \u274c | \u274c |\n| \u5bfc\u51fa\u6708\u5ea6\u6c47\u603b | \u274c | \u274c | \u274c | \u2705\uff08\u53ea\u8bfb\uff09 |\n\n**FR-4.3.1** \u5458\u5de5\u4ec5\u80fd\u67e5\u770b\u548c\u64cd\u4f5c\u672c\u4eba\u7684\u7533\u8bf7\u5355\u3002\n**FR-4.3.2** \u90e8\u95e8\u4e3b\u7ba1\u4ec5\u80fd\u67e5\u770b\u4e0e\u5ba1\u6279\u672c\u90e8\u95e8\u7684\u7533\u8bf7\uff0c\u8de8\u90e8\u95e8\u6570\u636e\u4e0d\u53ef\u89c1\u3002\n**FR-4.3.3** HR \u62e5\u6709\u5168\u516c\u53f8\u8303\u56f4\u7684\u67e5\u770b\u4e0e\u5bfc\u51fa\u6743\u9650\uff0c\u4f46\u5bf9\u4efb\u4f55\u7533\u8bf7\u5355\u5747\u4e3a\u53ea\u8bfb\uff0c\u4e0d\u53ef\u4fee\u6539\u3001\u4e0d\u53ef\u5ba1\u6279\u3002\n**FR-4.3.4** \u6743\u9650\u6821\u9a8c\u987b\u5728\u540e\u7aef\u63a5\u53e3\u5c42\u5f3a\u5236\u6267\u884c\uff0c\u4e0d\u5f97\u4ec5\u4f9d\u8d56\u524d\u7aef\u83dc\u5355\u9690\u85cf\u3002\n\n### 4.4 \u5217\u8868\u4e0e\u67e5\u8be2\n\n**FR-4.4.1 \u5458\u5de5\u7aef\u5217\u8868**\n- \u5c55\u793a\u5b57\u6bb5\uff1a\u52a0\u73ed\u65e5\u671f\u3001\u52a0\u73ed\u65f6\u957f\u3001\u72b6\u6001\uff08\u5f85\u5ba1\u6279 / \u5df2\u901a\u8fc7 / \u5df2\u9a73\u56de\uff09\uff1b\n- \u9ed8\u8ba4\u6309\u52a0\u73ed\u65e5\u671f\u5012\u5e8f\u6392\u5217\uff1b\n- \u652f\u6301\u7b5b\u9009\u6761\u4ef6\uff1a\u6309\u72b6\u6001\u7b5b\u9009\u3001\u6309\u6708\u4efd\u7b5b\u9009\uff1b\n- \u70b9\u51fb\u5355\u6761\u53ef\u67e5\u770b\u8be6\u60c5\uff0c\u5305\u542b\u8d77\u6b62\u65f6\u95f4\u3001\u4e8b\u7531\u3001\u5ba1\u6279\u8bb0\u5f55\u3001\u9a73\u56de\u539f\u56e0\u3002\n\n**FR-4.4.2 \u4e3b\u7ba1\u7aef\u5217\u8868**\n- \u5c55\u793a\u672c\u90e8\u95e8\u5168\u90e8\u7533\u8bf7\uff0c\u5b57\u6bb5\u540c\u4e0a\uff0c\u53e6\u589e\u52a0\u300c\u7533\u8bf7\u4eba\u300d\u5217\uff1b\n- \u652f\u6301\u6309\u72b6\u6001\u3001\u6708\u4efd\u3001\u7533\u8bf7\u4eba\u7b5b\u9009\uff1b\n- \u652f\u6301\u300c\u5f85\u6211\u5ba1\u6279\u300d\u5feb\u6377\u89c6\u56fe\u3002\n\n**FR-4.4.3 HR \u7aef\u5217\u8868**\n- \u652f\u6301\u5168\u516c\u53f8\u8303\u56f4\u67e5\u8be2\uff0c\u53ef\u6309\u90e8\u95e8\u3001\u72b6\u6001\u3001\u6708\u4efd\u7ec4\u5408\u7b5b\u9009\uff1b\n- \u5217\u8868\u9700\u63d0\u4f9b\u6cd5\u5b9a\u8282\u5047\u65e5\u6807\u8bb0\u5217\u3002\n\n**FR-4.4.4 HR \u6708\u5ea6\u5bfc\u51fa**\n- \u652f\u6301\u9009\u62e9\u5355\u4e2a\u81ea\u7136\u6708\uff0c\u5bfc\u51fa\u8be5\u6708\u5168\u516c\u53f8\u52a0\u73ed\u6c47\u603b\uff1b\n- \u5bfc\u51fa\u5b57\u6bb5\u81f3\u5c11\u5305\u542b\uff1a\u90e8\u95e8\u3001\u59d3\u540d\u3001\u52a0\u73ed\u65e5\u671f\u3001\u5f00\u59cb\u65f6\u95f4\u3001\u7ed3\u675f\u65f6\u95f4\u3001\u52a0\u73ed\u65f6\u957f\u3001\u72b6\u6001\u3001\u662f\u5426\u6cd5\u5b9a\u8282\u5047\u65e5\uff1b\n- \u5bfc\u51fa\u683c\u5f0f\u4e3a Excel\uff08.xlsx\uff09\uff1b\n- \u4ec5\u5bfc\u51fa\u72b6\u6001\u4e3a\u300c\u5df2\u901a\u8fc7\u300d\u7684\u8bb0\u5f55\u53c2\u4e0e\u6c47\u603b\u53e3\u5f84\uff0c\u540c\u65f6\u63d0\u4f9b\u5305\u542b\u5168\u90e8\u72b6\u6001\u7684\u660e\u7ec6 Sheet \u4ee5\u4fbf\u6838\u5bf9\u3002\n\n## 5. \u975e\u529f\u80fd\u9700\u6c42\n\n| \u7f16\u53f7 | \u7c7b\u522b | \u8981\u6c42 |\n| --- | --- | --- |\n| NFR-1 | \u6027\u80fd | \u5217\u8868\u67e5\u8be2\u54cd\u5e94 \u2264 2s\uff08\u5355\u90e8\u95e8 1000 \u6761\u6570\u636e\u91cf\u7ea7\uff09\uff1b\u5bfc\u51fa 10000 \u6761\u4ee5\u5185 \u2264 30s |\n| NFR-2 | \u5b89\u5168 | \u63a5\u53e3\u9274\u6743 + \u6570\u636e\u6743\u9650\u53cc\u5c42\u6821\u9a8c\uff1b\u64cd\u4f5c\u65e5\u5fd7\u4fdd\u7559\u4e0d\u5c11\u4e8e 24 \u4e2a\u6708 |\n| NFR-3 | \u53ef\u7528\u6027 | \u6cd5\u5b9a\u8282\u5047\u65e5\u65e5\u5386\u53ef\u901a\u8fc7\u540e\u53f0\u914d\u7f6e\u7ef4\u62a4\uff0c\u65e0\u9700\u53d1\u7248 |\n| NFR-4 | \u517c\u5bb9\u6027 | \u517c\u5bb9\u516c\u53f8\u73b0\u6709\u4e3b\u6d41\u6d4f\u89c8\u5668\uff1b\u9875\u9762\u5728 1366\u00d7768 \u53ca\u4ee5\u4e0a\u5206\u8fa8\u7387\u6b63\u5e38\u5c55\u793a |\n| NFR-5 | \u53ef\u8ffd\u6eaf | \u6240\u6709\u72b6\u6001\u53d8\u66f4\u987b\u8bb0\u5f55\u53d8\u66f4\u524d\u540e\u503c\u4e0e\u64cd\u4f5c\u4eba |\n\n## 6. \u8fb9\u754c\u4e0e\u5f02\u5e38\u573a\u666f\n\n1. \u5f00\u59cb\u65f6\u95f4\u7b49\u4e8e\u7ed3\u675f\u65f6\u95f4\uff1a\u4e0d\u5141\u8bb8\u63d0\u4ea4\uff0c\u63d0\u793a\u300c\u65f6\u957f\u987b\u5927\u4e8e 0\u300d\uff1b\n2. \u540c\u4e00\u5929\u91cd\u590d\u63d0\u4ea4\u591a\u6761\u7533\u8bf7\uff1a\u5141\u8bb8\uff0c\u5217\u8868\u5e76\u5217\u5c55\u793a\uff0c\u6c47\u603b\u65f6\u5206\u522b\u7d2f\u52a0\uff1b\n3. \u5ba1\u6279\u4eba\u7f3a\u5931\uff08\u90e8\u95e8\u65e0\u4e3b\u7ba1 / \u65e0\u603b\u76d1\uff09\uff1a\u63d0\u4ea4\u65f6\u963b\u65ad\u5e