a1\u3001\u8d22\u52a1 |\n| \u5173\u8054\u7cfb\u7edf | \u62a5\u9500\u7533\u8bf7\u6a21\u5757\uff08\u73b0\u6709\u529f\u80fd\u6539\u9020\uff09 |\n\n---\n\n## 1. \u80cc\u666f\u4e0e\u76ee\u6807\n\n### 1.1 \u80cc\u666f\n\u516c\u53f8\u73b0\u6709\u300c\u62a5\u9500\u7533\u8bf7\u300d\u529f\u80fd\u5df2\u4e0a\u7ebf\u8fd0\u884c\uff0c\u79ef\u7d2f\u4e86\u5386\u53f2\u62a5\u9500\u6570\u636e\u3002\u968f\u7740\u4e1a\u52a1\u4f7f\u7528\u6df1\u5165\uff0c\u66b4\u9732\u51fa\u4ee5\u4e0b\u95ee\u9898\uff0c\u9700\u8fdb\u884c\u529f\u80fd\u6539\u9020\u3002\n\n### 1.2 \u73b0\u72b6\u95ee\u9898\n1. **\u8d39\u7528\u7c7b\u578b\u5355\u4e00**\uff1a\u4e00\u5f20\u62a5\u9500\u5355\u53ea\u80fd\u586b\u5199\u4e00\u79cd\u8d39\u7528\u7c7b\u578b\uff0c\u5458\u5de5\u4e00\u6b21\u51fa\u5dee\u6d89\u53ca\u6253\u8f66\u3001\u9910\u996e\u3001\u4f4f\u5bbf\u7b49\u591a\u9879\u8d39\u7528\u65f6\u9700\u62c6\u5206\u591a\u5f20\u5355\uff0c\u64cd\u4f5c\u7e41\u7410\u3001\u5ba1\u6279\u8d1f\u62c5\u91cd\u3002\n2. **\u53d1\u7968\u4e0d\u53ef\u89c1**\uff1a\u5ba1\u6279\u4eba\u5728\u5ba1\u6279\u73af\u8282\u65e0\u6cd5\u67e5\u770b\u5458\u5de5\u4e0a\u4f20\u7684\u53d1\u7968\u7167\u7247\uff0c\u53ea\u80fd\u51ed\u91d1\u989d\u4e0e\u6587\u5b57\u63cf\u8ff0\u5224\u65ad\uff0c\u5ba1\u6279\u8d28\u91cf\u4e0e\u98ce\u63a7\u80fd\u529b\u4e0d\u8db3\u3002\n\n### 1.3 \u6539\u9020\u76ee\u6807\n1. \u652f\u6301\u4e00\u5f20\u62a5\u9500\u5355\u586b\u5199\u591a\u79cd\u8d39\u7528\u7c7b\u578b\uff08\u5982\u6253\u8f66\u8d39\u3001\u9910\u8d39\u3001\u4f4f\u5bbf\u8d39\u5206\u884c\u5206\u5217\uff09\uff0c\u5e76\u81ea\u52a8\u6c47\u603b\u91d1\u989d\u3002\n2. \u5ba1\u6279\u4eba\u5728\u5ba1\u6279\u73af\u8282\u53ef\u67e5\u770b\u5bf9\u5e94\u53d1\u7968\u7167\u7247\u3002\n3. \u8d22\u52a1\u652f\u6301\u6309\u6761\u4ef6\u5bfc\u51fa\u62a5\u9500\u6570\u636e\u3002\n4. \u517c\u5bb9\u5386\u53f2\u6570\u636e\uff1a\u5df2\u6709\u5386\u53f2\u62a5\u9500\u5355\u53ef\u7ee7\u7eed\u67e5\u770b\uff0c\u4e0d\u53d7\u672c\u6b21\u6539\u9020\u5f71\u54cd\u3002\n\n---\n\n## 2. \u672f\u8bed\u5b9a\u4e49\n\n| \u672f\u8bed | \u8bf4\u660e |\n| --- | --- |\n| \u62a5\u9500\u5355 | \u5458\u5de5\u63d0\u4ea4\u7684\u4e00\u6b21\u62a5\u9500\u7533\u8bf7\u6574\u4f53 |\n| \u8d39\u7528\u660e\u7ec6\u884c | \u62a5\u9500\u5355\u5185\u7684\u4e00\u6761\u5177\u4f53\u8d39\u7528\u8bb0\u5f55\uff08\u542b\u8d39\u7528\u7c7b\u578b\u3001\u91d1\u989d\u3001\u53d1\u7968\u7b49\uff09 |\n| \u8d39\u7528\u7c7b\u578b | \u6253\u8f66\u8d39\u3001\u9910\u8d39\u3001\u4f4f\u5bbf\u8d39\u7b49\u5206\u7c7b |\n| \u5ba1\u6279\u4eba | \u5bf9\u62a5\u9500\u5355\u8fdb\u884c\u5ba1\u6838\u7684\u90e8\u95e8\u4e3b\u7ba1 |\n\n---\n\n## 3. \u89d2\u8272\u4e0e\u6743\u9650\n\n| \u89d2\u8272 | \u4e3b\u8981\u804c\u8d23 | \u6743\u9650\u8303\u56f4 |\n| --- | --- | --- |\n| \u5458\u5de5 | \u586b\u5199\u5e76\u63d0\u4ea4\u62a5\u9500\u5355\u3001\u4e0a\u4f20\u53d1\u7968 | \u65b0\u5efa\u3001\u7f16\u8f91\uff08\u672a\u63d0\u4ea4/\u88ab\u9a73\u56de\uff09\u3001\u67e5\u770b\u672c\u4eba\u62a5\u9500\u5355\u3001\u64a4\u56de |\n| \u90e8\u95e8\u4e3b\u7ba1 | \u5ba1\u6279\u62a5\u9500\u5355\u3001\u67e5\u770b\u53d1\u7968 | \u5ba1\u6279\u901a\u8fc7/\u9a73\u56de\u3001\u67e5\u770b\u5f85\u529e\u53ca\u5df2\u529e\u3001\u67e5\u770b\u53d1\u7968\u7167\u7247 |\n| \u8d22\u52a1 | \u6570\u636e\u5bfc\u51fa\u4e0e\u5f52\u6863 | \u67e5\u770b\u5168\u91cf\u62a5\u9500\u5355\u3001\u6309\u6761\u4ef6\u5bfc\u51fa\u3001\uff08\u53ef\u9009\uff09\u8d22\u52a1\u590d\u6838 |\n\n---\n\n## 4. \u529f\u80fd\u9700\u6c42\n\n### 4.1 \u591a\u8d39\u7528\u660e\u7ec6\uff08\u62a5\u9500\u5355\u586b\u5199\uff09\n\n**FR-4.1.1 \u660e\u7ec6\u884c\u65b0\u589e/\u5220\u9664**\n- \u5458\u5de5\u5728\u586b\u5199\u62a5\u9500\u5355\u65f6\uff0c\u53ef\u6dfb\u52a0\u591a\u6761\u8d39\u7528\u660e\u7ec6\u884c\u3002\n- \u6bcf\u6761\u660e\u7ec6\u884c\u5305\u542b\uff1a\u8d39\u7528\u7c7b\u578b\u3001\u53d1\u751f\u65e5\u671f\u3001\u91d1\u989d\u3001\u8d39\u7528\u8bf4\u660e\u3001\u53d1\u7968\u9644\u4ef6\u3002\n- \u652f\u6301\u5220\u9664\u4efb\u610f\u660e\u7ec6\u884c\uff08\u81f3\u5c11\u4fdd\u7559 1 \u6761\uff09\u3002\n\n**FR-4.1.2 \u8d39\u7528\u7c7b\u578b\u9009\u62e9**\n- \u8d39\u7528\u7c7b\u578b\u4e3a\u4e0b\u62c9\u9009\u62e9\uff0c\u53ef\u9009\u503c\uff1a\u6253\u8f66\u8d39\u3001\u9910\u8d39\u3001\u4f4f\u5bbf\u8d39\uff08\u8d39\u7528\u7c7b\u578b\u9700\u652f\u6301\u540e\u53f0\u914d\u7f6e\u6269\u5c55\uff09\u3002\n- \u540c\u4e00\u62a5\u9500\u5355\u5185\u5141\u8bb8\u51fa\u73b0\u76f8\u540c\u8d39\u7528\u7c7b\u578b\u7684\u591a\u6761\u660e\u7ec6\u3002\n\n**FR-4.1.3 \u91d1\u989d\u81ea\u52a8\u6c47\u603b**\n- \u7cfb\u7edf\u81ea\u52a8\u8ba1\u7b97\u5e76\u5c55\u793a\u300c\u62a5\u9500\u603b\u91d1\u989d = \u5404\u660e\u7ec6\u884c\u91d1\u989d\u4e4b\u548c\u300d\u3002\n- \u603b\u91d1\u989d\u53ea\u8bfb\uff0c\u7531\u660e\u7ec6\u884c\u6c47\u603b\u751f\u6210\uff0c\u4e0d\u53ef\u624b\u52a8\u4fee\u6539\u3002\n\n**FR-4.1.4 \u6821\u9a8c\u89c4\u5219**\n- \u5355\u6761\u660e\u7ec6\u91d1\u989d\u5fc5\u987b\u5927\u4e8e 0\uff0c\u4e14\u4e3a\u5408\u6cd5\u6570\u503c\uff08\u4fdd\u7559 2 \u4f4d\u5c0f\u6570\uff09\u3002\n- \u53d1\u751f\u65e5\u671f\u4e0d\u5f97\u665a\u4e8e\u63d0\u4ea4\u65e5\u671f\u3002\n- \u63d0\u4ea4\u65f6\u81f3\u5c11\u5b58\u5728 1 \u6761\u6709\u6548\u660e\u7ec6\u884c\u3002\n- \u660e\u7ec6\u884c\u6570\u91cf\u4e0a\u9650\uff08\u5efa\u8bae \u2264 50\uff0c\u53ef\u914d\u7f6e\uff09\u3002\n\n### 4.2 \u53d1\u7968\u7167\u7247\u4e0a\u4f20\u4e0e\u67e5\u770b\n\n**FR-4.2.1 \u4e0a\u4f20**\n- \u6bcf\u6761\u8d39\u7528\u660e\u7ec6\u884c\u652f\u6301\u4e0a\u4f20\u53d1\u7968\u7167\u7247\uff0c1 \u6761\u660e\u7ec6\u53ef\u5bf9\u5e94 1 \u5f20\u6216\u591a\u5f20\u53d1\u7968\uff08\u5efa\u8bae\u4e0a\u9650 9 \u5f20/\u660e\u7ec6\u884c\uff0c\u53ef\u914d\u7f6e\uff09\u3002\n- \u652f\u6301\u683c\u5f0f\uff1aJPG\u3001JPEG\u3001PNG\uff1b\u5355\u6587\u4ef6\u5927\u5c0f \u2264 10MB\uff08\u53ef\u914d\u7f6e\uff09\u3002\n- \u652f\u6301\u62cd\u7167\u4e0a\u4f20\u4e0e\u672c\u5730\u6587\u4ef6\u4e0a\u4f20\u3002\n\n**FR-4.2.2 \u5ba1\u6279\u7aef\u67e5\u770b**\n- \u90e8\u95e8\u4e3b\u7ba1\u5728\u5ba1\u6279\u9875\u9762\u53ef\u67e5\u770b\u6bcf\u6761\u660e\u7ec6\u5bf9\u5e94\u7684\u53d1\u7968\u7167\u7247\u3002\n- \u53d1\u7968\u4ee5\u7f29\u7565\u56fe\u5c55\u793a\uff0c\u70b9\u51fb\u53ef\u653e\u5927\u9884\u89c8\uff0c\u652f\u6301\u5de6\u53f3\u5207\u6362\u67e5\u770b\u540c\u5355\u5176\u4ed6\u53d1\u7968\u3002\n- \u652f\u6301\u53d1\u7968\u7167\u7247\u4e0b\u8f7d\u3002\n\n**FR-4.2.3 \u6743\u9650**\n- \u4ec5\u62a5\u9500\u5355\u521b\u5efa\u4eba\u3001\u5f53\u524d/\u5386\u53f2\u5ba1\u6279\u4eba\u3001\u8d22\u52a1\u53ef\u67e5\u770b\u53d1\u7968\u7167\u7247\u3002\n- \u65e0\u6743\u9650\u7528\u6237\u8bbf\u95ee\u53d1\u7968\u8d44\u6e90\u5e94\u88ab\u62d2\u7edd\uff08403\uff09\u3002\n\n### 4.3 \u5ba1\u6279\u529f\u80fd\n\n**FR-4.3.1 \u5ba1\u6279\u64cd\u4f5c**\n- \u5ba1\u6279\u4eba\u53ef\u67e5\u770b\u62a5\u9500\u5355\u5168\u90e8\u660e\u7ec6\u53ca\u53d1\u7968\uff0c\u8fdb\u884c\u300c\u901a\u8fc7\u300d\u6216\u300c\u9a73\u56de\u300d\u3002\n- \u9a73\u56de\u65f6\u9700\u586b\u5199\u9a73\u56de\u610f\u89c1\u3002\n\n**FR-4.3.2 \u72b6\u6001\u6d41\u8f6c**\n- \u72b6\u6001\uff1a\u8349\u7a3f \u2192 \u5f85\u5ba1\u6279 \u2192 \u5df2\u901a\u8fc7 / \u5df2\u9a73\u56de\u3002\n- \u9a73\u56de\u540e\u5458\u5de5\u53ef\u4fee\u6539\u660e\u7ec6\u53ca\u53d1\u7968\u5e76\u91cd\u65b0\u63d0\u4ea4\uff0c\u91cd\u65b0\u8fdb\u5165\u5f85\u5ba1\u6279\u3002\n\n### 4.4 \u8d22\u52a1\u5bfc\u51fa\n\n**FR-4.4.1 \u5bfc\u51fa\u6761\u4ef6\u7b5b\u9009**\n- \u652f\u6301\u6309\u4ee5\u4e0b\u7b5b\u9009\u6761\u4ef6\u7ec4\u5408\u67e5\u8be2\u540e\u5bfc\u51fa\uff1a\u63d0\u4ea4\u65f6\u95f4\u533a\u95f4\u3001\u8d39\u7528\u7c7b\u578b\u3001\u72b6\u6001\u3001\u90e8\u95e8\u3001\u62a5\u9500\u4eba\u3001\u91d1\u989d\u533a\u95f4\u3002\n\n**FR-4.4.2 \u5bfc\u51fa\u5185\u5bb9\u4e0e\u683c\u5f0f**\n- \u5bfc\u51fa\u683c\u5f0f\uff1aExcel\uff08.xlsx\uff09\u3002\n- \u5bfc\u51fa\u7c92\u5ea6\uff1a\u6309\u8d39\u7528\u660e\u7ec6\u884c\u5bfc\u51fa\uff08\u4e00\u884c\u4e00\u8d39\u7528\uff09\uff0c\u540c\u65f6\u5305\u542b\u6240\u5c5e\u62a5\u9500\u5355\u4fe1\u606f\uff08\u5355\u53f7\u3001\u62a5\u9500\u4eba\u3001\u90e8\u95e8\u3001\u603b\u91d1\u989d\u3001\u72b6\u6001\u3001\u63d0\u4ea4\u65f6\u95f4\uff09\u3002\n- \u6570\u636e\u91cf\u8f83\u5927\u65f6\uff08\u5efa\u8bae > 1\u4e07\u884c\uff09\u91c7\u7528\u5f02\u6b65\u5bfc\u51fa\uff0c\u5b8c\u6210\u540e\u63d0\u4f9b\u4e0b\u8f7d\u94fe\u63a5/\u901a\u77e5\u3002\n\n**FR-4.4.3 \u6743\u9650\u4e0e\u5ba1\u8ba1**\n- \u4ec5\u8d22\u52a1\u89d2\u8272\u53ef\u6267\u884c\u5bfc\u51fa\u3002\n- \u8bb0\u5f55\u5bfc\u51fa\u64cd\u4f5c\u65e5\u5fd7\uff08\u64cd\u4f5c\u4eba\u3001\u65f6\u95f4\u3001\u7b5b\u9009\u6761\u4ef6\uff09\u3002\n\n### 4.5 \u5386\u53f2\u6570\u636e\u517c\u5bb9\n\n**FR-4.5.1 \u5386\u53f2\u5355\u67e5\u770b**\n- \u6539\u9020\u524d\u5df2\u5b58\u5728\u7684\u300c\u5355\u8d39\u7528\u7c7b\u578b\u300d\u5386\u53f2\u62a5\u9500\u5355\uff0c\u987b\u6b63\u5e38\u67e5\u770b\u8be6\u60c5\u4e0e\u5217\u8868\uff0c\u4e0d\u53ef\u62a5\u9519\u3002\n- \u5386\u53f2\u5355\u5728\u7cfb\u7edf\u4e2d\u4ee5\u300c\u5355\u6761\u8d39\u7528\u660e\u7ec6\u300d\u7684\u5f62\u5f0f\u517c\u5bb9\u5c55\u793a\u3002\n\n**FR-4.5.2 \u6570\u636e\u8fc1\u79fb**\n- \u5bf9\u5386\u53f2\u6570\u636e\u8fdb\u884c\u7ed3\u6784\u8fc1\u79fb/\u6620\u5c04\uff1a\u539f\u5355\u636e\u7684\u5355\u4e00\u8d39\u7528\u7c7b\u578b\u4e0e\u91d1\u989d\uff0c\u8f6c\u6362\u4e3a\u65b0\u7248\u7684\u4e00\u6761\u8d39\u7528\u660e\u7ec6\u884c\uff1b\u539f\u53d1\u7968\uff08\u82e5\u6709\uff09\u5173\u8054\u81f3\u8be5\u660e\u7ec6\u884c\u3002\n- \u5386\u53f2\u5df2\u5ba1\u6279\u5355\u636e\u72b6\u6001\u4fdd\u6301\u4e0d\u53d8\uff0c\u4e0d\u53ef\u88ab\u7f16\u8f91\uff0c\u4ec5\u53ef\u67e5\u770b/\u5bfc\u51fa\u3002\n\n**FR-4.5.3 \u517c\u5bb9\u6027\u7ea6\u675f**\n- \u5386\u53f2\u6570\u636e\u7684\u91d1\u989d\u3001\u6c47\u603b\u3001\u5bfc\u51fa\u7ed3\u679c\u987b\u4e0e\u8fc1\u79fb\u524d\u4e00\u81f4\uff0c\u4e0d\u4ea7\u751f\u504f\u5dee\u3002\n\n---\n\n## 5. \u6570\u636e\u6a21\u578b\uff08\u6982\u8981\uff09\n\n**\u62a5\u9500\u5355\uff08reimbursement\uff09**\uff1a\u5355\u53f7\u3001\u62a5\u9500\u4eba\u3001\u90e8\u95e8\u3001\u603b\u91d1\u989d\u3001\u72b6\u6001\u3001\u63d0\u4ea4\u65f6\u95f4\u3001\u5ba1\u6279\u4eba\u3001\u5ba1\u6279\u65f6\u95f4\u3001\u9a73\u56de\u610f\u89c1\u3001\u521b\u5efa/\u66f4\u65b0\u65f6\u95f4\u3002\n\n**\u8d39\u7528\u660e\u7ec6\uff08reimbursement_item\uff09** *(\u65b0\u589e)*\uff1a\u660e\u7ec6ID\u3001\u62a5\u9500\u5355ID\u3001\u8d39\u7528\u7c7b\u578b\u3001\u53d1\u751f\u65e5\u671f\u3001\u91d1\u989d\u3001\u8d39\u7528\u8bf4\u660e\u3001\u521b\u5efa\u65f6\u95f4\u3002\n\n**\u53d1\u7968\u9644\u4ef6\uff08reimbursement_invoice\uff09** *(\u65b0\u589e/\u6539\u9020)*\uff1a\u9644\u4ef6ID\u3001\u660e\u7ec6ID\u3001\u6587\u4ef6\u540d\u3001\u6587\u4ef6\u7c7b\u578b\u3001\u6587\u4ef6\u5927\u5c0f\u3001\u5b58\u50a8\u8def\u5f84\u3001\u4e0a\u4f20\u65f6\u95f4\u3002\n\n> \u8bf4\u660e\uff1a\u539f\u5355\u636e\u8868\u4e2d\u7684\u5355\u4e00\u300c\u8d39\u7528\u7c7b\u578b\u300d\u300c\u91d1\u989d\u300d\u5b57\u6bb5\uff0c\u901a\u8fc7\u8fc1\u79fb\u6620\u5c04\u5230\u660e\u7ec6\u8868\uff1b\u603b\u91d1\u989d\u7531\u660e\u7ec6\u6c47\u603b\u751f\u6210\u3002\n\n---\n\n## 6. \u975e\u529f\u80fd\u9700\u6c42\n\n| \u7c7b\u522b | \u8981\u6c42 |\n| --- | --- |\n| \u6027\u80fd | \u62a5\u9500\u5355\u63d0\u4ea4/\u4fdd\u5b58\u54cd\u5e94 \u2264 2s\uff1b\u53d1\u7968\u7f29\u7565\u56fe\u52a0\u8f7d \u2264 1s\uff1b\u5bfc\u51fa\u5f02\u6b65\u5904\u7406\uff0c\u4e0d\u963b\u585e\u9875\u9762 |\n| \u5b58\u50a8 | \u53d1\u7968\u7167\u7247\u5b58\u50a8\u4e8e\u5bf9\u8c61\u5b58\u50a8\uff08OSS/S3 \u7b49\uff09\uff0c\u6570\u636e\u5e93\u4ec5\u4fdd\u5b58\u6587\u4ef6\u8def\u5f84 |\n| \u5b89\u5168 | \u53d1\u7968\u8bbf\u95ee\u9274\u6743\uff1b\u5bfc\u51fa\u6743\u9650\u63a7\u5236\uff1b\u64cd\u4f5c\u7559\u75d5\u5ba1\u8ba1 |\n| \u517c\u5bb9\u6027 | PC \u7aef + \u79fb\u52a8\u7aef\uff08\u5982\u6d89\u53ca\uff09\u6b63\u5e38\u5c55\u793a\uff1b\u5386\u53f2\u6570\u636e\u53ea\u8bfb\u517c\u5bb9 |\n| \u53ef\u7528\u6027 | \u5173\u952e\u64cd\u4f5c\uff08\u63d0\u4ea4\u3001\u5ba1\u6279\u3001\u5bfc\u51fa\uff09\u6709\u660e\u786e\u7684\u6210\u529f/\u5931\u8d25\u63d0\u793a |\n\n---\n\n## 7. \u9a8c\u6536\u6807\u51c6\n\n1. \u5458\u5de