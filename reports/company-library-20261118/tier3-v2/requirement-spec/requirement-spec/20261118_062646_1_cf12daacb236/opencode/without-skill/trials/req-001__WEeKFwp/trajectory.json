\u5458\u5de5\u4fee\u6539\u540e\u53ef\u91cd\u65b0\u63d0\u4ea4 |\n\n\u72b6\u6001\u53d8\u66f4\u7ea6\u675f\uff1a\n- \u5ba1\u6279\u64cd\u4f5c\u4ec5\u5141\u8bb8\u5728\u5355\u636e\u5904\u4e8e\u300c\u5f53\u524d\u5ba1\u6279\u4eba\u300d\u72b6\u6001\u65f6\u6267\u884c\uff1b\u975e\u5f53\u524d\u8282\u70b9\u5ba1\u6279\u4eba\u64cd\u4f5c\u8fd4\u56de\u5931\u8d25\uff1b\n- \u5e76\u53d1\u5ba1\u6279\u540c\u4e00\u5355\u636e\u65f6\uff0c\u4ee5\u5148\u63d0\u4ea4\u8005\u751f\u6548\uff0c\u540e\u63d0\u4ea4\u8005\u63d0\u793a\u300c\u8be5\u7533\u8bf7\u5df2\u88ab\u5904\u7406\uff0c\u8bf7\u5237\u65b0\u300d\uff1b\n- \u5df2\u901a\u8fc7\u540e\u4e0d\u5141\u8bb8\u5728\u672c\u671f\u529f\u80fd\u5185\u64a4\u56de\uff08\u5982\u4e1a\u52a1\u9700\u8981\uff0c\u8d70\u7ebf\u4e0b\u66f4\u6b63 + HR \u5907\u6ce8\uff09\u3002\n\n---\n\n## 4. \u529f\u80fd\u9700\u6c42\n\n### 4.1 \u52a0\u73ed\u7533\u8bf7\u586b\u5199\uff08F-01\uff09\n\n**\u8868\u5355\u9879**\n\n| \u5b57\u6bb5 | \u7c7b\u578b | \u5fc5\u586b | \u6821\u9a8c\u89c4\u5219 |\n| --- | --- | --- | --- |\n| \u7533\u8bf7\u4eba | \u53ea\u8bfb | \u2705 | \u9ed8\u8ba4\u5f53\u524d\u767b\u5f55\u7528\u6237\uff0c\u90e8\u95e8\u81ea\u52a8\u5e26\u51fa\uff0c\u4e0d\u53ef\u6539 |\n| \u52a0\u73ed\u65e5\u671f | \u65e5\u671f | \u2705 | \u4e0d\u5f97\u665a\u4e8e\u5f53\u524d\u65e5\u671f\uff08\u672c\u671f\u4e0d\u5141\u8bb8\u9884\u63d0\u672a\u6765\u52a0\u73ed\uff0c\u53ef\u914d\u7f6e\uff09\uff1b\u4e0d\u5f97\u65e9\u4e8e\u5f53\u524d\u65e5\u671f \u2212 90 \u5929 |\n| \u5f00\u59cb\u65f6\u95f4 | \u65f6\u95f4\uff08HH:mm\uff09 | \u2705 | 24 \u5c0f\u65f6\u5236 |\n| \u7ed3\u675f\u65f6\u95f4 | \u65f6\u95f4\uff08HH:mm\uff09 | \u2705 | \u5fc5\u987b\u665a\u4e8e\u5f00\u59cb\u65f6\u95f4\uff1b\u652f\u6301\u8de8\u5929\uff08\u7ed3\u675f\u65f6\u95f4\u5c5e\u6b21\u65e5\uff0c\u6700\u5927\u8de8\u5ea6 \u2264 24h\uff09 |\n| \u52a0\u73ed\u4e8b\u7531 | \u591a\u884c\u6587\u672c | \u274c | \u2264 200 \u5b57\uff0c\u8d85\u51fa\u65f6\u7981\u6b62\u8f93\u5165\u5e76\u63d0\u793a |\n| \u52a0\u73ed\u65f6\u957f | \u53ea\u8bfb\uff0c\u7cfb\u7edf\u8ba1\u7b97 | \u2705 | \u89c1 F-02 |\n| \u662f\u5426\u6cd5\u5b9a\u8282\u5047\u65e5 | \u53ea\u8bfb\uff0c\u7cfb\u7edf\u6807\u8bb0 | \u2705 | \u89c1 F-04 |\n\n**\u529f\u80fd\u8981\u6c42**\n- \u4fdd\u5b58\u8349\u7a3f\uff08\u53ef\u9009\uff0c\u672c\u671f\u5b9e\u73b0\u4e3a\u300c\u4fdd\u5b58\u5e76\u63d0\u4ea4\u300d\u4e24\u4e2a\u6309\u94ae\uff0c\u8349\u7a3f\u4e0d\u505a\u5f3a\u5236\u8981\u6c42\uff09\uff1b\n- \u63d0\u4ea4\u6210\u529f\u540e\u751f\u6210\u552f\u4e00\u7533\u8bf7\u5355\u53f7\uff0c\u89c4\u5219 `OT + yyyyMMdd + 4 \u4f4d\u6d41\u6c34`\uff08\u793a\u4f8b `OT202611180007`\uff09\uff1b\n- \u63d0\u4ea4\u3001\u4fee\u6539\u3001\u64a4\u9500\u3001\u5ba1\u6279\u5747\u5199\u5165\u64cd\u4f5c\u65e5\u5fd7\uff08\u64cd\u4f5c\u4eba\u3001\u64cd\u4f5c\u65f6\u95f4\u3001\u52a8\u4f5c\u3001\u53d8\u66f4\u524d\u540e\u503c\u3001IP\uff09\u3002\n\n### 4.2 \u52a0\u73ed\u65f6\u957f\u81ea\u52a8\u8ba1\u7b97\uff08F-02\uff09\n\n- \u8ba1\u7b97\u89c4\u5219\uff1a`\u65f6\u957f = \u7ed3\u675f\u65f6\u95f4 \u2212 \u5f00\u59cb\u65f6\u95f4`\uff0c\u7ed3\u679c\u4fdd\u7559 1 \u4f4d\u5c0f\u6570\uff0c\u5355\u4f4d\u5c0f\u65f6\uff0c\u6700\u5c0f\u7c92\u5ea6 0.5h\uff1b\n- \u8de8\u5929\u5904\u7406\uff1a\u7ed3\u675f\u65f6\u95f4\u5c0f\u4e8e\u5f00\u59cb\u65f6\u95f4\u89c6\u4e3a\u6b21\u65e5\u7ed3\u675f\uff0c`\u65f6\u957f = (24:00 \u2212 \u5f00\u59cb) + \u7ed3\u675f`\uff1b\n- \u5c55\u793a\u4f4d\u7f6e\uff1a\u8868\u5355\u5b9e\u65f6\u9884\u89c8\u3001\u5217\u8868\u3001\u8be6\u60c5\u3001\u5bfc\u51fa\uff1b\n- \u65f6\u957f\u7531\u7cfb\u7edf\u751f\u6210\uff0c**\u4efb\u4f55\u89d2\u8272\u5747\u4e0d\u53ef\u624b\u5de5\u7f16\u8f91**\uff1b\n- \u8fb9\u754c\uff1a\u65f6\u957f \u2264 0 \u65f6\u63d0\u4ea4\u62e6\u622a\uff0c\u63d0\u793a\u300c\u7ed3\u675f\u65f6\u95f4\u5fc5\u987b\u665a\u4e8e\u5f00\u59cb\u65f6\u95f4\u300d\u3002\n\n> \u5f85\u786e\u8ba4\u9879\uff1a\u662f\u5426\u9700\u8981\u6309\u89c4\u5219\u81ea\u52a8\u6263\u51cf\u7528\u9910/\u4f11\u606f\u65f6\u95f4\uff08\u5982\u52a0\u73ed\u8de8 12:00 \u6216 18:00\u201319:00 \u6263 1h\uff09\u3002\u672c\u671f\u9ed8\u8ba4**\u4e0d\u6263\u51cf**\uff0c\u4f5c\u4e3a\u53ef\u914d\u7f6e\u9879\u9884\u7559\u3002\n\n### 4.3 \u5ba1\u6279\u6d41\u7a0b\uff08F-03\uff09\n\n| \u7f16\u53f7 | \u9700\u6c42 | \u4f18\u5148\u7ea7 |\n| --- | --- | --- |\n| F-03-1 | \u63d0\u4ea4\u540e\u81ea\u52a8\u8def\u7531\u81f3\u7533\u8bf7\u4eba\u6240\u5c5e\u90e8\u95e8\u4e3b\u7ba1\uff1b\u4e3b\u7ba1\u4ece\u7ec4\u7ec7\u67b6\u6784\u8bfb\u53d6\uff0c\u4e0d\u624b\u586b | P0 |\n| F-03-2 | \u90e8\u95e8\u4e3b\u7ba1\u53ef\u6267\u884c\u300c\u540c\u610f\u300d\u6216\u300c\u9a73\u56de\u300d | P0 |\n| F-03-3 | \u9a73\u56de\u65f6\u5fc5\u987b\u586b\u5199\u9a73\u56de\u539f\u56e0\uff0c\u957f\u5ea6 1\u2013200 \u5b57\uff0c\u672a\u586b\u5199\u4e0d\u53ef\u63d0\u4ea4 | P0 |\n| F-03-4 | \u5f53 `\u52a0\u73ed\u65f6\u957f > 4 \u5c0f\u65f6` \u65f6\uff0c\u4e3b\u7ba1\u540c\u610f\u540e\u81ea\u52a8\u6d41\u8f6c\u81f3\u90e8\u95e8\u603b\u76d1\u4e8c\u6b21\u5ba1\u6279 | P0 |\n| F-03-5 | \u603b\u76d1\u5ba1\u6279\u540c\u6837\u652f\u6301\u540c\u610f/\u9a73\u56de\uff0c\u9a73\u56de\u539f\u56e0\u5fc5\u586b | P0 |\n| F-03-6 | \u9608\u503c 4 \u5c0f\u65f6\u53ef\u914d\u7f6e\uff1b\u5224\u5b9a\u89c4\u5219\u4e3a `\u65f6\u957f > 4h` \u9700\u603b\u76d1\u5ba1\u6279\uff0c`= 4h` \u4e0d\u9700\u8981 | P1 |\n| F-03-7 | \u5ba1\u6279\u4eba\u4e0d\u53ef\u5ba1\u6279\u672c\u4eba\u63d0\u4ea4\u7684\u7533\u8bf7\uff1b\u82e5\u4e3b\u7ba1\u5373\u7533\u8bf7\u4eba\uff0c\u81ea\u52a8\u4e0a\u63d0\u81f3\u90e8\u95e8\u603b\u76d1\u5ba1\u6279 | P1 |\n| F-03-8 | \u5ba1\u6279\u4eba\u7f3a\u4f4d\uff08\u65e0\u4e3b\u7ba1\u914d\u7f6e\uff09\u65f6\uff0c\u63d0\u4ea4\u5931\u8d25\u5e76\u63d0\u793a\u5458\u5de5\u8054\u7cfb HR\uff1b\u6216\u81ea\u52a8\u8f6c HR \u6307\u5b9a\u4eba\uff08\u5f85\u786e\u8ba4\uff09 | P1 |\n| F-03-9 | \u5ba1\u6279\u7ed3\u679c\u901a\u77e5\u7533\u8bf7\u4eba\uff08\u7ad9\u5185\u6d88\u606f + \u90ae\u4ef6\uff0c\u53ef\u914d\u7f6e\uff09 | P1 |\n| F-03-10 | \u64a4\u9500\uff1a\u4ec5\u5728\u5f85\u5ba1\u6279\u72b6\u6001\u4e0b\u5458\u5de5\u53ef\u64a4\u9500\uff0c\u64a4\u9500\u540e\u72b6\u6001\u7f6e\u4e3a\u300c\u5df2\u64a4\u9500\u300d | P1 |\n\n### 4.4 \u6cd5\u5b9a\u8282\u5047\u65e5\u81ea\u52a8\u6807\u8bb0\uff08F-04\uff09\n\n- \u7cfb\u7edf\u7ef4\u62a4\u300c\u8282\u5047\u65e5\u65e5\u5386\u300d\u57fa\u7840\u6570\u636e\uff0c\u7c7b\u578b\u5206\u4e3a\uff1a\u5de5\u4f5c\u65e5\u3001\u4f11\u606f\u65e5\uff08\u5468\u672b\uff09\u3001\u6cd5\u5b9a\u8282\u5047\u65e5\u3001\u8c03\u4f11\u4e0a\u73ed\u65e5\uff1b\n- \u63d0\u4ea4/\u4fdd\u5b58\u65f6\u6839\u636e\u300c\u52a0\u73ed\u65e5\u671f\u300d\u81ea\u52a8\u5339\u914d\u65e5\u5386\u5e76\u6253\u4e0a\u6807\u8bb0\uff0c\u6807\u8bb0\u53ea\u8bfb\uff1b\n- \u8282\u5047\u65e5\u7c7b\u578b\u5224\u65ad\u4f18\u5148\u7ea7\uff1a\u8c03\u4f11\u4e0a\u73ed\u65e5 > \u6cd5\u5b9a\u8282\u5047\u65e5 > \u5468\u672b > \u5de5\u4f5c\u65e5\uff1b\n- \u5217\u8868\u4e0e\u8be6\u60c5\u4ee5\u663e\u8457\u6807\u7b7e\u5c55\u793a\u300c\u6cd5\u5b9a\u8282\u5047\u65e5\u300d\uff0cHR \u6c47\u603b\u4e2d\u5355\u72ec\u5206\u5217\u7edf\u8ba1\uff1b\n- \u8282\u5047\u65e5\u65e5\u5386\u7531 HR\uff08\u6216\u7cfb\u7edf\u7ba1\u7406\u5458\uff09\u6309\u5e74\u5ea6\u7ef4\u62a4\uff0c\u9700\u652f\u6301\u5bfc\u5165\uff1b\u672a\u7ef4\u62a4\u5e74\u4efd\u7ed9\u51fa\u63d0\u793a\u4e14\u4e0d\u963b\u585e\u63d0\u4ea4\uff08\u6807\u8bb0\u4e3a\u7a7a\uff09\u3002\n\n### 4.5 \u5217\u8868\u4e0e\u67e5\u8be2\uff08F-05\uff09\n\n**\u5458\u5de5\u7aef\u5217\u8868**\n\n| \u5217 | \u8bf4\u660e |\n| --- | --- |\n| \u52a0\u73ed\u65e5\u671f | \u652f\u6301\u6392\u5e8f |\n| \u52a0\u73ed\u65f6\u957f | \u7cfb\u7edf\u8ba1\u7b97\u503c\uff0c\u652f\u6301\u6392\u5e8f |\n| \u72b6\u6001 | \u5f85\u5ba1\u6279 / \u5df2\u901a\u8fc7 / \u5df2\u9a73\u56de\uff08\u542b\u4e8c\u7ea7\u5ba1\u6279\u7edf\u4e00\u663e\u793a\u300c\u5f85\u5ba1\u6279\u300d\uff09 |\n| \u662f\u5426\u6cd5\u5b9a\u8282\u5047\u65e5 | \u6807\u7b7e |\n| \u7533\u8bf7\u65f6\u95f4 | \u63d0\u4ea4\u65f6\u95f4 |\n| \u64cd\u4f5c | \u67e5\u770b\u8be6\u60c5\u3001\u4fee\u6539\u3001\u64a4\u9500 |\n\n- \u7b5b\u9009\uff1a\u6309\u72b6\u6001\uff08\u5168\u90e8/\u5f85\u5ba1\u6279/\u5df2\u901a\u8fc7/\u5df2\u9a73\u56de\uff09\u3001\u6309\u6708\u4efd\uff08`yyyy-MM`\uff09\uff1b\n- \u5206\u9875\uff1a\u9ed8\u8ba4 20 \u6761/\u9875\uff0c\u5012\u5e8f\u6309\u63d0\u4ea4\u65f6\u95f4\u6392\u5217\uff1b\n- \u7a7a\u72b6\u6001\u63d0\u793a\uff1a\u300c\u6682\u65e0\u52a0\u73ed\u7533\u8bf7\u8bb0\u5f55\u300d\u3002\n\n**\u4e3b\u7ba1\u7aef\u5217\u8868**\n- \u5217\u540c\u4e0a\uff0c\u53e6\u589e\u300c\u7533\u8bf7\u4eba\u300d\u300c\u6240\u5c5e\u90e8\u95e8\u300d\uff1b\n- \u9ed8\u8ba4\u89c6\u56fe\u4e3a\u300c\u5f85\u6211\u5ba1\u6279\u300d\uff0c\u652f\u6301\u5207\u6362\u300c\u5168\u90e8\u300d\uff1b\n- \u7b5b\u9009\uff1a\u72b6\u6001\u3001\u6708\u4efd\u3001\u90e8\u95e8\u3001\u7533\u8bf7\u4eba\u59d3\u540d\u6a21\u7cca\u641c\u7d22\u3002\n\n**HR \u7aef\u5217\u8868**\n- \u5168\u516c\u53f8\u8303\u56f4\uff0c\u9ed8\u8ba4\u6309\u6708\u4efd\u5c55\u793a\uff1b\n- \u7b5b\u9009\uff1a\u6708\u4efd\u3001\u90e8\u95e8\u3001\u5458\u5de5\u3001\u72b6\u6001\u3001\u662f\u5426\u6cd5\u5b9a\u8282\u5047\u65e5\uff1b\n- \u9875\u9762\u9876\u90e8\u5c55\u793a\u6c47\u603b\u5361\u7247\uff1a\u7533\u8bf7\u603b\u6761\u6570\u3001\u52a0\u73ed\u603b\u65f6\u957f\u3001\u6d89\u53ca\u4eba\u6570\u3001\u6cd5\u5b9a\u8282\u5047\u65e5\u52a0\u73ed\u6761\u6570\uff1b\n- \u53ea\u8bfb\uff0c\u65e0\u4fee\u6539\u5165\u53e3\u3002\n\n### 4.6 HR \u6708\u5ea6\u6c47\u603b\u4e0e\u5bfc\u51fa\uff08F-06\uff09\n\n- \u652f\u6301\u9009\u62e9\u300c\u7edf\u8ba1\u6708\u4efd + \u90e8\u95e8\uff08\u9ed8\u8ba4\u5168\u90e8\uff09\u300d\uff0c\u70b9\u51fb\u300c\u5bfc\u51fa\u6c47\u603b\u300d\u751f\u6210 Excel\uff08`.xlsx`\uff09\uff1b\n- \u5bfc\u51fa\u5185\u5bb9\u5305\u542b\u4e24\u90e8\u5206\uff1a\n  1. **\u660e\u7ec6\u9875**\uff1a\u7533\u8bf7\u5355\u53f7\u3001\u5458\u5de5\u59d3\u540d\u3001\u5de5\u53f7\u3001\u90e8\u95e8\u3001\u5c97\u4f4d\u3001\u52a0\u73ed\u65e5\u671f\u3001\u5f00\u59cb\u65f6\u95f4\u3001\u7ed3\u675f\u65f6\u95f4\u3001\u52a0\u73ed\u65f6\u957f\u3001\u662f\u5426\u6cd5\u5b9a\u8282\u5047\u65e5\u3001\u72b6\u6001\u3001\u5ba1\u6279\u4eba\u3001\u5ba1\u6279\u5b8c\u6210\u65f6\u95f4\u3001\u9a73\u56de\u539f\u56e0\uff1b\n  2. **\u6c47\u603b\u8868\u9875**\uff1a\u6309\u5458\u5de5\uff08\u518d\u6309\u90e8\u95e8\u5c0f\u8ba1\uff09\u7edf\u8ba1\u2014\u2014\u52a0\u73ed\u6b21\u6570\u3001\u52a0\u73ed\u603b\u65f6\u957f\u3001\u6cd5\u5b9a\u8282\u5047\u65e5\u52a0\u73ed\u6b21\u6570\u3001\u6cd5\u5b9a\u8282\u5047\u65e5\u52a0\u73ed\u65f6\u957f\uff1b\n- \u5bfc\u51fa\u53e3\u5f84\uff1a**\u4ec5\u7edf\u8ba1\u72b6\u6001\u4e3a\u300c\u5df2\u901a\u8fc7\u300d\u7684\u7533\u8bf7**\uff08\u53ef\u901a\u8fc7\u7b5b\u9009\u53c2\u6570\u5305\u542b\u5176\u4ed6\u72b6\u6001\uff0c\u9ed8\u8ba4\u5df2\u901a\u8fc7\uff09\uff1b\n- \u5bfc\u51fa\u6587\u4ef6\u547d\u540d\uff1a`\u52a0\u73ed\u6c47\u603b_{yyyyMM}_{\u5bfc\u51fa\u65f6\u95f4\u6233}.xlsx`\uff1b\n- \u5355\u6b21\u5bfc\u51fa\u4e0a\u9650 \u2265 5 \u4e07\u884c\uff1b\u8d85\u9650\u65f6\u8f6c\u5f02\u6b65\u5bfc\u51fa\u5e76\u63d0\u4f9b\u4e0b\u8f7d\u94fe\u63a5\uff1b\n- \u5bfc\u51fa\u64cd\u4f5c\u8bb0\u5f55\u5ba1\u8ba1\u65e5\u5fd7\uff08\u5bfc\u51fa\u4eba\u3001\u65f6\u95f4\u3001\u7b5b\u9009\u6761\u4ef6\uff09\u3002\n\n---\n\n## 5. \u4e1a\u52a1\u89c4\u5219\u6c47\u603b\n\n| \u7f16\u53f7 | \u89c4\u5219 |\n| --- | --- |\n| R-01 | \u540c\u4e00\u7533\u8bf7\u4eba\u3001\u540c\u4e00\u52a0\u73ed\u65e5\u671f\u3001\u65f6\u6bb5\u5b58\u5728\u91cd\u53e0\u7684\u7533\u8bf7\u4e0d\u53ef\u91cd\u590d\u63d0\u4ea4\uff0c\u63d0\u793a\u300c\u8be5\u65f6\u6bb5\u5df2\u5b58\u5728\u52a0\u73ed\u7533\u8bf7\u300d |\n| R-02 | \u52a0\u73ed\u65f6\u957f > 4h \u5fc5\u987b\u7ecf\u90e8\u95e8\u603b\u76d1\u4e8c\u6b21\u5ba1\u6279 |\n| R-03 | \u9a73\u56de\u539f\u56e0\u5fc5\u586b\uff0c1\u2013200 \u5b57 |\n| R-04 | \u52a0\u73ed\u4e8b\u7531\u4e3a\u9009\u586b\uff0c\u957f\u5ea6\u4e0a\u9650 200 \u5b57 |\n| R-05 | \u5458\u5de5\u4ec5\u53ef\u4fee\u6539/\u64a4\u9500\u5904\u4e8e\u300c\u5f85\u5ba1\u6279\u300d\u6216\u5df2\u9a73\u56de/\u5df2\u64a4\u9500\u72b6\u6001\u7684\u7533\u8bf7\uff1b\u300c\u5df2\u901a\u8fc7\u300d\u4e0d\u53ef\u4fee\u6539 |\n| R-06 | \u4fee\u6539\u540e\u91cd\u65b0\u63d0\u4ea4\uff0c\u5ba1\u6279\u6d41\u7a0b\u4ece\u5934\u5f00\u59cb\uff08\u91cd\u65b0\u7531\u4e3b\u7ba1\u5ba1\u6279\uff09\uff0c\u5e76\u5728\u65e5\u5fd7\u4e2d\u4fdd\u7559\u5386\u53f2\u7248\u672c |\n| R-07 | \u65f6\u957f\u4e0e\u8282\u5047\u65e5\u6807\u8bb0\u5747\u7531\u7cfb\u7edf\u8ba1\u7b97\uff0c\u4efb\u4f55\u89d2\u8272\u4e0d\u53ef\u624b\u5de5\u8986\u76d6 |\n| R-08 | HR \u5bf9\u672c\u6a21\u5757\u6570\u636e\u4e3a\u53ea\u8bfb\uff0c\u4e0d\u53ef\u4fee\u6539\u4e0e\u5ba1\u6279 |\n| R-09 | \u6240\u6709\u72b6\u6001\u53d8\u66f4\u5747\u987b\u8bb0\u5f55\u64cd\u4f5c\u65e5\u5fd7\uff0c\u65e5\u5fd7\u4e0d\u53ef\u7f16\u8f91\u6216\u5220\u9664 |\n\n---\n\n## 6. \u901a\u77e5\u9700\u6c42\n\n| \u89e6\u53d1\u4e8b\u4ef6 | \u63a5\u6536\u4eba | \u6e20\u9053 |\n| --- | --- | --- |\n| \u63d0\u4ea4\u7533\u8bf7\u6210\u529f | \u5f53\u524d\u5ba1\u6279\u4eba | \u7ad9\u5185\u6d88\u606f\u3001\u90ae\u4ef6 |\n| \u4e3b\u7ba1\u540c\u610f\uff08\u8f6c\u603b\u76d1\uff09 | \u90e8\u95e8\u603b\u76d1 | \u7ad9\u5185\u6d88\u606f\u3001\u90ae\u4ef6 |\n| \u5ba1\u6279\u901a\u8fc7 | \u7533\u8bf7\u4eba | \u7ad9\u5185\u6d88\u606f\u3001\u90ae\u4ef6 |\n| \u5ba1\u6279\u9a73\u56de | \u7533\u8bf7\u4eba | \u7ad9\u5185\u6d88\u606f\u3001\u90ae\u4ef6\uff08\u542b\u9a73\u56de\u539f\u56e0\uff09 |\n| \u5f85\u5ba1\u6279\u8d85 3 \u5929\u672a\u5904\u7406 | \u5ba1\u6279\u4eba | \u7ad9\u5185\u6d88\u606f\uff08\u63d0\u9192\uff09 |\n\n---\n\n## 7. \u975e\u529f\u80fd\u9700\u6c42\n\n| \u7c7b\u522b | \u8981\u6c42 |\n| --- | --- |\n| \u6027\u80fd | \u5217\u8868\u67e5\u8be2\uff0810 \u4e07\u7ea7\u6570\u636e\u91cf\uff09\u54cd\u5e94 \u2264 2s\uff1b\u65f6\u957f\u8ba1\u7b97\u4e0e\u8282\u5047\u65e5\u5339\u914d\u4e3a\u5b9e\u65f6\u540c\u6b65\uff0c\u2264 200ms |\n| \u5e76\u53d1 | \u652f\u6301 500 \u4eba\u540c\u65f6\u5728\u7ebf\u64cd\u4f5c\uff1b\u5ba1\u6279\u64cd\u4f5c\u9700\u52a0\u4e50\u89c2\u9501/\u72b6\u6001\u6761\u4ef6\u66f4\u65b0\uff0c\u907f\u514d\u91cd\u590d\u5ba1\u6279 |\n| \u5b89\u5168 | \u4e25\u683c\u6309\u89d2\u8272\u4e0e\u6570\u636e\u8303\u56f4\u9274\u6743\uff1b\u5bfc\u51fa\u529f\u80fd\u4ec5 HR \u89d2\u8272\u53ef\u7528\u4e14\u8bb0\u5f55\u5ba1\u8ba1\uff1b\u9632\u6b62\u8d8a\u6743 ID \u904d\u5386 |\n| \u5ba1\u8ba1 | \u5168\u6d41\u7a0b\u7559\u75d5\uff0c\u64cd\u4f5c\u65e5\u5fd7\u4fdd\u5b58 \u2265 3 \u5e74 |\n| \u517c\u5bb9\u6027 | \u4e3b\u6d41\u6d4f\u89c8\u5668 Chrome / Edge / Firefox \u6700\u65b0\u4e24\u4e2a\u5927\u7248\u672c\uff1b\u5206\u8fa8\u7387 \u2265 1366\u00d7768 |\n| \u53ef\u7528\u6027 | \u8868\u5355\u6821\u9a8c\u524d\u7aef + \u540e\u7aef\u53cc\u91cd\uff1b\u63d0\u4ea4\u5931\u8d25\u4fdd\u7559\u5df2\u586b\u5185\u5bb9 |\n| \u672c\u5730\u5316 | \u4e2d\u6587\u754c\u9762\uff0c\u65f6\u95f4\u7edf\u4e00 `yyyy-MM-dd HH:mm`\uff0c\u65f6\u533a\u56fa\u5b9a Asia/Shanghai |\n\n---\n\n## 8. \u6570\u636e\u5b57\u5178\uff08\u6838\u5fc3\u5b57\u6bb5\uff09\n\n**\u52a0\u73ed\u7533\u8bf7\u8868 `ot_application`**\n\n| \u5b57\u6bb5 | \u7c7b\u578b | \u8bf4\u660e |\n| --- | --- | --- |\n| id | bigint | \u4e3b\u952e |\n| apply_no | varchar(20) | \u7533\u8bf7\u5355\u53f7\uff0c\u552f\u4e00 |\n| applicant_id | bigint | \u7533\u8bf7\u4eba |\n| department_id | bigint | \u7533\u8bf7\u4eba\u6240\u5c5e\u90e8\u95e8\uff08\u63d0\u4ea4\u65f6\u5feb\u7167\uff09 |\n| ot_date | date | \u52a0\u73ed\u65e5\u671f |\n| start_time | time | \u5f00\u59cb\u65f6\u95f4 |\n| end_time | time | \u7ed3\u675f\u65f6\u95f4 |\n| duration_hours | decimal(4,1) | \u7cfb\u7edf\u8ba1\u7b97\u65f6\u957f |\n| cross_day | tinyint | \u662f\u5426\u8de8\u5929 |\n| reason | varchar(200) | \u52a0\u73ed\u4e8b\u7531\uff0c\u9009\u586b |\n| holiday_type | varchar(20) | \u5de5\u4f5c\u65e5/\u4f11\u606f\u65e5/\u6cd5\u5b9a\u8282\u5047\u65e5/\u8c03\u4f11\u4e0a\u73ed |\n| is_holiday | tinyint | \u662f\u5426\u6cd5\u5b9a\u8282\u5047\u65e5 |\n| status | varchar(20) | \u72b6\u6001\u673a\u53d6\u503c |\n| need_director | tinyint | \u662f\u5426\u9700\u603b\u76d1\u5ba1\u6279 |\n| created_at / updated_at | datetime | \u521b\u5efa\u3001\u66f4\u65b0\u65f6\u95f4 |\n\n**\u5ba1\u6279\u8bb0\u5f55\u8868 `ot_approval`**\uff1a`id, application_id, node(\u4e3b\u7ba1/\u603b\u76d1), approver_id, action(\u540c\u610f/\u9a73\u56de/\u64a4\u9500), comment, approved_at`\n\n**\u8282\u5047\u65e5\u65e5\u5386\u8868 `holiday_calendar`**\uff1a`date, type, name, year, updated_by, updated_at`\n\n---\n\n## 9. \u754c\u9762\u6e05\u5355\n\n| \u7f16\u53f7 | \u9875\u9762 | \u4e3b\u8981\u89d2\u8272 |\n| --- | --- | --- |\n| P-01 | \u52a0\u73ed\u7533\u8bf7\u5217\u8868\uff08\u6211\u7684\uff09 | \u5458\u5de5 |\n| P-02 | \u65b0\u589e/\u7f16\u8f91\u52a0\u73ed\u7533\u8bf7\u8868\u5355 | \u5458\u5de5 |\n| P-03 | \u52a0\u73ed\u7533\u8bf7\u8be6\u60c5\uff08\u542b\u5ba1\u6279\u8f68\u8ff9\uff09 | \u5168\u90e8 |\n| P-04 | \u5f85\u6211\u5ba1\u6279\u5217\u8868 / \u5ba1\u6279\u64cd\u4f5c\u5f39\u7a97 | \u4e3b\u7ba1\u3001\u603b\u76d1 |\n| P-05 | \u5168\u516c\u53f8\u67e5\u8be2\u5217\u8868 + \u6c47\u603b\u5361\u7247 | HR |\n| P-06 | \u6708\u5ea6\u6c47\u603b\u5bfc\u51fa\u9875 | HR |\n| P-07 | \u8282\u5047\u65e5\u65e5\u5386\u7ef4\u62a4 | HR / \u7ba1\u7406\u5458 |\n\n---\n\n## 10. \u9a8c\u6536\u6807\u51c6\n\n1. \u5458\u5de5\u53ef\u6210\u529f\u63d0\u4ea4\u52a0\u73ed\u7533\u8bf7\uff0c\u65f6\u957f\u7531\u7cfb\u7edf\u81ea\u52a8\u8ba1\u7b97\u4e14\u4e0d\u53ef\u7f16\u8f91\uff0c\u8de8\u5929\u573a\u666f\u8ba1\u7b97\u7ed3\u679c\u6b63\u786e\uff1b\n2. \u52a0\u73ed\u4e8b\u7531\u8d85\u8fc7 200 \u5b57\u65f6\u88ab\u963b\u6b62\u63d0\u4ea4\u5e76\u7ed9\u51fa\u660e\u786e\u63d0\u793a\uff1b\n3. \u65f6\u957f \u2264 4h \u7684\u7533\u8bf7\uff0c\u4e3b\u7ba1\u540c\u610f\u540e\u72b6\u6001\u76f4\u63a5\u53d8\u4e3a\u300c\u5df2\u901a\u8fc7\u300d\uff1b\u65f6\u957f > 4h \u7684\u7533\u8bf7\uff0c\u4e3b\u7ba1\u540c\u610f\u540e\u81ea\u52a8\u6d41\u8f6c\u81f3\u603b\u76d1\uff0c\u603b\u76d1\u540c\u610f\u540e\u4e3a\u300c\u5df2\u901a\u8fc7\u300d\uff1b\n4. \u9a73\u56de\u64cd\u4f5c\u5728\u672a\u586b\u5199\u539f\u56e0\u65f6\u65e0\u6cd5\u63d0\u4ea4\uff0c\u586b\u5199\u540e\u7533\u8bf7\u4eba\u53ef\u5728\u8be6\u60c5\u4e2d\u770b\u5230\u9a73\u56de\u539f\u56e0\uff1b\n5. \u5458\u5de5\u4fee\u6539/\u64a4\u9500\u6743\u9650\u6309 R-05 \u751f\u6548\uff0c\u300c\u5df2\u901a\u8fc7\u300d\u5355\u636e\u65e0\u4fee\u6539\u5165\u53e3\u4e14\u63a5\u53e3\u5c42\u62d2\u7edd\u4fee\u6539\u8bf7\u6c42\uff1b\n6. \u6743\u9650\u6821\u9a8c\uff1a\u5458\u5de5\u8bbf\u95ee\u4ed6\u4eba\u7533\u8bf7\u8be6\u60c5\u3001\u4e3b\u7ba1\u8bbf\u95ee\u975e\u672c\u90e8\u95e8\u7533\u8bf7\u3001HR \u5c1d\u8bd5\u8c03\u7528\u4fee\u6539\u6216\u5ba1\u6279\u63a5\u53e3\u65f6\uff0c\u5747\u8fd4\u56de\u65e0\u6743\u9650\uff1b\n7. \u5458\u5de5\u7aef\u5217\u8868\u6309\u72b6\u6001\u3001\u6309\u6708\u4efd\u7b5b\u9009\u7ed3\u679c\u6b63\u786e\uff0c\u5206\u9875\u4e0e\u6392\u5e8f\u6b63\u5e38\uff1b\n8. \u52a0\u73ed\u65e5\u671f\u843d\u5728\u6cd5\u5b9a\u8282\u5047\u65e5\u65f6\u81ea\u52a8\u6807\u8bb0\u4e3a\u300c\u6cd5\u5b9a\u8282\u5047\u65e5\u300d\uff0c\u4e14 HR \u6c47\u603b\u4e2d\u5355\u72ec\u7edf\u8ba1\u6b63\u786e\uff1b\n9. HR \u5bfc\u51fa\u7684 Excel \u660e\u7ec6\u4e0e\u6c47\u603b\u6570\u636e\u4e0e\u7cfb\u7edf\u67e5\u8be2\u7ed3\u679c\u4e00\u81f4\uff0c\u4ec5\u5305\u542b\u6240\u9009\u6708\u4efd\u4e0e\u90e8\u95e8\u7684\u300c\u5df2\u901a\u8fc7\u300d\u6570\u636e\uff1b\n10. \u6240\u6709\u63d0\u4ea4\u3001\u4fee\u6539\u3001\u64a4\u9500\u3001\u5ba1\u6279\u3001\u5bfc\u51fa\u64cd\u4f5c\u5747\u53ef\u5728\u64cd\u4f5c\u65e5\u5fd7\u4e2d\u67e5\u8be2\u5230\u5b8c\u6574\u8bb0\u5f55\u3002\n\n---\n\n## 11. \u5f85\u786e\u8ba4\u95ee\u9898\uff08Open Issues\uff09\n\n| \u7f16\u53f7 | \u95ee\u9898 | \u5f71\u54cd |\n| --- | --- | --- |\n| Q-01 | \u662f\u5426\u5141\u8bb8\u63d0\u4ea4\u672a\u6765\u65e5\u671f\u7684\u9884\u52a0\u73ed\u7533\u8bf7\uff1f\u662f\u5426\u5141\u8bb8\u8865\u63d0\uff08\u8d85\u8fc7 90 \u5929\uff09\uff1f | F-01 \u6821\u9a8c\u89c4\u5219 |\n| Q-02 | \u662f\u5426\u9700\u8981\u81ea\u52a8\u6263\u51cf\u7528\u9910/\u4f11\u606f\u65f6\u95f4\uff0c\u6263\u51cf\u89c4\u5219\u5982\u4f55\u5b9a\u4e49\uff1f | F-02 \u65f6\u957f\u53e3\u5f84 |\n| Q-03 | \u90e8\u95e8\u4e3b\u7ba1\u7f3a\u4f4d\u6216\u4e3b\u7ba1\u5373